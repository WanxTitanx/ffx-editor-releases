<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AtelLangLab</AssemblyName>
    <RootNamespace>AtelLangLab</RootNamespace>
  </PropertyGroup>

  <!-- F5-L6: CLI da linguagem ATEL de alto nível. Compila um script .atel e aplica num monster bin
       (dry run com diff 3 camadas, ou saida em arquivo). Linka o codec real (FfxLib/Ai) + o compilador AtelScript. -->
  <!-- i18n (v2.234.3.0): linked FfxLib sources use FFXProjectEditor.Resources (Strings); ship the
       generated accessor + neutral resx so the links compile with identical lookups. -->
  <ItemGroup>
    <Compile Include="..\..\FFXProjectEditor\Resources\Strings.cs" Link="Strings.cs" />
    <EmbeddedResource Include="..\..\FFXProjectEditor\Resources\Strings.resx" LogicalName="FFXProjectEditor.Resources.Strings.resources" />
  </ItemGroup>
