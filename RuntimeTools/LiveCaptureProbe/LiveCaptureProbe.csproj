<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>LiveCaptureProbe</AssemblyName>
    <RootNamespace>LiveCaptureProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Binarysharp.MSharp">
      <HintPath>..\..\ExternalLibs\MemorySharp64\Binarysharp.MSharp.dll</HintPath>
    </Reference>
    <Content Include="..\..\ExternalLibs\MemorySharp64\x64\keystone.dll">
      <Link>keystone.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
