         suppress that target, and publish the audited x64 native image explicitly above. -->
    <PackageReference Include="keystoneengine.csharp" Version="0.9.1.1" ExcludeAssets="build" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.1.10" />
