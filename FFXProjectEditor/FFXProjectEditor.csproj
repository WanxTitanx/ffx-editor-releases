  <!-- This Avalonia NativeControlHost needs only CoreWebView2 and the audited x64 loader. -->
  <ItemGroup Condition="'$(FFXTargetPlatform)' == 'Windows'">
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll">
      <Link>WebView2Loader.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RemoveWebView2DocumentationFromProductOutput"
          AfterTargets="ResolveAssemblyReferences"
          Condition="'$(FFXTargetPlatform)' == 'Windows' and '$(FFXIncludeDevTools)' != 'true'">
    <ItemGroup>
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'Microsoft.Web.WebView2.Core.xml'" />
    </ItemGroup>
  </Target>

  <!-- WHY(GF-02): the frozen Linux package policy denies *.pdb, but the
       Binarysharp.MSharp NuGet payload ships a .pdb even with DebugType=none.
       Strip every PDB from the Linux publish output so the shipped tree matches
       the reconciled studio-core-linux-x64 policy exactly. -->
  <Target Name="RemovePdbFromLinuxProductOutput"
          AfterTargets="Publish"
          Condition="'$(FFXTargetPlatform)' == 'Linux'">
    <ItemGroup>
      <_LinuxPdbFiles Include="$(PublishDir)**/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_LinuxPdbFiles)" />
  </Target>

