    <!-- GHSA-xrw6-gwf8-vvr9: the transitive 0.20.0 pulled by Avalonia.FreeDesktop is vulnerable;
         0.21.3 is the fixed release on the <0.22 line (0.22.x–0.92.x stays vulnerable). Only the
         Linux graph carries the dependency, so the pin shares that condition. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" Condition="'$(FFXTargetPlatform)' == 'Linux'" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
