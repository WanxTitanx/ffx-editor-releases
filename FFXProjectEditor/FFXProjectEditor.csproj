<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="FFXRequestedRuntimeIdentifier;FFXTargetPlatform;FFXUnsupportedRuntimeIdentifier">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Explicit release RIDs are allowlisted. RID-less builds may infer the local desktop only
         for developer convenience; an explicit unsupported RID never falls back to the host. -->
    <FFXRequestedRuntimeIdentifier></FFXRequestedRuntimeIdentifier>
    <FFXRequestedRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</FFXRequestedRuntimeIdentifier>
    <!-- A runtime-specific dotnet restore supplies RuntimeIdentifiers (plural), whereas build supplies
         RuntimeIdentifier. Resolve both through one value so restore and compile select one graph. -->
    <FFXRequestedRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(RuntimeIdentifiers)' != ''">$(RuntimeIdentifiers)</FFXRequestedRuntimeIdentifier>
    <FFXTargetPlatform></FFXTargetPlatform>
    <FFXUnsupportedRuntimeIdentifier></FFXUnsupportedRuntimeIdentifier>
    <FFXTargetPlatform Condition="'$(FFXRequestedRuntimeIdentifier)' == 'linux-x64'">Linux</FFXTargetPlatform>
    <FFXTargetPlatform Condition="'$(FFXRequestedRuntimeIdentifier)' == 'win-x64'">Windows</FFXTargetPlatform>
    <FFXUnsupportedRuntimeIdentifier Condition="'$(FFXRequestedRuntimeIdentifier)' != '' and '$(FFXRequestedRuntimeIdentifier)' != 'linux-x64' and '$(FFXRequestedRuntimeIdentifier)' != 'win-x64'">true</FFXUnsupportedRuntimeIdentifier>
    <FFXTargetPlatform Condition="'$(FFXRequestedRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</FFXTargetPlatform>
    <FFXTargetPlatform Condition="'$(FFXRequestedRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</FFXTargetPlatform>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Developer CLI/LAB entrypoints stay available in normal source builds, but are removed from
         the official publish assembly. This keeps the product portable without deleting research tools. -->
    <!-- Publish profiles are imported after this project body. Seed the official profile's value
         here so the dev conditional symbol and Compile removals are evaluated consistently. -->
    <FFXIncludeDevTools Condition="'$(FFXIncludeDevTools)' == '' and ('$(PublishProfile)' == 'win-x64-portable' or '$(PublishProfile)' == 'linux-x64-portable')">false</FFXIncludeDevTools>
    <FFXIncludeDevTools Condition="'$(FFXIncludeDevTools)' == ''">true</FFXIncludeDevTools>
    <!-- Bundled viewers are product code, not optional developer assets. Keep ordinary Debug/Release
         builds functional while preserving an explicit false override for specialized build probes. -->
    <FFXShipProductViewers Condition="'$(FFXShipProductViewers)' == ''">true</FFXShipProductViewers>
    <!-- vgmstream-cli is product code now: the automatic default-track music import needs the
         bundled, hash-pinned decoder on every install. Still overridable for slim builds. -->
    <FFXShipAudioTools Condition="'$(FFXShipAudioTools)' == ''">true</FFXShipAudioTools>
    <!-- Each platform carries only its own Avalonia backend: Win32 under Windows, X11 under
         Linux. Avalonia.Desktop is deliberately absent — it would drag the opposite platform's
         chain (plus the vulnerable Tmds.DBus.Protocol line) into every publish. -->
    <DefineConstants Condition="'$(FFXIncludeDevTools)' == 'true'">$(DefineConstants);FFX_INCLUDE_DEVTOOLS</DefineConstants>
    <!-- Each platform extension method compiles only when its package is in the same graph. -->
    <DefineConstants Condition="'$(FFXTargetPlatform)' == 'Windows'">$(DefineConstants);FFX_ENABLE_WIN32</DefineConstants>
    <DefineConstants Condition="'$(FFXTargetPlatform)' == 'Linux'">$(DefineConstants);FFX_ENABLE_X11</DefineConstants>
    <ContinuousIntegrationBuild Condition="'$(FFXIncludeDevTools)' != 'true'">true</ContinuousIntegrationBuild>
    <Deterministic Condition="'$(FFXIncludeDevTools)' != 'true'">true</Deterministic>
    <PathMap Condition="'$(FFXIncludeDevTools)' != 'true'">$(MSBuildProjectDirectory)=/_/FFXProjectEditor</PathMap>
<Version>2.246.0.0</Version>
	<AssemblyVersion>2.246.0.0</AssemblyVersion>
	<FileVersion>2.246.0.0</FileVersion>
	<InformationalVersion>2.246.0.0</InformationalVersion>
	<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
	<ApplicationIcon>Assets\SpiraReforgeStudio.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup Condition="'$(FFXIncludeDevTools)' != 'true'">
    <Compile Remove="Tools\**\*.cs" />
    <!-- Product builds must never compile the repo-only NoClip repair helper. It can fetch CDN
         content and overwrite viewer data, so it remains available only to explicit dev builds. -->
    <Compile Remove="Modules\Common\ViewerHub\NoclipDataRepair.cs" />
    <!-- U1 simulation is a research-only API and must not exist in the official product assembly. -->
    <Compile Remove="FfxLib\MagicDll\MagicU1Simulator.cs" />
  </ItemGroup>
  <Target Name="RejectUnsupportedFfxRuntimeIdentifier"
          BeforeTargets="CollectPackageReferences;PrepareForBuild"
          Condition="'$(FFXUnsupportedRuntimeIdentifier)' == 'true'">
    <Error Text="Unsupported RuntimeIdentifier '$(FFXRequestedRuntimeIdentifier)'; only win-x64 and linux-x64 are release targets." />
  </Target>
  <ItemGroup>
    <!-- Keep the five XAML consumers on one stable type name while compiling exactly one concrete
         host. Unsupported explicit RIDs select neither implementation and fail before compile. -->
    <Compile Remove="Modules\Common\ViewerShell\WebView2Host.cs"
             Condition="'$(FFXTargetPlatform)' != 'Windows'" />
    <Compile Remove="Modules\Common\ViewerShell\WebView2Host.Linux.cs"
             Condition="'$(FFXTargetPlatform)' != 'Linux'" />
