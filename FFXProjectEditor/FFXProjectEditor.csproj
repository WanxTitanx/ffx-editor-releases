    <!-- Jarvis-UI Fase F Â§F4 (v2.162.4.0): i18n foundation. Resources/Strings.resx (neutral=en) +
         Strings.pt.resx satellite are picked up IMPLICITLY as EmbeddedResource by the .NET SDK
         (Resources/**/*.resx glob). Access via the Strings accessor class: {x:Static res:Strings.Xxx}.
         The naming convention (Strings.pt.resx) makes .NET emit the pt satellite assembly. -->
  </ItemGroup>

  <!-- ResGen do .NET 8 lê .resx como cp1252 no Windows pt-BR (ignora BOM UTF-8) → mojibake nos
       satellites compilados. Este target gera o .resources de TODOS os satellites (pt/es/fr/de/it/ja/ko/zh)
       com System.Resources.ResourceWriter (UTF-8 correto), bypassando o ResGen. Ver tools/ResGenFix/. -->
  <Target Name="GenerateSatelliteResourcesWithWriter" BeforeTargets="GenerateResource">
    <ItemGroup>
      <_SatelliteLang Include="pt;es;fr;de;it;ja;ko;zh" />
    </ItemGroup>
    <Exec Command="dotnet run --project ..\tools\ResGenFix\ResGenFix.csproj -- &quot;$(MSBuildProjectDirectory)\Resources\Strings.%(_SatelliteLang.Identity).resx&quot; &quot;$(IntermediateOutputPath)FFXProjectEditor.Resources.Strings.%(_SatelliteLang.Identity).resources&quot;" />
  </Target>

  <ItemGroup>
