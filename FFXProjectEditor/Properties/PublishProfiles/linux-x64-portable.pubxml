<?xml version="1.0" encoding="utf-8"?>
<!--
  Spira Reforge Studio — perfil portátil Linux (linux-x64, self-contained, pasta portátil).
  Plano: docs/superpowers/plans/2026-09-13-linux-d-distribution-and-module-proof.md Task 1.

  Mesma arquitetura de payload do perfil Windows: pasta portátil, NÃO single-file/trimmed.
  Diferenças intencionais:
  - FFXShipFfxedJar=false  : FFXED/Java não têm autoridade de redistribuição em Linux (C2).
  - FFXShipWindowsPrerequisites=false / FFXShipRuntimeTools=false : nada de payload Windows.
  - Sem target PowerShell pós-publish: verificação de runtime pertence ao linux_release.py.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ErrorOnDuplicatePublishOutputFiles>true</ErrorOnDuplicatePublishOutputFiles>
    <FFXIncludeDevTools>false</FFXIncludeDevTools>
    <FFXShipProductViewers>true</FFXShipProductViewers>
    <FFXShipAudioTools>true</FFXShipAudioTools>
    <FFXShipFfxedJar>false</FFXShipFfxedJar>
    <FFXShipLocalAudio>false</FFXShipLocalAudio>
    <FFXShipWindowsPrerequisites>false</FFXShipWindowsPrerequisites>
    <FFXShipRuntimeTools>false</FFXShipRuntimeTools>
    <FFXShipSpiraForgeAssets>false</FFXShipSpiraForgeAssets>
    <FFXShipSinCatalog>true</FFXShipSinCatalog>
  </PropertyGroup>

  <!-- Product-only publish: remove developer command surfaces from the publish graph
       (same contract as win-x64-portable; globs are evaluated after this import). -->
  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>
</Project>

