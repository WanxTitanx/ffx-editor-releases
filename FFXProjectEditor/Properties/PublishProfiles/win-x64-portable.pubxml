<?xml version="1.0" encoding="utf-8"?>
<!--
  FFX Mod Studio — publish profile canônico (win-x64, self-contained, pasta portátil).
  Fonte de verdade: docs/ai/FFX_MOD_STUDIO_OFFICIAL_RELEASE_MASTER_PLAN_2026-08-20.md §4.2.

  Decisão de arquitetura: payload portátil em pasta (ZIP), NÃO single-file/trimmed/AOT.
  - PublishSingleFile=false / PublishTrimmed=false: evita quebra de reflection/Avalonia XAML.
  - DebugSymbols=false / DebugType=none: PDBs ficam fora do ZIP público.
  - ErrorOnDuplicatePublishOutputFiles=true: duplicata de output = falha (não permite áudio/native ambíguo).

  MAINT note: NÃO mover estas propriedades para o .csproj global sem prova — builds de
  dev/testes/tools podem precisar de comportamento diferente. NÃO habilitar trimming,
  NativeAOT, single-file, ReadyToRun nem extração automática de nativos em %TEMP%.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeFrameworkVersion>8.0.30</RuntimeFrameworkVersion>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
    <!-- Keep product assembly identity stable across policy-only commits. The source commit remains
         recorded in release-manifest.json; AssemblyVersion and FileVersion remain project-governed. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ErrorOnDuplicatePublishOutputFiles>true</ErrorOnDuplicatePublishOutputFiles>
    <FFXIncludeDevTools>false</FFXIncludeDevTools>
    <FFXShipLocalAudio>false</FFXShipLocalAudio>
    <FFXShipAudioTools>true</FFXShipAudioTools>
    <FFXShipFfxedJar>true</FFXShipFfxedJar>
    <FFXShipWindowsPrerequisites>true</FFXShipWindowsPrerequisites>
    <FFXShipProductViewers>true</FFXShipProductViewers>
    <FFXShipRuntimeTools>true</FFXShipRuntimeTools>
    <!-- Split product gates: the paused research lab never rides a public build implicitly. -->
    <FFXShipSpiraForgeAssets>false</FFXShipSpiraForgeAssets>
    <FFXShipSinCatalog>true</FFXShipSinCatalog>
    <!-- Diagnostic reports incomplete prerequisites without hiding them. Candidate/Release callers
         must override this property and the verifier then fails closed. -->
    <FFXRuntimeVerificationMode Condition="'$(FFXRuntimeVerificationMode)' == ''">Diagnostic</FFXRuntimeVerificationMode>
    <FFXRuntimePrerequisitesContract>$(MSBuildProjectDirectory)\..\release\windows-runtime-prerequisites.json</FFXRuntimePrerequisitesContract>
  </PropertyGroup>

  <!-- Product-only publish: SDK default compile globs are evaluated before this imported profile,
       so the profile must explicitly remove developer command surfaces from the publish graph. -->
  <ItemGroup>
    <Compile Remove="Tools\**\*.cs" />
  </ItemGroup>

  <Target Name="ValidateFFXRuntimeVerificationMode" BeforeTargets="Publish">
    <Error
      Condition="'$(FFXRuntimeVerificationMode)' != 'Diagnostic' and '$(FFXRuntimeVerificationMode)' != 'Candidate'"
      Text="FFXRuntimeVerificationMode must be Diagnostic or Candidate for the portable profile." />
  </Target>

  <Target Name="VerifyWindowsRuntimeDependencies" AfterTargets="Publish">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)\..\scripts\release\verify_runtime_dependencies.ps1&quot; -PackageRoot &quot;$(PublishDir).&quot; -ContractPath &quot;$(FFXRuntimePrerequisitesContract)&quot; -Mode &quot;$(FFXRuntimeVerificationMode)&quot;" />
  </Target>
</Project>
