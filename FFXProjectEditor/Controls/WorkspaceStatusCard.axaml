<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="140"
             x:Class="FFXProjectEditor.Controls.WorkspaceStatusCard">
	<Border Background="#101922" BorderBrush="#264052" BorderThickness="1" CornerRadius="8" Padding="16">
		<Grid RowDefinitions="Auto,Auto,Auto">
			<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" />
					<TextBlock Text="{x:Static res:Strings.U_WsCurrentWorkspace}" Foreground="#F1F5F9" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
					<Border Background="#15212C" BorderBrush="#264052" BorderThickness="1" CornerRadius="4" Padding="6,2">
						<TextBlock Name="PlatformText" Text="PC HD" Foreground="#4A90D9" FontSize="11" FontWeight="SemiBold" />
					</Border>
				</StackPanel>
				<TextBlock Grid.Column="1" Name="ScanTimeText" Text="{x:Static res:Strings.U_WsScanned}" Foreground="#8BA3B5" FontSize="11" VerticalAlignment="Center" />
			</Grid>

			<Grid Grid.Row="1" ColumnDefinitions="*,*,*" Margin="0,0,0,10">
				<StackPanel Grid.Column="0" Spacing="2">
					<TextBlock Text="{x:Static res:Strings.U_WsGame}" Foreground="#8BA3B5" FontSize="10" FontWeight="Bold" />
					<TextBlock Name="GamePathText" Text="{x:Static res:Strings.F2_none_selected_5798946a}" Foreground="#F1F5F9" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
				</StackPanel>
				<StackPanel Grid.Column="1" Spacing="2">
					<TextBlock Text="{x:Static res:Strings.U_WsWorkspace}" Foreground="#8BA3B5" FontSize="10" FontWeight="Bold" />
					<TextBlock Name="SourcePathText" Text="{x:Static res:Strings.F2_none_selected_5798946a}" Foreground="#F1F5F9" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
				</StackPanel>
				<StackPanel Grid.Column="2" Spacing="2">
					<TextBlock Text="{x:Static res:Strings.U_WsOutput}" Foreground="#8BA3B5" FontSize="10" FontWeight="Bold" />
					<TextBlock Name="OutputPathText" Text="{x:Static res:Strings.U_WsInMemory}" Foreground="#F1F5F9" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text, RelativeSource={RelativeSource Self}}" />
				</StackPanel>
			</Grid>

			<Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="{x:Static res:Strings.U_WsActiveCapabilities}" Foreground="#8BA3B5" FontSize="11" />
						<TextBlock Name="ActiveCapabilitiesText" Text="0/10" Foreground="#4CAF8A" FontWeight="Bold" FontSize="11" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" Spacing="4">
						<TextBlock Text="{x:Static res:Strings.U_WsWarnings}" Foreground="#8BA3B5" FontSize="11" />
						<TextBlock Name="WarningsCountText" Text="0" Foreground="#E8943A" FontWeight="Bold" FontSize="11" />
					</StackPanel>
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
				<Button Name="ChangeWorkspaceButton" Content="{x:Static res:Strings.U_WsChangeWorkspaceFolder}" Background="#15212C" Foreground="#F1F5F9" BorderBrush="#264052" BorderThickness="1" CornerRadius="4" Padding="10,4" FontSize="11" />
				<Button Name="ChangeOutputButton" Content="{x:Static res:Strings.U_WsChangeOutputFolder}" Background="#15212C" Foreground="#F1F5F9" BorderBrush="#264052" BorderThickness="1" CornerRadius="4" Padding="10,4" FontSize="11" />
				<Button Name="ResetOutputButton" Content="↺" Background="#15212C" Foreground="#8BA3B5" BorderBrush="#264052" BorderThickness="1" CornerRadius="4" Padding="8,4" FontSize="11" ToolTip.Tip="{x:Static res:Strings.U_WsOutputResetAuto}" />
			</StackPanel>
			</Grid>
		</Grid>
	</Border>
</UserControl>
