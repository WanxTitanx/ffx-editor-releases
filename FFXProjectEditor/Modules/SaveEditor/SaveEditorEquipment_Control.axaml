<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="760"
             x:Class="FFXProjectEditor.SaveEditorEquipment_Control">
    <Grid ColumnDefinitions="Auto,*">
        <!-- Jarvis-UI (Sprint C 2026-06-20, OPT-C3): coluna master (Inventory slots) num Expander
             colapsável (ExpandDirection="Left", default expandido), padrão do Character/OPT-C2. -->
        <Expander Grid.Column="0" IsExpanded="True" ExpandDirection="Left"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0" Margin="0,0,14,0">
            <Expander.Header>
                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonInventory}" />
            </Expander.Header>
            <Border Padding="14" Classes="card" MinWidth="280" MaxWidth="340">
                <StackPanel Spacing="8">
                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_inventory_slots_840b1394}" />
                    <ListBox ItemsSource="{Binding EquipmentSlots}"
                             SelectedItem="{Binding SelectedEquipment, Mode=TwoWay}"
                             MinHeight="480">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Classes="secondaryAction" Click="Copy_Click">Copy slot</Button>
                    <Button Classes="secondaryAction" Click="Paste_Click">Paste slot</Button>
                </StackPanel>
            </Border>
        </Expander>
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="12" IsEnabled="{Binding HasSession}">
                <Border Padding="18" Classes="card" DataContext="{Binding EquipmentEditor}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_equipment_slot_4fc260df}" />
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Text="{x:Static res:Strings.U_occupied_30c51a99}" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Occupied, Mode=TwoWay}" />
                            <TextBlock Grid.Row="1" Text="{x:Static res:Strings.U_equip_character_113b7040}" />
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      ItemsSource="{Binding EquipCharacterLabels}"
                                      SelectedIndex="{Binding EquipCharacterIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="2" Text="{x:Static res:Strings.U_weapon_armor_name_88b2aaca}" />
                            <ComboBox Grid.Row="2" Grid.Column="1"
                                      ItemsSource="{Binding WeaponLabels}"
                                      SelectedIndex="{Binding WeaponIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="3" Text="{x:Static res:Strings.U_appearance_41def7a0}" />
                            <ComboBox Grid.Row="3" Grid.Column="1"
                                      ItemsSource="{Binding AppearanceLabels}"
                                      SelectedIndex="{Binding AppearanceIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.U_equipped_on_aed9e897}" />
                            <ComboBox Grid.Row="4" Grid.Column="1"
                                      ItemsSource="{Binding EquippedOnLabels}"
                                      SelectedIndex="{Binding EquippedOnIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="5" Text="{x:Static res:Strings.U_type_0_weapon_87df5230}" />
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Type, Mode=TwoWay}" />
                            <TextBlock Grid.Row="6" Text="{x:Static res:Strings.U_damage_formula_5b90a8ba}" />
                            <ComboBox Grid.Row="6" Grid.Column="1"
                                      ItemsSource="{Binding DamageFormulaLabels}"
                                      SelectedIndex="{Binding DamageFormulaIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="7" Text="{x:Static res:Strings.U_attack_1b81f28b}" />
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding AttackPower, Mode=TwoWay}" />
                            <TextBlock Grid.Row="8" Text="{x:Static res:Strings.U_critical_04b7b26c}" />
                            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Critical, Mode=TwoWay}" />
                            <TextBlock Grid.Row="9" Text="{x:Static res:Strings.U_auto_capacity_50b7f7a5}" />
                            <ComboBox Grid.Row="9" Grid.Column="1"
                                      ItemsSource="{Binding AutoCapacityLabels}"
                                      SelectedIndex="{Binding AutoCapacityIndex, Mode=TwoWay}" />
                            <TextBlock Grid.Row="10" Text="{x:Static res:Strings.U_auto_1_d14bf526}" />
                            <ComboBox Grid.Row="10" Grid.Column="1"
                                      ItemsSource="{Binding AutoAbilityLabels}"
                                      SelectedIndex="{Binding Auto1Index, Mode=TwoWay}" />
                            <TextBlock Grid.Row="11" Text="{x:Static res:Strings.U_auto_2_4_60780d99}" />
                            <StackPanel Grid.Row="11" Grid.Column="1" Spacing="6">
                                <ComboBox ItemsSource="{Binding AutoAbilityLabels}"
                                          SelectedIndex="{Binding Auto2Index, Mode=TwoWay}" />
                                <ComboBox ItemsSource="{Binding AutoAbilityLabels}"
                                          SelectedIndex="{Binding Auto3Index, Mode=TwoWay}" />
                                <ComboBox ItemsSource="{Binding AutoAbilityLabels}"
                                          SelectedIndex="{Binding Auto4Index, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <Button Classes="primaryAction" Click="Apply_Click">Apply equipment to buffer</Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
