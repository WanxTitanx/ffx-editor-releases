<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:FFXProjectEditor"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:rsp="clr-namespace:FFXProjectEditor.Styles"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1380"
             d:DesignHeight="820"
             rsp:Responsive.Breakpoints="True"
             x:Class="FFXProjectEditor.PlayerGrowthEditor_Control">

	<!-- Jarvis-UI Fase E §E2: hand-rolled Auto,* grid → ModuleMasterDetail_Shell. -->

	<UserControl.Styles>
        <StyleInclude Source="avares://FFXProjectEditor/Styles/EditorForms.axaml" />
		<Style Selector=":is(UserControl).narrow common|ModuleMasterDetail_Shell">
			<Setter Property="IsMasterExpanded" Value="False" />
		</Style>
	<Style Selector="ListBoxItem:selected Border.playerRow"><Setter Property="BorderBrush" Value="{DynamicResource AccentCoolBrush}" /><Setter Property="Background" Value="{DynamicResource PanelDeepBrush}" /></Style>
	</UserControl.Styles>

	<common:ModuleMasterDetail_Shell MasterHeaderLabel="PC Stats">

		<common:ModuleMasterDetail_Shell.MasterHeader>
			<StackPanel Spacing="4" Margin="2,0,2,2">
				<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_localized_player_kernel_8e1dcfb9}" />
				<TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
				           Text="{x:Static res:Strings.U_edit_ply_save_bin_ply_rom_bin_base_growth_curves_04b6a6d5}" />
			</StackPanel>
		</common:ModuleMasterDetail_Shell.MasterHeader>

		<common:ModuleMasterDetail_Shell.MasterList>
			<Grid RowDefinitions="Auto,*">
				<StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
					<StackPanel Spacing="8">
						<TextBox Watermark="{x:Static res:Strings.U_filter_by_label_slot_or_ap_formula_86d8a849}"
						         Text="{Binding FilterText, Mode=TwoWay}" />
						<Button HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_Refresh" AutomationProperties.Name="Refresh">Refresh</Button>
					</StackPanel>
					<TextBlock Classes="muted" FontSize="11" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
				</StackPanel>

				<ListBox Grid.Row="1"
				         ScrollViewer.VerticalScrollBarVisibility="Visible"
				         ScrollViewer.AllowAutoHide="False"
				         ItemsSource="{Binding DisplayedCharacters}"
				         SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Classes="cardSoft playerRow" Margin="0,0,0,4" Padding="10,8" CornerRadius="8">
								<StackPanel Spacing="4">
									<TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Label}" />
									<TextBlock Classes="sectionLabel" FontSize="11" Text="{Binding IndexLabel}" />
									<TextBlock Classes="muted" FontSize="11" Text="{Binding Summary}" TextWrapping="Wrap" />
									<TextBlock Classes="muted" FontSize="11" Text="{Binding RoleSummary}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</common:ModuleMasterDetail_Shell.MasterList>

		<common:ModuleMasterDetail_Shell.Detail>
			<DockPanel>
				<!-- SESSION CONTROLS (Pinned to Top) -->
				<Border DockPanel.Dock="Top" Margin="0,0,0,18" Padding="{DynamicResource SpacingLg}" Classes="card">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
						<StackPanel Spacing="10">
							<StackPanel Spacing="2" VerticalAlignment="Center">
								<TextBlock Text="{Binding EditSession.SessionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
								<TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
							</StackPanel>
<WrapPanel>
							<core:AutoSaveIndicator_Control Margin="0,0,12,6" VerticalAlignment="Center" Session="{Binding EditSession}" />
							<CheckBox Margin="0,0,12,6" VerticalAlignment="Center" IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
							<Button Margin="0,0,12,6" VerticalAlignment="Center" Classes="secondaryAction" IsEnabled="{Binding EditSession.CanUndo}" Click="Button_Undo">Undo</Button>
							<Button Margin="0,0,12,6" VerticalAlignment="Center" IsEnabled="{Binding EditSession.HasPendingChanges}" Click="Button_Save" Content="{x:Static res:Strings.CommonSave}" />
						</WrapPanel>
</StackPanel>
					</StackPanel>
				</Border>

				<!-- SCROLLABLE CONTENT -->
				<ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled"
				              Background="{DynamicResource AppSurfaceBrush}"
				              IsVisible="{Binding SelectedCharacter, Converter={x:Static ObjectConverters.IsNotNull}}">
					<StackPanel Classes="editorContent" Spacing="14" Margin="10,0,10,10">
						<Border Padding="{DynamicResource SpacingXl}" Classes="card">
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_character_growth_surface_927d914d}" />
								<TextBlock FontSize="28" FontWeight="Bold" Text="{Binding SelectedCharacter.Label}" />
								<TextBlock Classes="muted" Text="{Binding SelectedCharacterSummary}" TextWrapping="Wrap" />
							</StackPanel>
						</Border>


					<Border Padding="{DynamicResource SpacingLg}" Classes="card">
						<StackPanel Spacing="12">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_start_state_ffae5b4d}" />
							<TextBlock Classes="cardTitle" Text="ply_save.bin" />
							<TextBlock Classes="muted" Text="{x:Static res:Strings.U_these_are_the_exposed_starting_base_values_unmap_02943ccf}" TextWrapping="Wrap" />

							<UniformGrid Classes="editorFields primaryStats">
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonBaseHp}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseHp, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonBaseMp}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseMp, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonCurrentHp}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.CurrentHp, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonCurrentMp}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.CurrentMp, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_current_ap_d0a2a1be}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.CurrentAp, Mode=TwoWay}" /></StackPanel>


								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_str_5571a7fb}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseStrength, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_def_4f78849f}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseDefense, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_mag_6ecd0a18}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseMagic, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_mdf_b182c749}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseMagicDefense, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_agi_1a8e286a}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseAgility, Mode=TwoWay}" /></StackPanel>


								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_lck_bd5c080c}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseLuck, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_eva_bdf7f4d7}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseEvasion, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_base_acc_b4577da7}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.BaseAccuracy, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_start_weapon_611fe669}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.EquippedWeaponIndex, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_start_armor_44ac4496}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.EquippedArmorIndex, Mode=TwoWay}" /></StackPanel>


								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_poison_e4db2da4}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.PoisonDamagePercent, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_od_mode_ad994a3e}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.OverdriveMode, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_od_current_dace6952}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.OverdriveCurrent, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_sphere_lv_free_628c38b9}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.SphereLevelsAvailable, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_sphere_lv_used_ed736719}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.SphereLevelsUsed, Mode=TwoWay}" /></StackPanel>
							</UniformGrid>
						</StackPanel>
					</Border>

					<Border Padding="{DynamicResource SpacingLg}" Classes="card">
						<StackPanel Spacing="12">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_growth_curves_952af3f5}" />
							<TextBlock Classes="cardTitle" Text="ply_rom.bin" />
							<TextBlock Classes="muted" Text="{x:Static res:Strings.U_ap_coefficients_and_stat_growth_pairs_are_expose_e279db2e}" TextWrapping="Wrap" />
							<Expander Header="{x:Static res:Strings.CommonTechnicalDetails}"><common:AtlasEvidenceBadgeStrip Evidence="{Binding SelectedCharacterEvidence}" /></Expander>

							<UniformGrid Classes="editorFields pairedFields">
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_genre_raw_4ee57053}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.GenreByte, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_ap_coef_a_bd1eda07}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.ApReqCoefficientA, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_ap_coef_b_171344d1}" /><TextBox Classes="numField" Text="{Binding SelectedCharacter.ApReqCoefficientB, Mode=TwoWay}" /></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_ap_coef_c_max_fa632c28}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="70" Text="{Binding SelectedCharacter.ApReqCoefficientC, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="70" Text="{Binding SelectedCharacter.ApReqMax, Mode=TwoWay}" /></Grid></StackPanel>


								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_hp_a_b_87047c87}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.HpCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.HpCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_mp_a_b_402b837f}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.MpCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.MpCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_str_a_b_71fb29c7}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.StrengthCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.StrengthCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_def_a_b_513c0edf}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.DefenseCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.DefenseCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>


								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_mag_a_b_14c54a0a}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.MagicCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.MagicCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_mdf_a_b_12af1dae}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.MagicDefenseCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.MagicDefenseCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_agi_a_b_788394fb}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.AgilityCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.AgilityCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>
								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_eva_a_b_f617ac21}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.EvasionCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.EvasionCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>


								<StackPanel Spacing="6"><TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_acc_a_b_bd1b337d}" /><Grid ColumnDefinitions="*,8,*"><TextBox Classes="numField" MinWidth="60" Text="{Binding SelectedCharacter.AccuracyCoefficientA, Mode=TwoWay}" /><TextBox Classes="numField" Grid.Column="2" MinWidth="60" Text="{Binding SelectedCharacter.AccuracyCoefficientB, Mode=TwoWay}" /></Grid></StackPanel>
								<Border Padding="{DynamicResource SpacingMd}">
									<StackPanel Spacing="6">
										<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonInterpretation}" />
										<TextBlock FontWeight="SemiBold" Text="{Binding SelectedCharacter.ApFormulaSummary}" />
										<TextBlock Classes="muted" Text="{Binding SelectedCharacter.AeonGrowthSummary}" TextWrapping="Wrap" />
										<TextBlock Classes="muted" Text="{Binding SelectedCharacter.ObscureFieldSummary}" />
									</StackPanel>
								</Border>
							</UniformGrid>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
			</DockPanel>
		</common:ModuleMasterDetail_Shell.Detail>

	</common:ModuleMasterDetail_Shell>
</UserControl>
