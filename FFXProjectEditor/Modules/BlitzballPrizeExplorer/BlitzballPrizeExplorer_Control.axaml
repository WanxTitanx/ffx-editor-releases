<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:bpe="clr-namespace:FFXProjectEditor.Modules.BlitzballPrizeExplorer"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1500"
             d:DesignHeight="860"
             x:Class="FFXProjectEditor.BlitzballPrizeExplorer_Control">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="260" MaxWidth="420" />
            <ColumnDefinition Width="6*" MinWidth="320" />
            <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="460" />
        </Grid.ColumnDefinitions>

        <!-- Left: rule banner + filters -->
        <Border Grid.Column="0" Margin="18,18,0,18" Padding="{DynamicResource SpacingLg}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                <StackPanel Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_spira_data_atlas_read_only_39d167a8}" />
                    <TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_blitzball_prizes_e6a900bd}" />
                    <TextBlock Classes="muted" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,14,0,0" Padding="{DynamicResource SpacingMd}">
                    <TextBlock FontSize="11" Foreground="{DynamicResource AccentCoolBrush}" Text="{Binding RuleBanner}" TextWrapping="Wrap" />
                </Border>

                <TextBox Grid.Row="2"
                         Margin="0,14,0,0"
                         Watermark="{x:Static res:Strings.U_buscar_por_prize_takara_reward_status_81bb63f0}"
                         Text="{Binding FilterText, Mode=TwoWay}" />

                <StackPanel Grid.Row="3" Margin="0,12,0,0" Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_status_evidence_e05edf75}" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="6">
                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonKind}" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding KindOptions}"
                              SelectedItem="{Binding SelectedKind, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Grid.Row="5" Margin="0,14,0,0" VerticalAlignment="Bottom"
                           Classes="muted" Text="{Binding FilterSummary}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Center: searchable prize grid -->
        <Border Grid.Column="1" Margin="18" Padding="{DynamicResource SpacingLg}">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_prize_index_resolution_be2bdf76}" />
                    <TextBlock Classes="muted"
                               Text="{x:Static res:Strings.U_prize_id_takara_index_reward_resolvido_evidence__911d54b8}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <DataGrid Grid.Row="1"
                          Margin="0,12,0,0"
                          ItemsSource="{Binding DisplayedPrizes}"
                          SelectedItem="{Binding SelectedPrize, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static res:Strings.CommonPrizeId}" Binding="{Binding PrizeId}" Width="120" />
                        <DataGridTextColumn Header="{x:Static res:Strings.CommonTakara}" Binding="{Binding TakaraIndex}" Width="90" />
                        <DataGridTextColumn Header="{x:Static res:Strings.U_reward_ref_557c96f9}" Binding="{Binding Reward}" Width="2*" />
                        <DataGridTextColumn Header="{x:Static res:Strings.CommonKind}" Binding="{Binding Kind}" Width="100" />
                        <DataGridTemplateColumn Header="{x:Static res:Strings.CommonEvidence}" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="{DynamicResource RadiusPill}" Padding="9,2" BorderThickness="1" Margin="0,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            BorderBrush="{Binding Status, Converter={x:Static bpe:EvidenceStatusBrushConverter.Instance}}">
                                        <TextBlock FontSize="11" Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={x:Static bpe:EvidenceStatusBrushConverter.Instance}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Right: detail panel + evidence badges -->
        <Panel Grid.Column="2" Margin="0,18,18,18">

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          Background="{DynamicResource AppSurfaceBrush}"
                          IsVisible="{Binding SelectedPrize, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="14">
                    <Border Padding="{DynamicResource SpacingLg}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_detalhe_do_prize_07a48c4a}" />
                        <TextBlock FontSize="18" FontWeight="Bold" TextWrapping="Wrap"
                                   Text="{Binding SelectedPrize.Title}" />
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Classes="muted" Text="{x:Static res:Strings.CommonPrizeId}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{Binding SelectedPrize.PrizeId}" />
                            <TextBlock Grid.Row="1" Classes="muted" Text="{x:Static res:Strings.CommonTakara}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="10,0,0,0" Text="{Binding SelectedPrize.TakaraIndex}" />
                            <TextBlock Grid.Row="2" Classes="muted" Text="{x:Static res:Strings.CommonEvidence}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" Text="{Binding SelectedPrize.Status}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="{DynamicResource SpacingLg}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_regra_resolucao_c91336e4}" />
                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedPrize.Summary}" />
                        <TextBlock Classes="sectionLabel" Margin="0,8,0,0" Text="{x:Static res:Strings.U_origem_transform_limitacoes_459c2ac5}" />
                        <TextBlock FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Text="{Binding SelectedPrize.DetailText}" />
                    </StackPanel>
                </Border>

                <Border Padding="{DynamicResource SpacingLg}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_evidence_badges_atlas_bible_3174b3a2}" />
                        <common:AtlasEvidenceBadgeStrip Evidence="{Binding SelectedPrizeEvidence}" />
                        <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                   Text="{x:Static res:Strings.U_read_only_catalogo_proved_candidate_regra_offlin_68dbdc4c}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
