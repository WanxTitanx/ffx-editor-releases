<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ctrl="clr-namespace:FFXProjectEditor.Controls"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1400"
             d:DesignHeight="760"
             x:Class="FFXProjectEditor.EventExplorer_Control">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*" MinWidth="280" MaxWidth="420" />
			<ColumnDefinition Width="5*" />
		</Grid.ColumnDefinitions>
		<Border Grid.Column="0" Margin="18,18,0,18" Padding="{DynamicResource SpacingLg}" Classes="card">
			<Grid RowDefinitions="Auto,Auto,*">
				<StackPanel Spacing="8">
					<Grid ColumnDefinitions="*,Auto">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_event_corpus_e9f4e329}" VerticalAlignment="Center" />
						<ctrl:CapabilityBadge Grid.Column="1" Name="EventCapabilityBadge" VerticalAlignment="Center" />
					</Grid>
					<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_event_explorer_9e4bc3a8}" />
					<TextBlock Classes="muted" Text="{x:Static res:Strings.U_parse_event_structural_file_parsing_parser_corpu_af087766}" TextWrapping="Wrap" />
				</StackPanel>

				<StackPanel Grid.Row="1" Margin="0,14,0,14" Spacing="10">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_Refresh">Refresh</Button>
						<Button HorizontalAlignment="Left" Classes="primaryAction" Click="Button_Save" IsEnabled="{Binding CanSave}">Save dialogue</Button>
						<Button HorizontalAlignment="Left" Classes="secondaryAction" Name="Button_ReviewDiff" Click="Button_ReviewDiff_Click" AutomationProperties.Name="Review Diff">🔍 Diff</Button>
					</StackPanel>
					<TextBox Watermark="{x:Static res:Strings.U_filter_by_event_id_or_relative_path_577cc2e5}"
							 Text="{Binding FilterText, Mode=TwoWay}" />
					<TextBlock Classes="muted" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
					<TextBlock Classes="muted" Text="{Binding ScriptStatus}" TextWrapping="Wrap" />
						<TextBlock Foreground="#7FD6A0" Text="{Binding SaveStatus}" TextWrapping="Wrap" />
				</StackPanel>

				<ListBox Grid.Row="2"
						 ItemsSource="{Binding DisplayedEvents}"
						 SelectedItem="{Binding SelectedEvent, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,10" Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
								<StackPanel Spacing="4">
									<TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding EventId}" />
									<TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>

		<ScrollViewer Grid.Column="1" Margin="18" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="14">
				<Border Padding="{DynamicResource SpacingXl}" Classes="card heroGradient">
					<StackPanel Spacing="8">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_selected_event_e4308017}" />
						<TextBlock FontSize="28" FontWeight="Bold" Text="{Binding SelectedEvent.EventId}" />
						<TextBlock Classes="muted" Text="{Binding SelectedEventSummary}" TextWrapping="Wrap" />
						<TextBlock Classes="muted" Text="{Binding SelectedEventScope}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" MinWidth="280" MaxWidth="480" />
						<ColumnDefinition Width="3*" />
					</Grid.ColumnDefinitions>
					<Border Grid.Column="0" Padding="{DynamicResource SpacingLg}" Classes="card">
						<StackPanel Spacing="12">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonChunkLayout}" />
							<ItemsControl ItemsSource="{Binding SelectedChunks}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,0,0,10" Padding="10" Classes="cardSoft">
											<StackPanel Spacing="3">
												<TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
												<TextBlock Classes="muted" Text="{Binding IndexLabel}" />
												<TextBlock Classes="muted" Text="{Binding OffsetLabel}" />
												<TextBlock Classes="muted" Text="{Binding LengthLabel}" />
												<TextBlock Classes="muted" Text="{Binding RangeLabel}" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Border Grid.Column="1" Margin="14,0,0,0" Padding="{DynamicResource SpacingLg}" Classes="card">
						<StackPanel Spacing="12">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_dialogue_jp_us_editable_1f07110f}" />
								<TextBox Watermark="{x:Static res:Strings.U_procurar_por_palavra_nas_falas_fd2bc900}" Text="{Binding TextFilter, Mode=TwoWay}" />
								<StackPanel Orientation="Horizontal" Spacing="16">
									<CheckBox IsChecked="{Binding ShowEnglish, Mode=TwoWay}" Content="{x:Static res:Strings.U_ingles_us_8f4e925c}" />
									<CheckBox IsChecked="{Binding ShowJapanese, Mode=TwoWay}" Content="{x:Static res:Strings.U_japones_jp_445669b0}" />
								</StackPanel>
							<ItemsControl ItemsSource="{Binding SelectedTextRows}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,0,0,10" Padding="10" Classes="cardSoft">
											<StackPanel Spacing="4">
												<TextBlock FontWeight="SemiBold" Text="{Binding Locale}" />
												<TextBlock Classes="sectionLabel" Text="{Binding IndexLabel}" />
												<TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
												<TextBox Text="{Binding RegularText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" />
												<TextBox Text="{Binding SimplifiedText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" IsVisible="{Binding HasDistinctSimplified}" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</Grid>

				<Expander Header="{x:Static res:Strings.U_interactive_disassembly_e4bc49c8}" IsExpanded="True">
					<StackPanel Spacing="10">
							<ListBox ItemsSource="{Binding DisassemblyLines}"
								 SelectedItem="{Binding SelectedInstruction, Mode=TwoWay}"
								 MinHeight="300"
								 MaxHeight="480">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Border Padding="6,3" Classes="cardSoft">
										<StackPanel Orientation="Horizontal" Spacing="8">
											<TextBlock Text="{Binding OffsetLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" Foreground="#888" />
											<TextBlock Text="{Binding RawLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" Foreground="#666" />
											<TextBlock Text="{Binding Mnemonic}"
													   FontFamily="Cascadia Mono,Consolas,Monospace"
													   FontWeight="Bold"
													   Foreground="{Binding MnemonicBrush}" />
											<TextBlock Text="{Binding OperandLabel}"
													   FontFamily="Cascadia Mono,Consolas,Monospace"
													   IsVisible="{Binding ShowOperand}"
													   Foreground="#7FD6A0" />
											<TextBlock Text="{Binding GlossaryLabel}"
													   FontFamily="Cascadia Mono,Consolas,Monospace"
													   Foreground="#7FD6A0"
													   IsVisible="{Binding ShowGlossary}" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
						<Border Padding="10" Classes="cardSoft">
							<StackPanel Spacing="6">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_instruction_detail_096d3887}" />
								<TextBlock Text="{Binding SelectedInstructionDetail}" FontFamily="Cascadia Mono,Consolas,Monospace" TextWrapping="Wrap" />
							</StackPanel>
						</Border>
						<Border Padding="10" Classes="cardSoft" IsVisible="{Binding CanPatchOperand}">
							<StackPanel Spacing="8" Orientation="Horizontal">
								<TextBlock VerticalAlignment="Center" FontWeight="SemiBold">Operand:</TextBlock>
								<TextBox Text="{Binding PatchOperandHex, Mode=TwoWay}" Width="120" FontFamily="Cascadia Mono,Consolas,Monospace" />
								<Button Classes="primaryAction" Click="Button_ApplyPatch">Apply</Button>
								<TextBlock Text="{Binding PatchStatus}" Foreground="#7FD6A0" VerticalAlignment="Center" />
							</StackPanel>
						</Border>
					</StackPanel>
				</Expander>

				<Expander Header="{x:Static res:Strings.U_glossary_reference_180_named_calls_4d93813f}">
					<StackPanel Spacing="10">
						<TextBox Watermark="{x:Static res:Strings.U_search_by_name_or_0xid_2a43318e}" Text="{Binding GlossaryFilter, Mode=TwoWay}" />
						<Grid ColumnDefinitions="2*,3*" MinHeight="200">
							<ListBox Grid.Column="0"
									 ItemsSource="{Binding GlossaryDisplayItems}"
									 SelectedItem="{Binding SelectedGlossaryItem, Mode=TwoWay}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Padding="6,3" Classes="cardSoft">
											<StackPanel Spacing="2">
												<TextBlock FontWeight="SemiBold" Text="{Binding ShortLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" />
												<TextBlock Text="{Binding Name}" Classes="muted" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
							<Border Grid.Column="1" Margin="10,0,0,0" Padding="10" Classes="cardSoft">
								<TextBlock Text="{Binding SelectedGlossaryDetail}" FontFamily="Cascadia Mono,Consolas,Monospace" TextWrapping="Wrap" />
							</Border>
						</Grid>
					</StackPanel>
				</Expander>

				<Expander Header="{x:Static res:Strings.U_raw_script_preview_read_only_ef26e363}">
					<TextBox Text="{Binding ScriptPreview}"
							 IsReadOnly="True"
							 AcceptsReturn="True"
							 TextWrapping="NoWrap"
							 MinHeight="240"
							 FontFamily="Cascadia Mono,Consolas,Monospace" />
				</Expander>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
