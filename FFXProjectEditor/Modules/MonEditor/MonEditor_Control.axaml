																<TextBlock DockPanel.Dock="Right" Text="{Binding RawHex}" Foreground="{DynamicResource AccentCoolBrush}"/>
															</DockPanel>
															<TextBlock Text="{Binding CoverageLabel}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold"/>
															<TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource AccentBrush}"/>
