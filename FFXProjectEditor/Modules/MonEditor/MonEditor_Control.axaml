<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:FFXProjectEditor"
             xmlns:converters="clr-namespace:FFXProjectEditor.Converters"
             xmlns:views="clr-namespace:FFXProjectEditor.Modules.Common.ViewerShell"
             xmlns:ctrl="clr-namespace:FFXProjectEditor.Controls"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FFXProjectEditor.MonEditor_Control"
			 Name="ThisControl">

	<UserControl.Resources>
		<converters:GameCategory_Converter x:Key="GameCategoryConverter"/>
	</UserControl.Resources>

	<UserControl.Styles>
		<!-- Modernize the legacy raw controls in this view to match the studio look (presentation only;
		     scoped to this control). Turns bare WinForms-y Labels/Separators into clean studio chrome. -->
		<Style Selector="Label">
			<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Padding" Value="0,2" />
		</Style>
		<Style Selector="Separator">
			<Setter Property="Background" Value="{DynamicResource PanelStrokeBrush}" />
			<Setter Property="Height" Value="1" />
			<Setter Property="Margin" Value="0,6" />
		</Style>
	</UserControl.Styles>

	<DockPanel>

		<Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="16,12" Classes="cardSoft">
			<StackPanel Spacing="10">
				<Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_monster_data_editor_monsterstatsheet_amp_monster_74b333f4}" TextWrapping="Wrap" VerticalAlignment="Center" />
					<ctrl:CapabilityBadge Grid.Column="1" Name="MonsterCapabilityBadge" VerticalAlignment="Center" />
				</Grid>
				<StackPanel Spacing="8">
					<StackPanel Spacing="2" VerticalAlignment="Center">
						<TextBlock Text="{Binding EditSession.SessionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
						<TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" TextWrapping="Wrap" />
					</StackPanel><WrapPanel>
					
					<TextBlock Margin="0,0,10,6" VerticalAlignment="Center" Classes="muted" FontSize="11" Text="{x:Static res:Strings.U_mirror_to_targets_on_save_f48bf7a7}" />
					<ComboBox Margin="0,0,10,6" VerticalAlignment="Center" MinWidth="120"
							  ItemsSource="{Binding BatchMirrorScopeOptions}"
							  SelectedItem="{Binding SelectedBatchMirrorScope, Mode=TwoWay}" />

					<local:AutoSaveIndicator_Control Margin="0,0,10,6"
													 VerticalAlignment="Center"
													 Session="{Binding EditSession}" />
					<CheckBox Classes="flag" Margin="0,0,10,6"
							  VerticalAlignment="Center"
							  IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
					<Button Margin="0,0,10,6"
							VerticalAlignment="Center"
							Classes="secondaryAction"
							IsEnabled="{Binding EditSession.CanUndo}"
							Click="Button_Undo" AutomationProperties.Name="Undo">Undo</Button>
					<Button Margin="0,0,10,6"
							VerticalAlignment="Center"
							Classes="dangerAction"
							IsEnabled="{Binding EditSession.HasPendingChanges}"
							Click="Button_Discard" AutomationProperties.Name="Discard">Discard</Button>
					<Button Margin="0,0,10,6"
							VerticalAlignment="Center"
							Classes="secondaryAction"
							IsEnabled="{Binding EditSession.HasPendingChanges}"
							Click="Button_ReviewDiff" AutomationProperties.Name="ReviewDiff">🔍 Diff</Button>
					<Button Margin="0,0,10,6"
							VerticalAlignment="Center"
							Classes="primaryAction accentGold"
							IsEnabled="{Binding EditSession.HasPendingChanges}"
							Click="Button_Save" AutomationProperties.Name="Save">Save</Button>
				</WrapPanel></StackPanel>
			</StackPanel>
		</Border>

		<!-- Editor -->
		<TabControl SelectedIndex="{Binding SelectorDM.SelectedTab}">

			<!-- STATUS -->
			<TabItem Header="{x:Static res:Strings.TermStatus}">
				<ScrollViewer>
					<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">

						<Expander Header="{x:Static res:Strings.U_info_4b631f69}" IsExpanded="{Binding SelectorDM.InfoExpanded}" HorizontalAlignment="Stretch">
							<StackPanel Orientation="Vertical">
								<WrapPanel Margin="0,0,0,8" VerticalAlignment="Center">
									<Label VerticalAlignment="Center">Text Locale</Label>
									<ComboBox Width="150"
									          Margin="8,0,0,0"
									          VerticalAlignment="Center"
									          ItemsSource="{Binding MonsterStatSheet.TextLocaleOptions}"
									          SelectedItem="{Binding MonsterStatSheet.SelectedTextLocale, Mode=TwoWay}" />
									<TextBlock Margin="12,0,0,0"
									           VerticalAlignment="Center"
									           Classes="muted"
									           Text="{Binding MonsterStatSheet.TextLocaleSummary}"
									           TextWrapping="Wrap" />
								</WrapPanel>
								<TextBlock Margin="0,0,0,8"
								           Classes="muted"
								           Text="{Binding MonsterStatSheet.LocalizedTextAuthoringSummary}"
								           TextWrapping="Wrap" />
								<Label>Name</Label>
								<TextBox IsReadOnly="{Binding MonsterStatSheet.IsLocalizedTextReadOnly}"
								         Text="{Binding MonsterStatSheet.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
								<Label>Sensor</Label>
								<TextBox IsReadOnly="{Binding MonsterStatSheet.IsLocalizedTextReadOnly}"
								         Text="{Binding MonsterStatSheet.Sensor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
								<Label>Scan</Label>
								<TextBox IsReadOnly="{Binding MonsterStatSheet.IsLocalizedTextReadOnly}"
								         Text="{Binding MonsterStatSheet.Scan, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
							</StackPanel>
						</Expander>

						<Expander Header="{x:Static res:Strings.CommonStats}" IsExpanded="{Binding SelectorDM.StatsExpanded}" HorizontalAlignment="Stretch">
							<StackPanel Orientation="Vertical">

								<WrapPanel>
									<local:Property_Template Margin="5" Property_Label="HP Overkill" Property_Value="{Binding MonsterStatSheet.HpOverkill}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="99999"/>
									<local:Property_Template Margin="5" Property_Label="HP" Property_Value="{Binding MonsterStatSheet.Hp}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="9999999"/>
									<local:Property_Template Margin="5" Property_Label="MP" Property_Value="{Binding MonsterStatSheet.Mp}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="99999"/>
									<local:Property_Template Margin="5" Property_Label="Strength" Property_Value="{Binding MonsterStatSheet.Strength}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
									<local:Property_Template Margin="5" Property_Label="Defense" Property_Value="{Binding MonsterStatSheet.Defense}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
									<local:Property_Template Margin="5" Property_Label="Magic" Property_Value="{Binding MonsterStatSheet.Magic}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
									<local:Property_Template Margin="5" Property_Label="M. Defense" Property_Value="{Binding MonsterStatSheet.MagicDefense}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
									<local:Property_Template Margin="5" Property_Label="Agility" Property_Value="{Binding MonsterStatSheet.Agility}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
									<local:Property_Template Margin="5" Property_Label="Luck" Property_Value="{Binding MonsterStatSheet.Luck}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
									<local:Property_Template Margin="5" Property_Label="Evasion" Property_Value="{Binding MonsterStatSheet.Evasion}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
									<local:Property_Template Margin="5" Property_Label="Accuracy" Property_Value="{Binding MonsterStatSheet.Accuracy}" BorderWidth="200" ValueBorderWidth="100" ShowProgressBar="True" ProgressBarMaximum="255"/>
								</WrapPanel>

							</StackPanel>
						</Expander>

						<Expander Header="{x:Static res:Strings.CommonProperties}" IsExpanded="{Binding SelectorDM.PropertiesExpanded}" HorizontalAlignment="Stretch">
							<StackPanel>
								<WrapPanel>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_Armored}">Armored</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityFractionalDamage}">ImmunityFractionalDamage</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityLife}">ImmunityLife</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunitySensor}">ImmunitySensor</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityScanAgain_Maybe}">ImmunityScanAgain</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityPhysicalDamage}">ImmunityPhysicalDamage</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityMagicDamage}">ImmunityMagicDamage</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityAllDamage}">ImmunityAllDamage</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityDelay}">ImmunityDelay</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunitySlice_Maybe}">ImmunitySlice</CheckBox>
									<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Prop_ImmunityBribe_Maybe}">ImmunityBribe</CheckBox>
								</WrapPanel>
								<WrapPanel HorizontalAlignment="Center">
									<local:Property_Template Margin="5" Property_Label="Poison Damage" Property_Value="{Binding MonsterStatSheet.PoisonDamage}" BorderWidth="200" ValueBorderWidth="50"/>
									<local:Property_Template Margin="5" Property_Label="Doom Counter" Property_Value="{Binding MonsterStatSheet.DoomCount}" BorderWidth="200" ValueBorderWidth="50"/>
								</WrapPanel>
							</StackPanel>
						</Expander>

						<Expander Header="{x:Static res:Strings.U_elemental_weaknesses_7a8a26b0}" IsExpanded="{Binding SelectorDM.ElementalWeaknessesExpanded}" HorizontalAlignment="Stretch">
							<StackPanel>

								<Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*,*,*,*" MaxWidth="600" HorizontalAlignment="Left">
									<Label Grid.Row="0" Grid.Column="1" Width="100" HorizontalContentAlignment="Center">Fire</Label>
									<Label Grid.Row="0" Grid.Column="2" Width="100" HorizontalContentAlignment="Center">Blizzard</Label>
									<Label Grid.Row="0" Grid.Column="3" Width="100" HorizontalContentAlignment="Center">Thunder</Label>
									<Label Grid.Row="0" Grid.Column="4" Width="100" HorizontalContentAlignment="Center">Water</Label>
									<Label Grid.Row="0" Grid.Column="5" Width="100" HorizontalContentAlignment="Center">Holy</Label>
									<Label Grid.Row="0" Grid.Column="6" Width="100" HorizontalContentAlignment="Center">Dark</Label>

									<Label Grid.Row="1" Grid.Column="0">Absorb</Label>
									<CheckBox Classes="flag" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.AbsorbFire}"/>
									<CheckBox Classes="flag" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.AbsorbBlizzard}"/>
									<CheckBox Classes="flag" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.AbsorbThunder}"/>
									<CheckBox Classes="flag" Grid.Row="1" Grid.Column="4" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.AbsorbWater}"/>
									<CheckBox Classes="flag" Grid.Row="1" Grid.Column="5" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.AbsorbHoly}"/>
									<CheckBox Classes="flag" Grid.Row="1" Grid.Column="6" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.AbsorbDark}"/>

									<Label Grid.Row="2" Grid.Column="0">Immune</Label>
									<CheckBox Classes="flag" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ImmuneFire}"/>
									<CheckBox Classes="flag" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ImmuneBlizzard}"/>
									<CheckBox Classes="flag" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ImmuneThunder}"/>
									<CheckBox Classes="flag" Grid.Row="2" Grid.Column="4" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ImmuneWater}"/>
									<CheckBox Classes="flag" Grid.Row="2" Grid.Column="5" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ImmuneHoly}"/>
									<CheckBox Classes="flag" Grid.Row="2" Grid.Column="6" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ImmuneDark}"/>

									<Label Grid.Row="3" Grid.Column="0">Resist</Label>
									<CheckBox Classes="flag" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ResistFire}"/>
									<CheckBox Classes="flag" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ResistBlizzard}"/>
									<CheckBox Classes="flag" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ResistThunder}"/>
									<CheckBox Classes="flag" Grid.Row="3" Grid.Column="4" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ResistWater}"/>
									<CheckBox Classes="flag" Grid.Row="3" Grid.Column="5" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ResistHoly}"/>
									<CheckBox Classes="flag" Grid.Row="3" Grid.Column="6" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.ResistDark}"/>

									<Label Grid.Row="4" Grid.Column="0">Weak</Label>
									<CheckBox Classes="flag" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.WeakFire}"/>
									<CheckBox Classes="flag" Grid.Row="4" Grid.Column="2" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.WeakBlizzard}"/>
									<CheckBox Classes="flag" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.WeakThunder}"/>
									<CheckBox Classes="flag" Grid.Row="4" Grid.Column="4" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.WeakWater}"/>
									<CheckBox Classes="flag" Grid.Row="4" Grid.Column="5" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.WeakHoly}"/>
									<CheckBox Classes="flag" Grid.Row="4" Grid.Column="6" HorizontalAlignment="Center" IsChecked="{Binding MonsterStatSheet.ElementalWeakness.WeakDark}"/>
								</Grid>

							</StackPanel>
						</Expander>

						<Expander Header="{x:Static res:Strings.U_statuses_e92aab82}" IsExpanded="{Binding SelectorDM.StatusExpanded}" HorizontalAlignment="Stretch">
							<StackPanel Spacing="12" Margin="0,8,0,0">
								<Border Classes="cardSoft" Padding="12">
									<StackPanel Spacing="8">
										<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_resistances_eeec8e86}" />
										<WrapPanel>
											<local:Property_Template Margin="5" Property_Label="Death" Property_Value="{Binding MonsterStatSheet.StatusResistance.Death}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Zombie" Property_Value="{Binding MonsterStatSheet.StatusResistance.Zombie}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Petrify" Property_Value="{Binding MonsterStatSheet.StatusResistance.Petrify}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Poison" Property_Value="{Binding MonsterStatSheet.StatusResistance.Poison}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="BreakPower" Property_Value="{Binding MonsterStatSheet.StatusResistance.BreakPower}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="BreakMagic" Property_Value="{Binding MonsterStatSheet.StatusResistance.BreakMagic}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="BreakArmor" Property_Value="{Binding MonsterStatSheet.StatusResistance.BreakArmor}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="BreakMental" Property_Value="{Binding MonsterStatSheet.StatusResistance.BreakMental}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Confuse" Property_Value="{Binding MonsterStatSheet.StatusResistance.Confuse}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Berserk" Property_Value="{Binding MonsterStatSheet.StatusResistance.Berserk}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Provoke" Property_Value="{Binding MonsterStatSheet.StatusResistance.Provoke}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Threaten" Property_Value="{Binding MonsterStatSheet.StatusResistance.Threaten}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Sleep" Property_Value="{Binding MonsterStatSheet.StatusResistance.Sleep}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Silence" Property_Value="{Binding MonsterStatSheet.StatusResistance.Silence}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Darkness" Property_Value="{Binding MonsterStatSheet.StatusResistance.Darkness}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Shell" Property_Value="{Binding MonsterStatSheet.StatusResistance.Shell}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Protect" Property_Value="{Binding MonsterStatSheet.StatusResistance.Protect}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Reflect" Property_Value="{Binding MonsterStatSheet.StatusResistance.Reflect}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="NulTide" Property_Value="{Binding MonsterStatSheet.StatusResistance.NulTide}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="NulBlaze" Property_Value="{Binding MonsterStatSheet.StatusResistance.NulBlaze}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="NulShock" Property_Value="{Binding MonsterStatSheet.StatusResistance.NulShock}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="NulFrost" Property_Value="{Binding MonsterStatSheet.StatusResistance.NulFrost}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Regen" Property_Value="{Binding MonsterStatSheet.StatusResistance.Regen}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Haste" Property_Value="{Binding MonsterStatSheet.StatusResistance.Haste}" BorderWidth="140" ValueBorderWidth="45"/>
											<local:Property_Template Margin="5" Property_Label="Slow" Property_Value="{Binding MonsterStatSheet.StatusResistance.Slow}" BorderWidth="140" ValueBorderWidth="45"/>
										</WrapPanel>
									</StackPanel>
								</Border>

								<Border Classes="cardSoft" Padding="12">
									<StackPanel Spacing="8">
										<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_auto_permanent_790ee64e}" />
										<WrapPanel>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Death}">Death</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Zombie}">Zombie</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Petrify}">Petrify</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Poison}">Poison</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_BreakPower}">BreakPower</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_BreakMagic}">BreakMagic</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_BreakArmor}">BreakArmor</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_BreakMental}">BreakMental</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Confuse}">Confuse</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Berserk}">Berserk</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Provoke}">Provoke</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Threaten}">Threaten</CheckBox>
										</WrapPanel>
									</StackPanel>
								</Border>

								<Border Classes="cardSoft" Padding="12">
									<StackPanel Spacing="8">
										<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_auto_temporal_amp_special_b13408a2}" />
										<WrapPanel>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Sleep}">Sleep</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Silence}">Silence</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Shell}">Shell</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Protect}">Protect</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Reflect}">Reflect</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_NulTide}">NulTide</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_NulBlaze}">NulBlaze</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_NulShock}">NulShock</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_NulFrost}">NulFrost</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Regen}">Regen</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Haste}">Haste</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Slow}">Slow</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Scan}">Scan</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_DistillPower}">DistillPower</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_DistillMana}">DistillMana</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_DistillSpeed}">DistillSpeed</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Unused3_04}">Distill Unused</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_DistillAbility}">DistillAbility</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Shield}">Shield</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Boost}">Boost</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Eject}">Eject</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_AutoLife}">AutoLife</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Curse}">Curse</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Defend}">Defend</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Guard}">Guard</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Sentinel}">Sentinel</CheckBox>
											<CheckBox Classes="flag" Margin="4" Width="140" IsChecked="{Binding MonsterStatSheet.Auto_Doom}">Doom</CheckBox>
										</WrapPanel>
									</StackPanel>
								</Border>

								<Border Classes="cardSoft" Padding="12">
									<StackPanel Spacing="8">
