			<TabItem Header="{x:Static res:Strings.U_models_f3798f81}">
				<Grid ColumnDefinitions="*,420" Margin="4">
					<ScrollViewer Grid.Column="0">
						<StackPanel Spacing="8">
							<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_battle_models_model1_model2_76d1bed7}" />
							<TextBlock Classes="muted" TextWrapping="Wrap"
							           Text="{x:Static res:Strings.U_catalog_from_the_ffxmon_community_enemy_editor_v_c27fee60}" />

							<local:BattleModel_Template Label="Model1 index (base / skeleton)" Picker="{Binding Model1Picker}" />
							<local:BattleModel_Template Label="Model2 index (variant skin)" Picker="{Binding Model2Picker}" />

							<Border Classes="cardSoft" Padding="10" Margin="5">
								<StackPanel Spacing="4">
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_selected_pair_07fc6342}" />
									<TextBlock Text="{Binding ModelFusionSummary}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>

							<WrapPanel>
								<Button Classes="secondaryAction" Margin="5" Click="Button_ApplyVariantMainModel">Apply MAIN MODEL pair for Model2</Button>
								<Button Classes="secondaryAction" Margin="5" Click="Button_OpenModelPreviewBrowser"
								        IsVisible="{Binding IsExternalModelPreview}" Content="{x:Static res:Strings.U_Vh_OpenInBrowser}" />
							</WrapPanel>

							<Border Classes="cardSoft" Padding="10" Margin="5">
								<TextBlock Text="{Binding ModelGuidanceText}" TextWrapping="Wrap" />
							</Border>

							<Expander Header="{x:Static res:Strings.U_ctb_icon_capture_berserk_f3cb61d0}" IsExpanded="True">
								<StackPanel>
									<StackPanel Margin="5" Spacing="6">
										<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_ctb_icon_type_9f16dbe6}" />
										<ComboBox MinWidth="280"
										          ItemsSource="{Binding CtbIconOptions}"
										          SelectedItem="{Binding SelectedCtbIconOption, Mode=TwoWay}" />
									</StackPanel>
									<WrapPanel>
										<local:Property_Template Margin="5" Property_Label="Capture index (Arena)" Property_Value="{Binding MonsterStatSheet.ArenaId}" BorderWidth="220" ValueBorderWidth="60"/>
										<local:Property_Template Margin="5" Property_Label="Doom turns" Property_Value="{Binding MonsterStatSheet.DoomCount}" BorderWidth="220" ValueBorderWidth="60"/>
									</WrapPanel>
									<local:GameIndex_Template Margin="5" GameIndex_Label="Berserk / forced action" CategOptions="{Binding CategoryOptions}" GameIndex_Object="{Binding MonsterStatSheet.ForcedAbility}"/>
								</StackPanel>
							</Expander>
						</StackPanel>
					</ScrollViewer>

					<Border Grid.Column="1" Classes="card" Margin="8,0,0,0" Padding="2" ClipToBounds="True">
						<Grid RowDefinitions="Auto,*">
							<TextBlock Grid.Row="0" Margin="8" Classes="muted" Text="{Binding ModelPreviewStatus}" TextWrapping="Wrap" />
							<views:WebView2Host x:Name="ModelPreviewHost" Grid.Row="1" MinHeight="280"
							                    IsVisible="{Binding !IsExternalModelPreview}" />
							<Border Grid.Row="1" Classes="cardSoft" Padding="16" Margin="8"
							        IsVisible="{Binding IsExternalModelPreview}">
								<StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
									<TextBlock Classes="sectionLabel" HorizontalAlignment="Center"
									           Text="{x:Static res:Strings.U_Vh_ExternalViewerTitle}" />
									<TextBlock Classes="muted" TextWrapping="Wrap" MaxWidth="420"
									           Text="{x:Static res:Strings.U_Vh_ExternalViewerManualMessage}" />
									<Button Classes="primaryAction" HorizontalAlignment="Center"
									        Click="Button_OpenModelPreviewBrowser"
									        Content="{x:Static res:Strings.U_Vh_OpenInBrowser}" />
								</StackPanel>
							</Border>
						</Grid>
					</Border>
				</Grid>
			</TabItem>

