<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:rsp="clr-namespace:FFXProjectEditor.Styles"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="760"
             rsp:Responsive.Breakpoints="True"
             x:Class="FFXProjectEditor.MonEditorSelector_Control">

	<!-- Jarvis-UI Fase E §E8: hand-rolled Expander manual → ModuleMasterDetail_Shell.
	     O detail swap (ContentControl Name="ContentFrame" trocado via code-behind) vira o slot Detail. -->

	<UserControl.Styles>
		<Style Selector="UserControl.narrow common|ModuleMasterDetail_Shell">
			<Setter Property="IsMasterExpanded" Value="False" />
		</Style>
	</UserControl.Styles>

	<common:ModuleMasterDetail_Shell MasterHeaderLabel="Monsters"
	                                 IsMasterExpanded="{Binding IsMonsterListExpanded, Mode=TwoWay}">

		<common:ModuleMasterDetail_Shell.MasterHeader>
			<StackPanel Spacing="4" Margin="2,0,2,2">
				<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_monster_library_d44cd751}" />
				<TextBlock Classes="muted" FontSize="11" Text="{Binding SelectorModeSummary}" TextWrapping="Wrap" />
			</StackPanel>
		</common:ModuleMasterDetail_Shell.MasterHeader>

		<common:ModuleMasterDetail_Shell.MasterList>
			<Grid RowDefinitions="Auto,*">
				<StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
					<TextBox Watermark="{x:Static res:Strings.U_filter_by_monster_name_or_index_9396448b}"
					         Text="{Binding FilterText}"
					         TextChanged="Filter_Changed" />
				</StackPanel>

				<ListBox Grid.Row="1"
				         Name="MonsterList"
				         MinHeight="0"
				         VerticalAlignment="Stretch"
				         ItemsSource="{Binding DisplayedMonsters}"
				         SelectionMode="Multiple"
				         SelectedItems="{Binding BatchSelectedTargets, Mode=TwoWay}"
				         SelectionChanged="ListBox_SelectionChanged">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,6" Padding="12,10" Classes="cardSoft" CornerRadius="6">
								<Grid ColumnDefinitions="*">
									<StackPanel Spacing="2">
										<TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
										<TextBlock Classes="sectionLabel" FontSize="10" Text="{Binding Index, StringFormat='Id: {0}'}" />
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</common:ModuleMasterDetail_Shell.MasterList>

		<!-- Detail: swap via code-behind (ContentControl Name="ContentFrame") — mantido igual ao original. -->
		<common:ModuleMasterDetail_Shell.Detail>
			<ContentControl Margin="10"
			                MinHeight="0"
			                VerticalAlignment="Stretch"
			                Name="ContentFrame"
			                Background="{DynamicResource AppSurfaceBrush}"
			                IsVisible="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static ObjectConverters.IsNotNull}}" />
		</common:ModuleMasterDetail_Shell.Detail>

	</common:ModuleMasterDetail_Shell>
</UserControl>
