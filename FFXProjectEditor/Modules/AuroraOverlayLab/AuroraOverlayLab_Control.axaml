<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1420"
             d:DesignHeight="780"
             x:Class="FFXProjectEditor.AuroraOverlayLab_Control">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" MinWidth="240" MaxWidth="360" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>
		<ScrollViewer Grid.Column="0" Margin="18,18,0,18" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="14">
				<Border Classes="card" Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_runtime_productization_ecb1bf6f}" />
						<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_aurora_overlay_lab_5f66cde3}" />
						<TextBlock Classes="muted"
						           Text="{x:Static res:Strings.U_painel_persistente_para_ligar_desligar_o_overlay_54003e8b}"
						           TextWrapping="Wrap" />
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
							<TextBlock Text="{x:Static res:Strings.CommonFfxExe}" VerticalAlignment="Center" />
							<CheckBox Grid.Column="1" Classes="statusCheck" IsChecked="{Binding GameOpen}" />
							<TextBlock Grid.Row="1" Text="ffx-hooks.dll" VerticalAlignment="Center" />
							<CheckBox Grid.Row="1" Grid.Column="1" Classes="statusCheck" IsChecked="{Binding DllDeployed}" />
							<TextBlock Grid.Row="2" Text="%TEMP%/ffx-hooks.log" VerticalAlignment="Center" />
							<CheckBox Grid.Row="2" Grid.Column="1" Classes="statusCheck" IsChecked="{Binding TempLogPresent}" />
						</Grid>
						<TextBlock Classes="muted" Text="{Binding RuntimeSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Classes="card" Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonTarget}" />
						<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.CommonGameDirectory}" />
						<TextBox Text="{Binding GameRoot, Mode=TwoWay}" Watermark="{x:Static res:Strings.U_pasta_que_contem_ffx_exe_e_modules_87e3724d}" />
						<WrapPanel Orientation="Horizontal" ItemHeight="40">
							<Button Classes="secondaryAction" Click="Button_DetectGameRoot">Detect</Button>
							<Button Classes="secondaryAction" Margin="10,0,0,0" Click="Button_LoadConfig">Load ini</Button>
							<Button Classes="secondaryAction" Margin="10,0,0,0" Click="Button_OpenConfigFolder">Open folder</Button>
							<Button Classes="secondaryAction" Margin="10,0,0,0" Click="Button_OpenLog">Open log</Button>
							<Button Classes="secondaryAction" Margin="10,0,0,0" Click="Button_LaunchGame">Launch via Steam</Button>
						</WrapPanel>
						<TextBlock Classes="muted" Text="{Binding FileSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Classes="card" Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_config_files_d282aaad}" />
						<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
							<TextBlock Text="aurora_overlay.ini" VerticalAlignment="Center" />
							<CheckBox Grid.Column="1" Classes="statusCheck" IsChecked="{Binding ConfigExists}" />
							<TextBlock Grid.Row="1" Text="{x:Static res:Strings.U_aurora_overlay_flag_8b98dd3f}" VerticalAlignment="Center" />
							<CheckBox Grid.Row="1" Grid.Column="1" Classes="statusCheck" IsChecked="{Binding OverlayFlagPresent}" />
							<TextBlock Grid.Row="2" Text="{x:Static res:Strings.U_aurora_overlay_d3d11_flag_71c78069}" VerticalAlignment="Center" />
							<CheckBox Grid.Row="2" Grid.Column="1" Classes="statusCheck" IsChecked="{Binding D3dFlagPresent}" />
							<TextBlock Grid.Row="3" Text="{x:Static res:Strings.U_aurora_w2s_sniff_flag_2ec866a1}" VerticalAlignment="Center" />
							<CheckBox Grid.Row="3" Grid.Column="1" Classes="statusCheck" IsChecked="{Binding SniffFlagPresent}" />
						</Grid>
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>

		<ScrollViewer Grid.Column="1" Margin="18" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="14">
				<Border Padding="{DynamicResource SpacingXl}" Classes="card heroGradient">
					<StackPanel Spacing="8">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_aurora_runtime_overlay_3e2b11c8}" />
						<TextBlock FontSize="28" FontWeight="Bold" Text="{x:Static res:Strings.U_actors_on_the_screen_controlled_from_the_editor_e68de8e9}" />
						<TextBlock Classes="muted" Text="{Binding StatusSummary}" TextWrapping="Wrap" />
						<TextBlock Classes="muted" Text="{Binding LastWrittenSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Classes="card" Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_mode_a7b93d21}" />
						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto">
							<CheckBox IsChecked="{Binding OverlayEnabled, Mode=TwoWay}">Enable Aurora overlay</CheckBox>
							<CheckBox Grid.Column="1" IsChecked="{Binding D3d11Overlay, Mode=TwoWay}">D3D11 in-frame texture</CheckBox>
							<CheckBox Grid.Row="1" IsChecked="{Binding DetailLabels, Mode=TwoWay}">Detail labels</CheckBox>
							<CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding W2sScan, Mode=TwoWay}">Incremental W2S scan</CheckBox>
							<CheckBox Grid.Row="2" IsChecked="{Binding D3dSniffW2S, Mode=TwoWay}">D3D W2S sniff</CheckBox>
							<CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding D3dSniffLightAfterW2S, Mode=TwoWay}">Light sniff after W2S</CheckBox>
							<CheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="{Binding D3dSniffProjectWithW2S, Mode=TwoWay}">Keep projection sniff after W2S is fixed</CheckBox>
						</Grid>
					</StackPanel>
				</Border>

				<Border Classes="card" Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_w2s_scanner_d37e66f2}" />
						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
							<StackPanel Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_manual_w2s_addr_f04065e8}" />
								<TextBox Text="{Binding W2sAddress, Mode=TwoWay}" FontFamily="Cascadia Mono,Consolas,Monospace" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_scan_start_afdeae37}" />
								<TextBox Text="{Binding W2sScanStart, Mode=TwoWay}" FontFamily="Cascadia Mono,Consolas,Monospace" />
							</StackPanel>
							<StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_budget_ms_5dc6c2a2}" />
								<TextBox Text="{Binding W2sScanBudgetMs, Mode=TwoWay}" />
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,0" Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_cooldown_ms_1d38e34e}" />
								<TextBox Text="{Binding W2sScanCooldownMs, Mode=TwoWay}" />
							</StackPanel>
							<StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_min_roots_c87809b9}" />
								<TextBox Text="{Binding W2sScanMinRoots, Mode=TwoWay}" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<Border Classes="card" Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_d3d11_texture_overlay_5dad8ea9}" />
						<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
							<StackPanel Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_texture_update_ms_2bb0bf69}" />
								<TextBox Text="{Binding D3dUpdateMs, Mode=TwoWay}" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_matrix_max_age_ms_87d964d0}" />
								<TextBox Text="{Binding D3dSniffMatrixMaxAgeMs, Mode=TwoWay}" />
							</StackPanel>
							<StackPanel Grid.Row="1" Margin="0,10,0,0" Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_project_refresh_ms_d26cae23}" />
								<TextBox Text="{Binding D3dSniffProjectRefreshMs, Mode=TwoWay}" />
							</StackPanel>
							<StackPanel Grid.Row="1" Grid.Column="1" Margin="10,10,0,0" Spacing="4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_auto_pause_hits_0703fb1a}" />
								<TextBox Text="{Binding D3dSniffAutoPauseHits, Mode=TwoWay}" />
							</StackPanel>
							<TextBlock Grid.Row="2"
							           Grid.ColumnSpan="2"
							           Margin="0,10,0,0"
							           Classes="muted"
							           Text="{x:Static res:Strings.U_defaults_seguros_d3d11_ligado_sniff_ligado_ate_a_a8448c74}"
							           TextWrapping="Wrap" />
						</Grid>
					</StackPanel>
				</Border>

				<Border Classes="card" Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="10">
						<WrapPanel Orientation="Horizontal" ItemHeight="40">
						<Button Classes="primaryAction" Click="Button_ApplyConfig">Apply config</Button>
						<Button Margin="10,0,0,0" Classes="secondaryAction" Click="Button_DisableOverlay">Disable overlay</Button>
						<Button Margin="10,0,0,0" Classes="secondaryAction" Click="Button_Refresh">Refresh status</Button>
						</WrapPanel>
						<TextBlock Classes="muted" Text="{Binding ConfigPath}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
