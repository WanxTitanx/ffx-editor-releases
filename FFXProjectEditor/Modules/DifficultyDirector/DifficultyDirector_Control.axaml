<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="820"
             x:Class="FFXProjectEditor.DifficultyDirector_Control">

	<ScrollViewer Margin="18" HorizontalScrollBarVisibility="Disabled">
		<StackPanel Spacing="14">
			<Border Padding="18" Classes="card">
				<Grid ColumnDefinitions="*,Auto,Auto">
					<StackPanel Spacing="6">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_difficulty_director_v2_c6610437}" />
						<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_monstros_encounter_danger_e06cc087}" />
						<TextBlock Classes="muted"
						           Text="{x:Static res:Strings.U_modifica_os_m_bin_e_opcionalmente_o_danger_do_bt_9084b0fe}"
						           TextWrapping="Wrap" />
					</StackPanel>
					<Border Grid.Column="1" Classes="cardSoft" Padding="12,8" Margin="12,0,0,0" VerticalAlignment="Top">
						<StackPanel Spacing="4">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_monstros_e229aec1}" />
							<TextBlock Text="{Binding MonsterCountLabel}" />
						</StackPanel>
					</Border>
					<Border Grid.Column="2" Classes="cardSoft" Padding="12,8" Margin="12,0,0,0" VerticalAlignment="Top">
						<StackPanel Spacing="4">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_encountertable_e6056924}" />
							<TextBlock Text="{Binding EncounterCountLabel}" />
						</StackPanel>
					</Border>
				</Grid>
			</Border>

			<Border Padding="{DynamicResource SpacingLg}" Classes="card">
				<StackPanel Spacing="12">
					<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
						<TextBlock Classes="muted" Text="{x:Static res:Strings.U_preset_bca78876}" VerticalAlignment="Center" Margin="0,0,12,0" />
						<Button Grid.Column="1" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_PresetEasy">Fácil</Button>
						<Button Grid.Column="2" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_PresetNormal">Normal</Button>
						<Button Grid.Column="3" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_PresetHard">Difícil</Button>
						<Button Grid.Column="4" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_PresetDarkAeon">Dark Aeon</Button>
						<Button Grid.Column="5" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_PresetExplorer">Exploração</Button>
						<Button Grid.Column="6" Classes="secondaryAction" Click="Button_PresetHunter">Caçador</Button>
					</Grid>

					<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" MinWidth="120" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" MinWidth="72" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="{x:Static res:Strings.U_hp_scale_41c60ab4}" VerticalAlignment="Center" />
						<Slider Grid.Column="1" Minimum="25" Maximum="500" TickFrequency="5" Value="{Binding HpScale, Mode=TwoWay}" />
						<TextBlock Grid.Column="2" Text="{Binding HpScale, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />

						<TextBlock Grid.Row="1" Text="{x:Static res:Strings.U_mp_scale_cabee312}" VerticalAlignment="Center" Margin="0,8,0,0" />
						<Slider Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Minimum="25" Maximum="500" TickFrequency="5" Value="{Binding MpScale, Mode=TwoWay}" />
						<TextBlock Grid.Row="1" Grid.Column="2" Margin="0,8,0,0" Text="{Binding MpScale, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />

						<TextBlock Grid.Row="2" Text="{x:Static res:Strings.U_forca_scale_a25f9028}" VerticalAlignment="Center" Margin="0,8,0,0" />
						<Slider Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Minimum="25" Maximum="500" TickFrequency="5" Value="{Binding StrengthScale, Mode=TwoWay}" />
						<TextBlock Grid.Row="2" Grid.Column="2" Margin="0,8,0,0" Text="{Binding StrengthScale, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />

						<TextBlock Grid.Row="3" Text="{x:Static res:Strings.U_magia_scale_a141c4f3}" VerticalAlignment="Center" Margin="0,8,0,0" />
						<Slider Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Minimum="25" Maximum="500" TickFrequency="5" Value="{Binding MagicScale, Mode=TwoWay}" />
						<TextBlock Grid.Row="3" Grid.Column="2" Margin="0,8,0,0" Text="{Binding MagicScale, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />

						<TextBlock Grid.Row="4" Text="{x:Static res:Strings.U_defesa_scale_fb1a2447}" VerticalAlignment="Center" Margin="0,8,0,0" />
						<Slider Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" Minimum="25" Maximum="500" TickFrequency="5" Value="{Binding DefenseScale, Mode=TwoWay}" />
						<TextBlock Grid.Row="4" Grid.Column="2" Margin="0,8,0,0" Text="{Binding DefenseScale, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />

						<TextBlock Grid.Row="5" Text="{x:Static res:Strings.U_outros_stats_e24d3260}" VerticalAlignment="Center" Margin="0,8,0,0" />
						<Slider Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Minimum="25" Maximum="500" TickFrequency="5" Value="{Binding OtherStatsScale, Mode=TwoWay}" />
						<TextBlock Grid.Row="5" Grid.Column="2" Margin="0,8,0,0" Text="{Binding OtherStatsScale, StringFormat='{}{0:0}%'}" HorizontalAlignment="Right" VerticalAlignment="Center" />

						<TextBlock Grid.Row="6" Text="{x:Static res:Strings.U_encounter_danger_e75a4181}" VerticalAlignment="Center" Margin="0,8,0,0" />
						<Slider Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Minimum="0" Maximum="255" TickFrequency="5" Value="{Binding DangerScale, Mode=TwoWay}" />
						<TextBlock Grid.Row="6" Grid.Column="2" Margin="0,8,0,0" Text="{Binding DangerScale, StringFormat='{}{0:0}'}" HorizontalAlignment="Right" VerticalAlignment="Center" />

						<CheckBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0"
						          Content="{x:Static res:Strings.U_aplicar_encounter_danger_junto_com_os_monstros_8fe9e9d4}"
						          IsChecked="{Binding ApplyDangerWithPreset, Mode=TwoWay}" />
					</Grid>
				</StackPanel>
			</Border>

			<Border Padding="{DynamicResource SpacingLg}" Classes="card">
				<StackPanel Spacing="10">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_challenge_modes_offline_2cf0d401}" />
					<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto">
						<Button Grid.Column="0" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_ChallengeTrueNightmare">True Nightmare</Button>
						<Button Grid.Column="1" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_ChallengeSpeedRun">Speed Run Assist</Button>
						<Button Grid.Column="2" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_ChallengeExplorer">Explorer</Button>
						<Button Grid.Column="3" Classes="secondaryAction" Margin="0,0,8,0" Click="Button_ChallengeHunter">Hunter</Button>
						<Button Grid.Column="4" Classes="secondaryAction" Click="Button_ChallengeEqualizer">Equalizer</Button>
					</Grid>
					<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ChallengeModeSummary}" />
				</StackPanel>
			</Border>

			<Border Padding="{DynamicResource SpacingLg}" Classes="card">
				<StackPanel Spacing="12">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_preview_impactos_principais_70749ba0}" VerticalAlignment="Center" />
						<Button Grid.Column="1" Classes="secondaryAction" Click="Button_RefreshPreview">Preview</Button>
						<Button Grid.Column="2" Margin="8,0,0,0" Classes="primaryAction" Click="Button_ApplyAll">Aplicar a todos</Button>
						<Button Grid.Column="3" Margin="8,0,0,0" Classes="secondaryAction" Click="Button_RestoreBackups">Restaurar backups</Button>
					</Grid>
					<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding StatusMessage}" />

					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_monstros_5_mais_afetados_por_hp_cdef72e3}" />
					<Grid ColumnDefinitions="*,150,130,110,110">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_monstro_3b4927a1}" />
						<TextBlock Grid.Column="1" Classes="sectionLabel" Text="HP" />
						<TextBlock Grid.Column="2" Classes="sectionLabel" Text="MP" />
						<TextBlock Grid.Column="3" Classes="sectionLabel" Text="{x:Static res:Strings.CommonStrength}" />
						<TextBlock Grid.Column="4" Classes="sectionLabel" Text="{x:Static res:Strings.CommonDefense}" />
					</Grid>
					<ItemsControl ItemsSource="{Binding PreviewRows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Padding="10,8" Margin="0,0,0,6" Classes="cardSoft">
									<Grid ColumnDefinitions="*,150,130,110,110">
										<TextBlock Text="{Binding MonsterLabel}" TextWrapping="Wrap" />
										<TextBlock Grid.Column="1" Text="{Binding HpLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" />
										<TextBlock Grid.Column="2" Text="{Binding MpLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" />
										<TextBlock Grid.Column="3" Text="{Binding StrengthLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" />
										<TextBlock Grid.Column="4" Text="{Binding DefenseLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_encounter_danger_5_grupos_mais_afetados_d22a76fc}" Margin="0,8,0,0" />
					<Grid ColumnDefinitions="*,130,110">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_tabela_grupo_67af6af3}" />
						<TextBlock Grid.Column="1" Classes="sectionLabel" Text="{x:Static res:Strings.CommonDanger}" />
						<TextBlock Grid.Column="2" Classes="sectionLabel" Text="{x:Static res:Strings.U_delta_a4cbd21f}" />
					</Grid>
					<ItemsControl ItemsSource="{Binding DangerPreviewRows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Padding="10,8" Margin="0,0,0,6" Classes="cardSoft">
									<Grid ColumnDefinitions="*,130,110">
										<TextBlock Text="{Binding EncounterLabel}" TextWrapping="Wrap" />
										<TextBlock Grid.Column="1" Text="{Binding DangerLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" />
										<TextBlock Grid.Column="2" Text="{Binding DeltaLabel}" FontFamily="Cascadia Mono,Consolas,Monospace" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
