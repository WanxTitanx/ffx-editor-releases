<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:rsp="clr-namespace:FFXProjectEditor.Styles"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1420"
             d:DesignHeight="780"
             rsp:Responsive.Breakpoints="True"
             x:Class="FFXProjectEditor.FormationEditor_Control">

	<!-- Jarvis-UI Fase E §E3: hand-rolled Auto,* grid → ModuleMasterDetail_Shell.
	     Formation tem um field-context card extra (espinha compartilhada do Hub) → vira MasterHeader. -->

	<UserControl.Styles>
		<Style Selector="UserControl.narrow common|ModuleMasterDetail_Shell">
			<Setter Property="IsMasterExpanded" Value="False" />
		</Style>
	</UserControl.Styles>

	<common:ModuleMasterDetail_Shell MasterHeaderLabel="Formation">

		<!-- ===== MASTER: field-context card (espinha do Hub) + header + filter + ListBox ===== -->
		<common:ModuleMasterDetail_Shell.MasterHeader>
			<StackPanel Spacing="6" Margin="2,0,2,2">
				<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_spira_forge_v0_2_94facbdf}" />
				<TextBlock Classes="muted" FontSize="11" Text="{Binding HonestyBanner}" TextWrapping="Wrap" />
				<Border Margin="0,4,0,0" Padding="10" Classes="cardSoft">
					<StackPanel Spacing="6">
						<TextBlock Classes="sectionLabel" FontSize="11" Text="{x:Static res:Strings.U_fieldcontext_espinha_compartilhada_c4acebbf}" />
						<TextBlock Classes="muted" FontSize="11" Text="{Binding FieldContextSummary}" TextWrapping="Wrap" />
						<Button HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_SyncField" AutomationProperties.Name="Sincronizar com field do Hub">Sincronizar com field do Hub</Button>
					</StackPanel>
				</Border>
			</StackPanel>
		</common:ModuleMasterDetail_Shell.MasterHeader>

		<common:ModuleMasterDetail_Shell.MasterList>
			<Grid RowDefinitions="Auto,Auto,*">
				<StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Classes="secondaryAction" Click="Button_Refresh" AutomationProperties.Name="Refresh">Refresh</Button>
					</StackPanel>
					<TextBlock Classes="muted" FontSize="11" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
				</StackPanel>

				<TextBox Grid.Row="1"
				         Margin="0,0,0,8"
				         Watermark="{x:Static res:Strings.U_filtrar_battles_por_id_area_ex_azit_29ad745d}"
				         Text="{Binding FilterText, Mode=TwoWay}" />

				<ListBox Grid.Row="2"
				         ItemsSource="{Binding Battles}"
				         SelectedItem="{Binding SelectedBattle, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,6" Padding="10" Classes="cardSoft">
								<StackPanel Spacing="2">
									<TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
									<TextBlock Classes="muted" FontSize="11" Text="{Binding FormationLabel}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</common:ModuleMasterDetail_Shell.MasterList>

		<!-- ===== DETAIL: hero + 8 slots + save ===== -->
		<common:ModuleMasterDetail_Shell.Detail>
			<ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="14" Margin="10,10,10,10">
					<Border Padding="{DynamicResource SpacingXl}" Classes="card heroGreen">
						<StackPanel Spacing="8">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_battle_selecionado_ecbd6175}" />
							<TextBlock FontSize="26" FontWeight="Bold" Text="{Binding BattleHeader}" />
							<TextBlock Classes="muted" Text="{Binding FormationSummary}" TextWrapping="Wrap" />
							<TextBlock Classes="muted" Text="{Binding SlotRegionSummary}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Border Padding="{DynamicResource SpacingLg}" Classes="card">
						<StackPanel Spacing="10">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_8_monstros_da_formacao_slot_only_59d7fd1c}" />
							<ItemsControl ItemsSource="{Binding Slots}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,0,0,8" Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
											<Grid ColumnDefinitions="80,*,120">
												<StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
													<TextBlock Classes="sectionLabel" Text="{Binding SlotLabel}" />
													<TextBlock Classes="muted" FontSize="11" Text="{Binding OriginalHex}" />
												</StackPanel>
												<ComboBox Grid.Column="1" Margin="8,0" HorizontalAlignment="Stretch" MaxDropDownHeight="320"
												          ItemsSource="{Binding DataContext.MonsterOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
												          SelectedItem="{Binding SelectedMonster, Mode=TwoWay}">
													<ComboBox.ItemTemplate>
														<DataTemplate>
															<TextBlock Text="{Binding Label}" />
														</DataTemplate>
													</ComboBox.ItemTemplate>
												</ComboBox>
												<StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
													<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_raw_ce15802a}" HorizontalAlignment="Right" />
													<TextBlock FontWeight="SemiBold" Text="{Binding RawHex}" HorizontalAlignment="Right" />
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Border Padding="{DynamicResource SpacingLg}" Classes="card">
						<StackPanel Spacing="10">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_save_byte_safe_loose_file_backup_227ff783}" />
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Classes="primaryAction" Click="Button_Save" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Save">Save</Button>
								<Button Classes="secondaryAction" Click="Button_Undo" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Undo">Undo</Button>
								<Button Classes="secondaryAction" Click="Button_Discard" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="Discard">Discard</Button>
							</StackPanel>
							<TextBlock Classes="muted" Text="{Binding EditActionSummary}" TextWrapping="Wrap" />
							<TextBlock Classes="muted" Text="{Binding EditSession.SessionSummary}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</common:ModuleMasterDetail_Shell.Detail>

	</common:ModuleMasterDetail_Shell>
</UserControl>
