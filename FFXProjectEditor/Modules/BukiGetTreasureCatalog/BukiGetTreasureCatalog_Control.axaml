<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:rsp="clr-namespace:FFXProjectEditor.Styles"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1300"
             d:DesignHeight="860"
             rsp:Responsive.Breakpoints="True"
             x:Class="FFXProjectEditor.Modules.BukiGetRewards.BukiGetTreasureCatalog_Control">

    <!-- Jarvis-UI Fase E §E7: hand-rolled Auto,* grid → ModuleMasterDetail_Shell. Root Margin="18" removido (shell não tem). -->

    <UserControl.Styles>
        <StyleInclude Source="avares://FFXProjectEditor/Styles/EditorForms.axaml" />
        <Style Selector=":is(UserControl).narrow common|ModuleMasterDetail_Shell">
            <Setter Property="IsMasterExpanded" Value="False" />
        </Style>

		</UserControl.Styles>

    <common:ModuleMasterDetail_Shell MasterHeaderLabel="Gear Rewards (Writer)">

        <common:ModuleMasterDetail_Shell.MasterHeader>
            <StackPanel Spacing="4" Margin="2,0,2,2">
                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_treasure_rewards_d1d9dff3}" />
                <TextBlock Classes="muted" FontSize="11" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" FontSize="11" Text="{Binding SourcePath}" TextWrapping="Wrap" />
            </StackPanel>
        </common:ModuleMasterDetail_Shell.MasterHeader>

        <common:ModuleMasterDetail_Shell.MasterList>
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
                    <Button Classes="secondaryAction" HorizontalAlignment="Left" Click="Button_Refresh" Content="{x:Static res:Strings.U_re_scan_b0ba4a7b}" />
                    <TextBox Watermark="{x:Static res:Strings.U_filter_by_row_owner_ability_takara_ref_or_raw_wo_124b260d}"
                             Text="{Binding FilterText, Mode=TwoWay}" />
                    <TextBlock Classes="sectionLabel" FontSize="11" Text="{Binding FilterSummary}" TextWrapping="Wrap" />
                    <Border Padding="{DynamicResource SpacingSm}" Classes="cardSoft">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding ReferenceSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding ParserEvidenceSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding DisplayedRows}"
                             SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <TextBlock Classes="sectionLabel" FontSize="11" Text="{Binding ReferenceBadge}" TextWrapping="Wrap" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </common:ModuleMasterDetail_Shell.MasterList>

        <common:ModuleMasterDetail_Shell.Detail>
            <DockPanel>
                <Border IsVisible="{Binding EditSession, Converter={x:Static ObjectConverters.IsNotNull}}" DockPanel.Dock="Top" Margin="0,0,0,10" Padding="16,12" Classes="cardSoft">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding EditSession.SessionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding EditActionSummary}" Classes="muted" TextWrapping="Wrap" />
                            </StackPanel>
<WrapPanel>

                            <CheckBox Classes="flag" Margin="0,0,12,6" VerticalAlignment="Center" IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
                            <Button Margin="0,0,12,6" VerticalAlignment="Center" Classes="secondaryAction" IsEnabled="{Binding EditSession.CanUndo}" Click="Button_Undo" AutomationProperties.Name="Undo">Undo</Button>
                            <Button Margin="0,0,12,6" VerticalAlignment="Center" Classes="dangerAction" IsEnabled="{Binding EditSession.DiffersFromOriginal}" Click="Button_Discard" AutomationProperties.Name="Restore Original">Restore</Button>
                            <Button Margin="0,0,12,6" VerticalAlignment="Center" IsEnabled="{Binding EditSession.HasPendingChanges}" Click="Button_Save" AutomationProperties.Name="Save" Content="{x:Static res:Strings.CommonSave}" />
                        </WrapPanel>
</StackPanel>
                    </StackPanel>
                </Border>

                <Grid>
<Border Padding="24" Classes="card" VerticalAlignment="Top" IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNull}}"><StackPanel Spacing="12"><TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_Gear_NoSelection}" /><TextBlock Text="{Binding LoadSummary}" TextWrapping="Wrap" /><TextBlock Text="{x:Static res:Strings.U_Gear_Recovery}" TextWrapping="Wrap" /><Button HorizontalAlignment="Left" Click="Button_Refresh" Content="{x:Static res:Strings.U_re_scan_b0ba4a7b}" /></StackPanel></Border>
<ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Classes="editorContent" Spacing="14" Margin="10,10,10,10" IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">

                    <Border Padding="{DynamicResource SpacingLg}" Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_gear_editor_4d5459bd}" />
                            <TextBlock Classes="muted" Text="{x:Static res:Strings.U_Gear_EditHint}" TextWrapping="Wrap" />
                        <UniformGrid Classes="editorFields">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonOwner}" />
                                <ComboBox Classes="formChoice" ItemsSource="{Binding OwnerLabels}" SelectedIndex="{Binding EditOwner, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonType}" />
                                <ComboBox Classes="formChoice" ItemsSource="{Binding GearTypeLabels}" SelectedIndex="{Binding EditGearType, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonSlots}" />
                                <NumericUpDown Value="{Binding EditSlotCount}" Minimum="0" Maximum="4" MinWidth="120" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonFormula}" />
                                <NumericUpDown Value="{Binding EditDamageFormula}" Minimum="0" Maximum="255" MinWidth="120" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonPower}" />
                                <NumericUpDown Value="{Binding EditPower}" Minimum="0" Maximum="255" MinWidth="120" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_crit_bonus_8b24f5b6}" />
                                <NumericUpDown Value="{Binding EditCritBonus}" Minimum="0" Maximum="255" MinWidth="120" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonFlags}" />
                                <TextBox Text="{Binding EditFlags, Mode=TwoWay}" MinWidth="120" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Spacing="2">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonUnk03}" />
                                <TextBox Text="{Binding EditUnknown03, Mode=TwoWay}" MinWidth="120" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            </UniformGrid>
<StackPanel Spacing="4">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_auto_abilities_s1_s4_e27414b8}" />
                                <UniformGrid Classes="editorFields">
                                    <StackPanel Spacing="4"><TextBlock Text="{x:Static res:Strings.U_s1_hex_70e948e2}" /><TextBox Text="{Binding EditAbilityWord0, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.U_s1_hex_70e948e2}" /></StackPanel>
                                    <StackPanel Spacing="4"><TextBlock Text="{x:Static res:Strings.U_s2_hex_f2cde9b8}" /><TextBox Text="{Binding EditAbilityWord1, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.U_s2_hex_f2cde9b8}" /></StackPanel>
                                    <StackPanel Spacing="4"><TextBlock Text="{x:Static res:Strings.U_s3_hex_fada26f0}" /><TextBox Text="{Binding EditAbilityWord2, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.U_s3_hex_fada26f0}" /></StackPanel>
                                    <StackPanel Spacing="4"><TextBlock Text="{x:Static res:Strings.U_s4_hex_7715b53f}" /><TextBox Text="{Binding EditAbilityWord3, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.U_s4_hex_7715b53f}" /></StackPanel>
                                </UniformGrid>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <Border Padding="{DynamicResource SpacingLg}" Classes="card">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_selected_payload_1d40e8e6}" />
                                    <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding SelectedRow.Title}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding SelectedRow.Summary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Margin="18,0,0,0" Padding="12,8" Classes="cardSoft" VerticalAlignment="Top">
                                    <TextBlock Classes="sectionLabel" Text="{Binding SelectedRow.ReferenceBadge}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <UniformGrid Classes="editorFields">
                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonOwner}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.OwnerLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonType}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.GearTypeLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonSlots}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.SlotsLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_crit_c1dfe39c}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.CritLabel}" />
                                    </StackPanel>
                                </Border>

                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonFlags}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.FlagsLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonFormula}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.FormulaLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonPower}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.PowerLabel}" />
                                    </StackPanel>
                                </Border>
                                <Border Padding="10" Classes="cardSoft">
                                    <StackPanel Spacing="3">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonUnk03}" />
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedRow.Unknown03Label}" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Padding="{DynamicResource SpacingLg}" Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonAutoAbilities}" />
                            <TextBlock Classes="cardTitle" Text="{Binding SelectedRow.AbilitySummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding SelectedRow.AbilityWordsLabel}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Padding="{DynamicResource SpacingLg}" Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_takara_bridge_47b73bb5}" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedRow.TakaraReferencesLabel}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{x:Static res:Strings.U_direct_evidence_only_takara_kind_0x05_uses_type__34095207}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Padding="{DynamicResource SpacingLg}" Classes="card">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_parser_evidence_2926b400}" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SelectedRow.ParserEvidenceLabel}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding SelectedRow.ParserEvidencePrimarySummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontFamily="Cascadia Mono,Consolas,Monospace" Text="{Binding SelectedRow.ParserEvidenceDetails}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{x:Static res:Strings.U_parser_backed_context_only_eventscriptoutput_txt_6b1294e8}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Padding="{DynamicResource SpacingLg}" Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_raw_entry_f61876e9}" />
                            <TextBlock Text="{Binding SelectedRow.FieldSummary}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" FontFamily="Cascadia Mono,Consolas,Monospace" Text="{Binding SelectedRow.RawWordsLabel}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding SelectedRow.DetailSummary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
</Grid>
            </DockPanel>
        </common:ModuleMasterDetail_Shell.Detail>

    </common:ModuleMasterDetail_Shell>
</UserControl>
