<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:FFXProjectEditor"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1260"
             d:DesignHeight="760"
             x:Class="FFXProjectEditor.BlitzballRecruitEditor_Control">

	<UserControl.Styles>
		<Style Selector="UserControl.narrow common|ModuleMasterDetail_Shell">
			<Setter Property="IsMasterExpanded" Value="False" />
		</Style>
	</UserControl.Styles>

	<common:ModuleMasterDetail_Shell MasterHeaderLabel="Blitzball Recruitment">
		<common:ModuleMasterDetail_Shell.MasterHeader>
			<StackPanel Spacing="8">
				<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_blitzball_recruitment_be4391d9}" />
				<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_recruitment_spots_f2375af4}" />
				<TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.U_each_field_event_location_recruits_specific_play_4493c7d8}" />
				<TextBlock Classes="muted" Margin="0,6,0,8" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
			</StackPanel>
		</common:ModuleMasterDetail_Shell.MasterHeader>
		<common:ModuleMasterDetail_Shell.MasterList>
			<Grid>
				<ListBox
						 ItemsSource="{Binding Events}"
						 SelectedItem="{Binding SelectedEvent, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,4" Padding="8,6" Background="Transparent" CornerRadius="6">
								<StackPanel Spacing="2">
									<TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Header}" />
									<TextBlock Classes="muted" FontSize="11" Text="{Binding StatusLabel}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</common:ModuleMasterDetail_Shell.MasterList>

		<common:ModuleMasterDetail_Shell.Detail>
			<ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled"
			              Background="{DynamicResource AppSurfaceBrush}"
			              IsVisible="{Binding SelectedEvent, Converter={x:Static ObjectConverters.IsNotNull}}">
				<StackPanel Spacing="14" Margin="10,10,10,10">
				<Border Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="6">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_recruitment_authoring_db91a95f}" />
						<TextBlock FontSize="22" FontWeight="Bold" Text="{Binding SelectedEvent.Header}" />
						<TextBlock Classes="muted" Text="{Binding ScopeSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Spacing="4">
								<TextBlock Text="{Binding EditSession.SessionSummary}" FontWeight="SemiBold" />
								<TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" TextWrapping="Wrap" />
							</StackPanel>
							<core:AutoSaveIndicator_Control Grid.Column="1"
							                               Margin="12,0,0,0"
							                               VerticalAlignment="Center"
							                               Session="{Binding EditSession}" />
						</Grid>
						<WrapPanel Orientation="Horizontal">
							<CheckBox VerticalAlignment="Center"
									  IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
							<Button Margin="12,0,0,0"
									Classes="secondaryAction"
									IsEnabled="{Binding EditSession.CanUndo}"
									Click="Button_Undo">Undo</Button>
							<Button Margin="12,0,0,0"
									Classes="secondaryAction"
									IsEnabled="{Binding EditSession.DiffersFromOriginal}"
									Click="Button_Discard">Restore Original</Button>
							<Button Margin="12,0,0,0"
									Classes="primaryAction"
									IsEnabled="{Binding EditSession.HasPendingChanges}"
									Click="Button_Save">Save</Button>
							<Button Margin="12,0,0,0" Classes="secondaryAction" Click="Button_Refresh">Refresh</Button>
						</WrapPanel>
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_recruited_players_this_location_3dc27bb5}" />
						<TextBlock Classes="muted" Text="{Binding SelectedEventSummary}" TextWrapping="Wrap" />
						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_pick_a_different_player_to_re_point_this_recruit_99adde8b}" />

						<ItemsControl ItemsSource="{Binding Sites}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Margin="0,0,0,6" Padding="10">
										<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
											<TextBlock Text="{Binding OffsetLabel}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
											<ComboBox Grid.Column="1" Margin="10,0"
													  HorizontalAlignment="Stretch"
													  ItemsSource="{Binding PlayerOptions}"
													  SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}"
													  MaxDropDownHeight="420">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Label}" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
											<TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" FontSize="11" Text="{Binding CurrentLabel}" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_honest_scope_re_points_the_recruited_player_id_o_6867b22c}" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
		</common:ModuleMasterDetail_Shell.Detail>
	</common:ModuleMasterDetail_Shell>
</UserControl>
