<Window RequestedThemeVariant="Dark" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
        d:DesignWidth="980"
        d:DesignHeight="760"
        x:Class="FFXProjectEditor.MonsterAiIndirectDispatchTarget_Window"
        Title="Editor de alvo da rota"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="600">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Modules/MonsterAiEditor/MonsterAiColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>


	<Grid Margin="14" RowDefinitions="Auto,*,Auto">
		<Border Grid.Row="0" Padding="{DynamicResource SpacingLg}" Classes="card">
			<Grid ColumnDefinitions="*,Auto">
				<StackPanel Spacing="4">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_monster_ai_alvo_da_rota_d508c5a9}" />
					<TextBlock Classes="cardTitle" Text="{Binding UnitTitle}" />
					<TextBlock Classes="muted" Text="{Binding HookSummary}" TextWrapping="Wrap" />
					<TextBlock Classes="muted" Text="{Binding ConsumerSummary}" TextWrapping="Wrap" />
				</StackPanel>
				<Button Grid.Column="1"
				        MinWidth="42"
				        Classes="secondaryAction"
				        Click="Button_Close"
				        ToolTip.Tip="{x:Static res:Strings.CommonClose}">X</Button>
			</Grid>
		</Border>

		<Border Grid.Row="1" Margin="0,14,0,0" Padding="{DynamicResource SpacingLg}" Classes="card">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
				<StackPanel Spacing="12">
					<Border Padding="{DynamicResource SpacingMd}"
					        Background="{DynamicResource AccentGoldFillBrush}"
					        BorderBrush="{DynamicResource AccentGoldBorderBrush}"
					        BorderThickness="1"
					        CornerRadius="7"
					        IsVisible="{Binding HasFocusedContext}">
						<StackPanel Spacing="6">
							<TextBlock Classes="sectionLabel"
							           Text="{x:Static res:Strings.CommonFocusFromV2}"
							           Foreground="{DynamicResource AccentGoldForegroundBrush}" />
							<TextBlock Text="{Binding FocusedContextSummary}" TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Border Padding="{DynamicResource SpacingMd}"
					        Background="{DynamicResource AccentCycleFillBrush}"
					        BorderBrush="{DynamicResource AccentCycleBorderBrush}"
					        BorderThickness="1"
					        CornerRadius="7">
						<StackPanel Spacing="6">
							<TextBlock Classes="sectionLabel"
							           Text="{x:Static res:Strings.U_alvo_desta_rota_65665693}"
							           Foreground="{DynamicResource AccentCycleBorderBrush}" />
							<TextBlock TextWrapping="Wrap"
							           Text="{x:Static res:Strings.U_este_popup_abre_so_o_recorte_de_alvo_literal_cop_3d2a1b31}" />
						</StackPanel>
					</Border>

					<ItemsControl ItemsSource="{Binding TargetSlotRows}"
					              IsVisible="{Binding HasTargetSlotRows}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Margin="0,0,0,8"
								        Padding="{DynamicResource SpacingMd}"
								        Background="{DynamicResource AccentShellFillBrush}"
								        BorderBrush="{DynamicResource AccentShellBorderBrush}"
								        BorderThickness="1"
								        CornerRadius="7">
									<StackPanel Spacing="8">
										<Grid ColumnDefinitions="*,Auto,Auto,Auto">
											<StackPanel Spacing="2">
												<TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
												<TextBlock Classes="sectionLabel"
												           Text="{Binding VariableName}"
												           Foreground="{DynamicResource AccentGoldForegroundBrush}" />
											</StackPanel>
											<TextBlock Grid.Column="1"
											           Margin="10,0,0,0"
											           Classes="muted"
											           Text="{Binding SourceKindLabel}" />
											<Border Grid.Column="2"
											        Margin="10,0,0,0"
											        Padding="7,2"
											        Background="{DynamicResource AccentGoldFillBrush}"
											        BorderBrush="{DynamicResource AccentGoldBorderBrush}"
											        BorderThickness="1"
											        CornerRadius="5"
											        IsVisible="{Binding IsFocused}">
												<TextBlock FontSize="11" FontWeight="SemiBold" Text="{x:Static res:Strings.CommonFocus}" />
											</Border>
											<TextBlock Grid.Column="3"
											           Margin="10,0,0,0"
											           Classes="muted"
											           Text="{Binding OffsetHex}" />
										</Grid>
										<TextBlock Text="{Binding CurrentDisplay}" TextWrapping="Wrap" />
										<StackPanel Spacing="4" IsVisible="{Binding CanChangeMode}">
											<TextBlock Classes="sectionLabel"
											           Text="{x:Static res:Strings.CommonSlotMode}"
											           Foreground="{DynamicResource AccentCycleBorderBrush}" />
											<ComboBox HorizontalAlignment="Stretch"
											          ItemsSource="{Binding EditModeOptions}"
											          SelectedItem="{Binding SelectedEditMode, Mode=TwoWay}" />
										</StackPanel>
										<ComboBox HorizontalAlignment="Stretch"
										          MaxDropDownHeight="320"
										          ItemsSource="{Binding TargetOptions}"
										          SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
										          IsVisible="{Binding ShowLiteralEditor}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
										<ComboBox HorizontalAlignment="Stretch"
										          MaxDropDownHeight="320"
										          ItemsSource="{Binding RecipeOptions}"
										          SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
										          IsVisible="{Binding ShowRecipeEditor}" />
										<ComboBox HorizontalAlignment="Stretch"
										          MaxDropDownHeight="320"
										          ItemsSource="{Binding CopyVariableOptions}"
										          SelectedItem="{Binding SelectedCopyVariable, Mode=TwoWay}"
										          IsVisible="{Binding ShowCopyEditor}">
											<ComboBox.ItemTemplate>
												<DataTemplate>
													<TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
												</DataTemplate>
											</ComboBox.ItemTemplate>
										</ComboBox>
										<TextBlock Classes="muted"
										           Text="{Binding DetailSummary}"
										           TextWrapping="Wrap" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Border Padding="{DynamicResource SpacingMd}"
					        Background="{DynamicResource AccentShellFillBrush}"
					        BorderBrush="{DynamicResource AccentRegenForegroundBrush}"
					        BorderThickness="1"
					        CornerRadius="7">
						<StackPanel Spacing="7">
							<TextBlock Classes="sectionLabel"
							           Text="{x:Static res:Strings.CommonPreviewApply}"
							           Foreground="{DynamicResource AccentRegenForegroundBrush}" />
							<TextBox Text="{Binding PreviewSummary}"
							         IsReadOnly="True"
							         AcceptsReturn="True"
							         TextWrapping="Wrap"
							         MinHeight="110"
							         FontFamily="Cascadia Mono,Consolas,Monospace" />
						</StackPanel>
					</Border>

					<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding StatusSummary}" />
				</StackPanel>
			</ScrollViewer>
		</Border>

		<Grid Grid.Row="2" Margin="0,14,0,0" ColumnDefinitions="*,Auto,Auto">
			<TextBlock Classes="muted"
			           VerticalAlignment="Center"
			           Text="{x:Static res:Strings.U_troca_rapida_de_alvo_mantem_o_resto_da_familia_i_145b33d0}" />
			<Button Grid.Column="1"
			        Margin="12,0,8,0"
			        Classes="secondaryAction accentProtect"
			        Click="Button_Apply"
			        IsEnabled="{Binding HasChanges}"
			        Content="{x:Static res:Strings.U_aplicar_alvo_1e1117bc}" />
			<Button Grid.Column="2"
			        Classes="secondaryAction"
			        Click="Button_Close"
			        Content="{x:Static res:Strings.CommonClose}" />
		</Grid>
	</Grid>
</Window>
