<Window RequestedThemeVariant="Dark" xmlns="https://github.com/avaloniaui" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d" d:DesignWidth="1240" d:DesignHeight="820" x:Class="FFXProjectEditor.MonsterAiPhaseRotationAdvanced_Window" Title="{x:Static res:Strings.U_WinPhaseRotationAdvanced}" Width="1240" Height="820" MinWidth="760" MinHeight="560" xmlns:res="clr-namespace:FFXProjectEditor.Resources">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Modules/MonsterAiEditor/MonsterAiColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        <DataTemplate x:Key="RouteCardTemplate">
            <Expander Margin="0,0,0,8" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                <Expander.Header>
                    <Border Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                <ItemsControl Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding Badges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="7,2" Margin="2,0" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="5">
                                                <TextBlock FontSize="12" Text="{Binding}" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Classes="muted" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,3" Spacing="2">
                                    <TextBlock Classes="sectionLabel" Text="{Binding HowChosen.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding HowChosen.Summary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,3" Spacing="2">
                                    <TextBlock Classes="sectionLabel" Text="{Binding WhatItDoes.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding WhatItDoes.Summary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,3,5,0" Spacing="2">
                                    <TextBlock Classes="sectionLabel" Text="{Binding HowItTargets.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding HowItTargets.Summary}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,3,0,0" Spacing="2">
                                    <TextBlock Classes="sectionLabel" Text="{Binding HowItLeavesState.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding HowItLeavesState.Summary}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander.Header>
                <Border Margin="0,6,0,0" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionLabel" Text="{Binding HowChosen.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding HowChosen.Details}" TextWrapping="Wrap" IsVisible="{Binding HowChosen.HasDetails}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionLabel" Text="{Binding WhatItDoes.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding WhatItDoes.Details}" TextWrapping="Wrap" IsVisible="{Binding WhatItDoes.HasDetails}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionLabel" Text="{Binding HowItTargets.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding HowItTargets.Details}" TextWrapping="Wrap" IsVisible="{Binding HowItTargets.HasDetails}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="sectionLabel" Text="{Binding HowItLeavesState.Title}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Classes="muted" Text="{Binding HowItLeavesState.Details}" TextWrapping="Wrap" IsVisible="{Binding HowItLeavesState.HasDetails}" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding Footer}" TextWrapping="Wrap" />
                        <Button HorizontalAlignment="Left" Classes="secondaryAction accentProtect" Click="Button_OpenAdvancedPhaseUnitEditor" IsVisible="{Binding CanOpenIndirectEditor}" Tag="{Binding IndirectUnitId}" Content="{x:Static res:Strings.U_abrir_esta_familia_indireta_d55a8880}" />
                    </StackPanel>
                </Border>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedDetailRowTemplate">
            <Grid>
                <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Label}" TextWrapping="Wrap" />
                                <TextBlock Classes="sectionLabel" Text="{Binding VariableName}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0" Text="{Binding OffsetSummary}" VerticalAlignment="Top" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="{Binding ValueSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding DetailSummary}" TextWrapping="Wrap" IsVisible="{Binding HasDetailSummary}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,8" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="2" CornerRadius="7" IsVisible="{Binding IsFocusTarget}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedVariableFocusRowTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="sectionLabel" Text="{Binding ValueSummary}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding DependencySummary}" TextWrapping="Wrap" IsVisible="{Binding HasDependencySummary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Classes="muted" HorizontalAlignment="Right" Text="{Binding OffsetSummary}" TextWrapping="Wrap" />
                        <Button Classes="secondaryAction accentProtect" HorizontalAlignment="Right" Click="Button_OpenAdvancedPhaseUnitEditor" IsVisible="{Binding CanOpenEditor}" Tag="{Binding EditorLaunchContext}" Content="{x:Static res:Strings.U_editar_esta_rota_722d114c}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedPhaseMapCardTemplate">
            <Border Padding="12" Margin="0,0,0,8" Background="{DynamicResource PanelAltBrush}" CornerRadius="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding DisplayTitle}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AuthoringStatus}" TextWrapping="Wrap" Classes="muted" />
                    <TextBlock Text="{Binding GuardSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ActionSummary}" TextWrapping="Wrap" Classes="muted" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedRouteConsumerTemplate">
            <Border Margin="0,0,10,8" Padding="10" MinWidth="220" MaxWidth="250" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                    <TextBlock Classes="sectionLabel" Text="{Binding PayloadSummary}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding TargetSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding CallSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedFluxThresholdTemplate">
            <Button Margin="0,0,0,8" Padding="0" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Click="Button_OpenAdvancedFluxThresholdEditor" Tag="{Binding}">
                <Border Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding VariableName}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{Binding RoleLabel}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0" Text="{Binding SiteSummary}" VerticalAlignment="Top" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonRawFormulaIr}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        <TextBlock FontFamily="Cascadia Mono,Consolas,Monospace" Text="{Binding RawFormulaSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding ComparisonSummary}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding FollowUpSummary}" TextWrapping="Wrap" />
                        <Border Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_threshold_raw_44072f0d}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding CurrentThresholdSummary}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{Binding WriterSummary}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{x:Static res:Strings.U_clique_para_abrir_o_editor_raw_desta_chain_6faf228b}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedAnimaOdThresholdEvidenceTemplate">
            <Border Padding="16" Background="{DynamicResource PanelAltBrush}" CornerRadius="8">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding RoleLabel}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="{Binding CurrentThresholdSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Static res:Strings.AiAdvancedOverdriveHint}" TextWrapping="Wrap" Classes="muted" />
                    <TextBlock Text="{x:Static res:Strings.AiAdvancedOverdriveMaximum}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding MaximumText, Mode=TwoWay}" Watermark="100" AutomationProperties.Name="{x:Static res:Strings.AiAdvancedOverdriveMaximum}" />
                    <Button Content="{x:Static res:Strings.ActionSave}" HorizontalAlignment="Left" Classes="primaryAction" Click="Button_ApplyAdvancedAnimaOdThreshold" Tag="{Binding}" />
                    <Expander Header="{x:Static res:Strings.AiAdvancedEvidence}">
                        <TextBlock Text="{Binding WriterSummary}" TextWrapping="Wrap" Classes="muted" />
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedOmnisClusterEvidenceTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RoleLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding BeatName}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding CurrentCommandSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding WriterSummary}" TextWrapping="Wrap" />
                    <TextBox Margin="0,4,0,0" Text="{Binding CommandText}" Watermark="{x:Static res:Strings.CommonCommandHex}" AutomationProperties.Name="{x:Static res:Strings.CommonCommandHex}" />
                    <Button Margin="0,4,0,0" Classes="secondaryAction accentProtect" Click="Button_ApplyAdvancedOmnisCluster" Tag="{Binding}" Content="{x:Static res:Strings.U_aplicar_patch_raw_do_omnis_01a452c3}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedMortibodyAccumulatorEvidenceTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RoleLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding VariableName}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding CurrentScoreSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding WriterSummary}" TextWrapping="Wrap" />
                    <TextBox Margin="0,4,0,0" Text="{Binding ScoreText}" Watermark="{x:Static res:Strings.U_score_489f4877}" AutomationProperties.Name="{x:Static res:Strings.U_score_489f4877}" />
                    <Button Margin="0,4,0,0" Classes="secondaryAction accentProtect" Click="Button_ApplyAdvancedMortibodyAccumulator" Tag="{Binding}" Content="{x:Static res:Strings.U_aplicar_patch_raw_do_mortibody_63daf6be}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedMortiorchisCompanionEvidenceTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RoleLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding BeatName}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding CurrentCommandSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding WriterSummary}" TextWrapping="Wrap" />
                    <TextBox Margin="0,4,0,0" Text="{Binding CommandText}" Watermark="{x:Static res:Strings.CommonCommandHex}" AutomationProperties.Name="{x:Static res:Strings.CommonCommandHex}" />
                    <Button Margin="0,4,0,0" Classes="secondaryAction accentProtect" Click="Button_ApplyAdvancedMortiorchisCompanion" Tag="{Binding}" Content="{x:Static res:Strings.U_aplicar_patch_raw_do_mortiorchis_95ab5a10}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedReactiveSensorEvidenceTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RoleLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding VariableName}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding PropertyName}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding CurrentStateSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding WriterSummary}" TextWrapping="Wrap" />
                    <TextBox Margin="0,4,0,0" Text="{Binding StateText}" Watermark="{x:Static res:Strings.U_state_value_b6c697dd}" AutomationProperties.Name="{x:Static res:Strings.U_state_value_b6c697dd}" />
                    <Button Margin="0,4,0,0" Classes="secondaryAction accentProtect" Click="Button_ApplyAdvancedReactiveSensor" Tag="{Binding}" Content="{x:Static res:Strings.U_aplicar_patch_raw_do_sensor_reativo_cb3a9651}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedRoundScriptedBossEvidenceTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RoleLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding BeatName}" TextWrapping="Wrap" />
                    <TextBlock FontWeight="SemiBold" Text="{Binding CurrentCommandSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding WriterSummary}" TextWrapping="Wrap" />
                    <TextBox Margin="0,4,0,0" Text="{Binding CommandText}" Watermark="{x:Static res:Strings.CommonCommandHex}" AutomationProperties.Name="{x:Static res:Strings.CommonCommandHex}" />
                    <Button Margin="0,4,0,0" Classes="secondaryAction accentProtect" Click="Button_ApplyAdvancedRoundScriptedBoss" Tag="{Binding}" Content="{x:Static res:Strings.U_aplicar_patch_raw_do_m238_dfa6495d}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedCompanionPackageTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="{Binding BattleId}" TextWrapping="Wrap" />
                        <Border Grid.Column="1" Padding="8,3" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="6">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding StatusLabel}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <TextBlock Classes="muted" Text="{Binding HumanSummary}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding CoverageLabel}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedCompanionRowTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="{Binding SlotLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0" Text="{Binding HostActionOffsetHex}" VerticalAlignment="Top" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Classes="sectionLabel" Text="{Binding MonsterLabel}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding HostActionLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding HiddenStatusLabel}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding EvidenceLabel}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedAnimaPayloadTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontWeight="SemiBold" Text="{Binding PayloadSummary}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0" Text="{Binding OffsetSummary}" VerticalAlignment="Top" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Classes="sectionLabel" Text="{Binding SlotLabel}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted" Text="{Binding DetailSummary}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="AdvancedFamilySurfaceRowTemplate">
            <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Classes="sectionLabel" Text="{Binding Subtitle}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Classes="muted" Margin="10,0,0,0" Text="{Binding OffsetSummary}" VerticalAlignment="Top" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Classes="muted" Text="{Binding DetailSummary}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Classes="secondaryAction accentProtect" Click="Button_OpenAdvancedPhaseUnitEditor" IsVisible="{Binding CanOpenEditor}" Tag="{Binding LaunchContext}" Content="{Binding OpenButtonLabel}" />
                </StackPanel>
            </Border>
        </DataTemplate>
            </ResourceDictionary>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="36" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
    </Window.Styles>
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <Border Padding="16" Classes="card">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Static res:Strings.AiAdvancedTitle}" TextWrapping="Wrap" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AdvancedWorkspaceMonster}" TextWrapping="Wrap" Classes="muted" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Static res:Strings.CommonReaudit}" Classes="secondaryAction" Click="Button_RefreshPhaseRotationAudit" Margin="16,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding AdvancedCoverageSummary}" TextWrapping="Wrap" Classes="muted" />
            </StackPanel>
        </Border>
        <TabControl Grid.Row="1" SelectedIndex="{Binding AdvancedWorkspaceTabIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.AiAdvancedNavigation}">
            <TabItem Header="{x:Static res:Strings.AiAdvancedRoutes}">
                <Grid ColumnDefinitions="0.8*,1.5*" Margin="0,12,0,0">
                    <Border Grid.Column="0" Padding="16" Classes="card">
                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Static res:Strings.AiAdvancedRoutes}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static res:Strings.AiAdvancedRoutesHint}" TextWrapping="Wrap" Classes="muted" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Margin="0,12,0,12" x:Name="AdvancedRouteSearch" Text="{Binding AdvancedRouteQuery, Mode=TwoWay}" Watermark="{x:Static res:Strings.AiAdvancedSearchExample}" AutomationProperties.Name="{x:Static res:Strings.AiAdvancedSearchRoutes}" />
                            <ListBox AutoScrollToSelectedItem="False" ItemsSource="{Binding AdvancedFilteredPhaseUnits}" SelectedItem="{Binding SelectedAdvancedPhaseUnit, Mode=TwoWay}" ItemTemplate="{StaticResource AdvancedPhaseMapCardTemplate}" AutomationProperties.Name="{x:Static res:Strings.AiAdvancedRoutes}" Grid.Row="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            <StackPanel Spacing="12" Grid.Row="3">
                                <TextBlock Text="{Binding AdvancedRouteSearchSummary}" TextWrapping="Wrap" Classes="muted" />
                                <TextBlock Text="{Binding AdvancedRouteEmptySummary}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding HasNoAdvancedRouteMatches}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Grid.Column="1">
                        <StackPanel Spacing="12">
                            <Border Classes="card" Padding="20" Margin="16,0,0,0">
                                <StackPanel Spacing="12" IsVisible="{Binding HasSelectedAdvancedPhaseUnit}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding SelectedAdvancedPhaseUnit.DisplayTitle}" TextWrapping="Wrap" FontSize="21" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedAdvancedPhaseUnit.AuthoringStatus}" TextWrapping="Wrap" Classes="muted" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Static res:Strings.AiAdvancedWhen}" TextWrapping="Wrap" Classes="muted" />
                                        <TextBlock Text="{Binding SelectedAdvancedPhaseUnit.GuardSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Static res:Strings.AiAdvancedActions}" TextWrapping="Wrap" Classes="muted" />
                                        <TextBlock Text="{Binding SelectedAdvancedPhaseUnit.ActionSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Static res:Strings.AiAdvancedTargets}" TextWrapping="Wrap" Classes="muted" />
                                        <TextBlock Text="{Binding SelectedAdvancedPhaseUnit.FriendlyTargetSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{x:Static res:Strings.AiAdvancedThen}" TextWrapping="Wrap" Classes="muted" />
                                        <TextBlock Text="{Binding SelectedAdvancedPhaseUnit.NextStateSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <WrapPanel>
