                                                            <Button Grid.Column="7" Margin="8,0,0,0" Classes="secondaryAction" Click="Button_AddPhaseVarReset" Content="{x:Static res:Strings.CommonResetToZero}" />
                                                        </Grid>
                                                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PhaseAdvanceTargetSummary}" />
                                                        <ListBox AutoScrollToSelectedItem="False" MinHeight="40" MaxHeight="120" ItemsSource="{Binding SelectedPhaseDraftStep.VarAdvances}" SelectedItem="{Binding SelectedPhaseVarAdvance, Mode=TwoWay}" AutomationProperties.Name="{x:Static res:Strings.CommonPhaseVarChanges}">
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.U_opcional_cada_fase_pode_subir_ou_resetar_nenhuma_2229239a}" />
                                                            <Button Grid.Column="1" Classes="secondaryAction" IsEnabled="{Binding CanRemovePhaseVarAdvance}" Click="Button_RemovePhaseVarAdvance" Content="{x:Static res:Strings.CommonRemoveAdvance}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="0" Padding="{DynamicResource SpacingMd}" Margin="0,0,0,16" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7" Grid.Row="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonHumanPreview}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock TextWrapping="Wrap" Text="{Binding PhaseRotationPreview}" />
                                            <TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.U_writer_v1_dentro_do_avancado_guarda_a_fase_por_c_925d2d9a}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static res:Strings.AiAdvancedEvidence}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <TextBlock Text="{x:Static res:Strings.AiAdvancedEvidenceHint}" TextWrapping="Wrap" Classes="muted" />
                        <Border Padding="10" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7" ToolTip.Tip="{x:Static res:Strings.U_notas_honestas_limites_reais_desta_familia_indir_d07ea3a7}" IsVisible="{Binding HasSelectedAdvancedPhaseUnit}">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.AiAdvancedCoverageTitle}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Foreground="{DynamicResource TextPrimaryBrush}" Text="{Binding SelectedAdvancedPhaseUnit.NotesSummary}" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Text="{x:Static res:Strings.U_a_autoria_segura_atual_cobre_clone_estrutural_de_fd54b400}" />
                            </StackPanel>
                        </Border>
                        <Expander Header="{x:Static res:Strings.U_leituras_auxiliares_e_evidencias_54550694}" IsExpanded="True" HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Border Padding="{DynamicResource SpacingMd}" Classes="card">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PhaseVariableEvidenceSummary}" />
                                        <ListBox AutoScrollToSelectedItem="False" ItemsSource="{Binding PhaseVariableEvidenceBlocks}" MinHeight="72" AutomationProperties.Name="{x:Static res:Strings.AiAdvancedEvidence}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="{DynamicResource SpacingMd}" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <StackPanel Spacing="4">
                                                                <TextBlock FontWeight="SemiBold" Text="{Binding HookLabel}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="sectionLabel" Text="{Binding GuardSummary}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding EffectSummary}" TextWrapping="Wrap" IsVisible="{Binding HasEffectSummary}" />
                                                                <StackPanel Spacing="2" IsVisible="{Binding HasWriteSummary}">
                                                                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonWriteChangeState}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding WriteSummary}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel Spacing="2" IsVisible="{Binding HasConsumerSummary}">
                                                                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonConsumedBy}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding ConsumerSummary}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <StackPanel Spacing="2" IsVisible="{Binding HasNextStateSummary}">
                                                                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonNextStatePt}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                                                    <TextBlock Text="{Binding NextStateSummary}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <TextBlock Classes="muted" Text="{Binding OffsetSummary}" TextWrapping="Wrap" />
                                                                <TextBlock Classes="muted" Text="{Binding TechnicalSummary}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Margin="10,0,0,0" Padding="7,3" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top">
                                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Badge}" TextWrapping="Wrap" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemTemplate="{StaticResource RouteCardTemplate}" ItemsSource="{Binding PhaseConditionPreviewRouteCards}" />
                                <ItemsControl ItemTemplate="{StaticResource RouteCardTemplate}" ItemsSource="{Binding PhaseVariableEvidenceRouteCards}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Padding="12" Margin="0,12,0,0" Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding AdvancedWorkspaceFeedback}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding HasAdvancedWorkspaceFeedback}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding PhaseRotationApplySummary}" TextWrapping="Wrap" Classes="muted" IsVisible="{Binding IsAdvancedDraftTab}" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="{x:Static res:Strings.AiAdvancedApplyDraft}" Classes="primaryAction" Click="Button_ApplyPhaseRotationDraft" IsVisible="{Binding IsAdvancedDraftTab}" IsEnabled="{Binding CanApplyAdvancedDraft}" Margin="0,0,8,4" />
                    <StackPanel Orientation="Horizontal" IsVisible="{Binding IsAdvancedRoutesTab}">
                        <Button Content="{x:Static res:Strings.AiAdvancedCloneRoute}" Classes="secondaryAction" Click="Button_CloneAdvancedPhaseUnitRoute" IsEnabled="{Binding CanCloneSelectedAdvancedPhaseUnit}" Margin="0,0,8,4" />
                        <Button Content="{x:Static res:Strings.AiAdvancedEditRoute}" Classes="primaryAction" Click="Button_OpenAdvancedPhaseUnitEditor" Tag="{Binding SelectedAdvancedPhaseUnit.UnitId}" IsEnabled="{Binding CanEditAdvancedRoute}" Margin="0,0,8,4" />
                    </StackPanel>
                    <Button Content="{x:Static res:Strings.CommonClose}" Classes="secondaryAction" Click="Button_Close" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
