<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="780"
             xmlns:common="using:FFXProjectEditor.Modules.Common"
             xmlns:ctrl="clr-namespace:FFXProjectEditor.Controls"
             x:Class="FFXProjectEditor.MonsterAiEditor_Control">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Modules/MonsterAiEditor/MonsterAiColors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!-- Studio uses a dark palette. Keep native control themes in the same scope. -->
    <ThemeVariantScope RequestedThemeVariant="Dark">


	<!-- ===== Camada 4 (overhaul de UI): a sidebar interna de 280px vira um Expander colapsável.
	     Fecha p/ ~32px (só o header), abre no painel denso (Padding="{DynamicResource SpacingSm}" em vez de "16", ListBox
	     sem cardSoft por item). Estado persiste no DataModel.IsMonsterListExpanded.
	     Tudo abaixo preserva bindings/handlers originais — só o container externo mudou. -->
	<Grid ColumnDefinitions="Auto,*">
		<Expander Grid.Column="0"
		          IsExpanded="{Binding IsMonsterListExpanded, Mode=TwoWay}"
		          ExpandDirection="Down"
		          HorizontalAlignment="Stretch"
		          VerticalAlignment="Stretch"
		          Padding="0"
		          Margin="8,8,0,8">
			<Expander.Header>
				<StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonMonster}" />
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_ai_list_3d9d92d0}" />
				</StackPanel>
			</Expander.Header>

			<Border Width="280" Classes="card" CornerRadius="{DynamicResource RadiusMd}" Padding="{DynamicResource SpacingSm}">
				<Grid RowDefinitions="Auto,Auto,*">
					<StackPanel Spacing="6">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_atel_disassembler_1bd273ad}" VerticalAlignment="Center" />
							<ctrl:CapabilityBadge Grid.Column="1" Name="AiCapabilityBadge" VerticalAlignment="Center" />
						</Grid>
						<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_monster_ai_editor_3cc50873}" />
						<TextBlock Classes="muted"
						           FontSize="11"
						           Text="{x:Static res:Strings.U_disassembles_the_real_aifile_of_each_monster_bin_016bcabd}"
						           TextWrapping="Wrap" />
					</StackPanel>

					<StackPanel Grid.Row="1" Margin="0,10,0,10" Spacing="8">
						<WrapPanel>
							<Button Margin="0,0,6,4" HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_Refresh" Content="{x:Static res:Strings.ActionRefresh}" />
							<Button Margin="0,0,6,4" HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_RefreshRuntime" Content="{x:Static res:Strings.AiEditorRefreshRuntime}" />
							<Button Margin="0,0,0,4" HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_AtelScriptLab" Content="{x:Static res:Strings.AiEditorAtelLab}" />
						</WrapPanel>
						<TextBox AutomationProperties.Name="{x:Static res:Strings.U_filter_by_monster_id_or_path_b1e27db1}" Watermark="{x:Static res:Strings.U_filter_by_monster_id_or_path_b1e27db1}" Text="{Binding FilterText, Mode=TwoWay}" />
						<TextBlock Classes="muted" FontSize="11" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
					</StackPanel>

					<ListBox AutomationProperties.Name="{x:Static res:Strings.CommonMonster}" Grid.Row="2"
					         ItemsSource="{Binding DisplayedMonsters}"
					         SelectedItem="{Binding SelectedMonster, Mode=TwoWay}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Margin="0,0,0,4" Padding="{DynamicResource SpacingSm}" Classes="cardSoft" CornerRadius="6">
									<StackPanel Spacing="2">
										<TextBlock Classes="sectionLabel" FontSize="10" Text="{Binding IndexLabel}" />
										<TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
										<TextBlock Classes="muted" FontSize="11" Text="{Binding Summary}" TextWrapping="Wrap" />
									</StackPanel>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</Grid>
			</Border>
		</Expander>

		<ScrollViewer Grid.Column="1" Margin="10,8,8,8" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="14" MaxWidth="1280" HorizontalAlignment="Stretch">
				<Border Padding="{DynamicResource SpacingLg}" Classes="card">
					<StackPanel Spacing="8">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonSelectedMonsterAi}" />
						<TextBlock Classes="cardTitle" Text="{Binding SelectedMonster.Title}" />
						<TextBlock Classes="muted" Text="{Binding SelectedHeaderSummary}" TextWrapping="Wrap" />
						<TextBlock Classes="muted" Text="{Binding ScopeSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Expander Header="{x:Static res:Strings.SessionControls}" IsExpanded="True" HorizontalAlignment="Stretch">
				<Border Margin="0,8,0,0" Padding="{DynamicResource SpacingMd}" Classes="card accentShell">
					<Grid RowDefinitions="Auto,Auto">
						<StackPanel Spacing="2" VerticalAlignment="Center">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" Foreground="{DynamicResource AccentMoveForegroundBrush}" />
							<TextBlock Classes="muted" Text="{Binding PendingEditSummary}" TextWrapping="Wrap" />
						</StackPanel>
						<WrapPanel Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
						<Button Margin="0,0,8,0" Classes="secondaryAction accentProtect"
						        IsEnabled="{Binding HasPendingEdits}" Click="Button_Save"
						        ToolTip.Tip="{x:Static res:Strings.U_grava_as_edicoes_de_operando_pendentes_no_monste_a101ead9}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<PathIcon Data="{DynamicResource IconSave}" Width="14" Height="14" />
								<TextBlock Text="{x:Static res:Strings.ActionSave}" />
							</StackPanel>
						</Button>
						<Button Margin="0,0,8,0" Classes="secondaryAction" Name="Button_ReviewDiff" Click="Button_ReviewDiff_Click" AutomationProperties.Name="{x:Static res:Strings.AiEditorReviewDiff}" Content="{x:Static res:Strings.AiEditorReviewDiff}" />
						<Button Margin="0,0,8,0" Classes="secondaryAction accentUndo"
						        IsEnabled="{Binding CanUndoBackup}" Click="Button_RestoreBackup"
						        ToolTip.Tip="{x:Static res:Strings.U_restaura_o_prev_bak_desfaz_o_ultimo_save_desta_s_df5bbd05}"
						        Content="{x:Static res:Strings.U_desfazer_d328a0c3}" />
						<Button Margin="0,0,8,0" Classes="secondaryAction accentCrimson"
						        IsEnabled="{Binding CanRestoreVanillaAi}" Click="Button_RestoreVanillaDiff"
						        ToolTip.Tip="{x:Static res:Strings.U_sobrescreve_a_ia_atual_pela_vanilla_extraida_con_c7e6e311}"
						        Content="{Binding RestoreVanillaDiffButtonText}" />
						<Button Classes="secondaryAction accentRefresh"
						        Click="Button_Refresh"
						        ToolTip.Tip="{x:Static res:Strings.U_recarrega_a_lista_de_monstros_do_disco_117473e7}"
						        Content="{x:Static res:Strings.U_atualizar_8c38bfbe}" />
						</WrapPanel>
					</Grid>
				</Border>
				</Expander>

				<Expander Header="{x:Static res:Strings.CommonMonsterAiTrinity}" IsExpanded="False" HorizontalAlignment="Stretch">
				<Border Margin="0,8,0,0" Padding="{DynamicResource SpacingLg}" Classes="card accentShell">
					<StackPanel Spacing="12">
						<StackPanel Spacing="2" HorizontalAlignment="Center">
							<TextBlock Classes="sectionLabel"
							           Text="{x:Static res:Strings.CommonMonsterAiTrinity}"
							           Foreground="{DynamicResource AccentGoldForegroundBrush}"
							           HorizontalAlignment="Center"
							           TextAlignment="Center" />
							<TextBlock Classes="cardTitle"
							           Text="{x:Static res:Strings.U_aeon_observa_bible_ensina_yunalesca_consagra_1ee07c6e}"
							           HorizontalAlignment="Center"
							           TextAlignment="Center" />
							<TextBlock Classes="muted"
							           Text="{x:Static res:Strings.U_sin_fica_embaixo_templates_bestiais_compostos_e__a0b3a9b7}"
							           HorizontalAlignment="Center"
							           TextAlignment="Center" />
						</StackPanel>

						<Border Padding="{DynamicResource SpacingMd}" Classes="cardSoft accentShell">
							<StackPanel Spacing="6">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_o_que_este_monstro_faz_c252e2d6}" Foreground="{DynamicResource AccentRegenForegroundBrush}" />
								<TextBlock FontSize="14" TextWrapping="Wrap" Text="{Binding BehaviorSummary}" />
							</StackPanel>
						</Border>

				<Expander Header="{x:Static res:Strings.U_aeon_diff_da_ia_ca36f443}" IsExpanded="False" HorizontalAlignment="Stretch">
				<Border Margin="0,8,0,0" Padding="14" Classes="cardSoft" Background="{DynamicResource AccentShellFillBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1">
					<StackPanel Spacing="8">
						<Grid RowDefinitions="Auto,Auto">
							<StackPanel Spacing="2">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_aeon_assembly_evolution_observation_node_d82a307d}" Foreground="{DynamicResource AccentMoveForegroundBrush}" />
								<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding DiffSummary}" />
<TextBlock Classes="muted" Text="{Binding DiffReferencePath}" TextWrapping="Wrap" IsVisible="{Binding DiffReferencePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
							</StackPanel>
							<WrapPanel Grid.Row="1" Margin="0,10,0,0">
						<Button
						        Classes="secondaryAction accentRefresh"
						        Click="Button_LoadAiDiff" Content="{x:Static res:Strings.AiEditorReloadDiff}" />
						<Button
						        Margin="8,0,0,0"
						        Classes="secondaryAction accentCrimson"
						        IsEnabled="{Binding CanRestoreVanillaAi}"
						        Click="Button_RestoreVanillaDiff"
						        Content="{Binding RestoreVanillaDiffButtonText}" />
							</WrapPanel>
						</Grid>
						<Expander Header="{x:Static res:Strings.U_ver_diff_instrucao_a_instrucao_ce6b9edd}" IsExpanded="False" HorizontalAlignment="Stretch">
							<StackPanel Spacing="10" Margin="0,8,0,0">
								<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding DiffWarning}" />
								<Border Padding="{DynamicResource SpacingMd}"
								        Background="{DynamicResource AccentShellFillBrush}"
								        BorderBrush="{DynamicResource PanelStrokeBrush}"
								        BorderThickness="1"
								        CornerRadius="{DynamicResource RadiusSm}"
								        IsVisible="{Binding HasNoDiffEntries}">
									<StackPanel Spacing="4">
										<TextBlock FontWeight="SemiBold" Text="{x:Static res:Strings.U_nenhum_diff_para_listar_39196b7c}" IsVisible="{Binding DiffReferencePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
										<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding DiffEmptyMessage}" />
									</StackPanel>
								</Border>
								<ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasDiffEntries}">
									<ItemsControl ItemsSource="{Binding DiffEntries}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Border Margin="0,0,0,8"
												        Padding="10"
												        Background="{Binding TypeBrush}"
												        BorderBrush="{DynamicResource PanelStrokeBrush}"
												        BorderThickness="1"
												        CornerRadius="{DynamicResource RadiusSm}">
													<StackPanel Spacing="8">
														<WrapPanel>
															<StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
																<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonType}" />
																<TextBlock FontWeight="SemiBold" Text="{Binding TypeLabel}" />
															</StackPanel>
															<StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
																<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_worker_99edd8c8}" />
																<TextBlock FontFamily="Cascadia Mono,Consolas,Monospace" Text="{Binding WorkerLabel}" />
															</StackPanel>
															<StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,14,6">
																<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonOffset}" />
																<TextBlock FontFamily="Cascadia Mono,Consolas,Monospace" Text="{Binding OffsetLabel}" />
															</StackPanel>
														</WrapPanel>
														<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="72,*">
															<TextBlock Grid.Row="0"
															           Grid.Column="0"
															           Classes="sectionLabel"
															           Text="{x:Static res:Strings.U_antes_1177e4ed}"
															           Margin="0,4,8,0" />
															<Border Grid.Row="0"
															        Grid.Column="1"
															        Padding="8,6"
															        Background="{DynamicResource AccentShellFillBrush}"
															        CornerRadius="6">
																<TextBlock FontFamily="Cascadia Mono,Consolas,Monospace"
																           TextWrapping="Wrap"
																           Text="{Binding OriginalText}" />
															</Border>
															<TextBlock Grid.Row="1"
															           Grid.Column="0"
															           Classes="sectionLabel"
															           Text="{x:Static res:Strings.U_depois_61f6ee7b}"
															           Margin="0,8,8,0" />
															<Border Grid.Row="1"
															        Grid.Column="1"
															        Margin="0,6,0,0"
															        Padding="8,6"
															        Background="{DynamicResource AccentShellFillBrush}"
															        CornerRadius="6">
																<TextBlock FontFamily="Cascadia Mono,Consolas,Monospace"
																           TextWrapping="Wrap"
																           Text="{Binding EditedText}" />
															</Border>
														</Grid>
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</ScrollViewer>
							</StackPanel>
						</Expander>
					</StackPanel>
				</Border>
				</Expander>

						<Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*">
							<Expander Header="{x:Static res:Strings.U_yunalesca_ritos_rapidos_6d1ebaa5}" IsExpanded="False" HorizontalAlignment="Stretch">
							<Border Margin="0,8,0,0" Padding="14" Classes="cardSoft" Background="{DynamicResource AccentShellFillBrush}" BorderBrush="{DynamicResource AccentGoldBorderBrush}" BorderThickness="1">
								<StackPanel Spacing="10">
									<Grid ColumnDefinitions="*,Auto">
										<StackPanel Spacing="2">
											<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_yunalesca_8aaf1c12}" Foreground="{DynamicResource AccentGoldForegroundBrush}" />
											<TextBlock FontWeight="SemiBold" FontSize="18" Text="{x:Static res:Strings.U_ritos_rapidos_de_1_clique_ee1ad2a1}" />
										</StackPanel>
										<TextBlock Grid.Column="1" Classes="muted" Text="{x:Static res:Strings.U_salva_com_prev_bak_24dfca77}" VerticalAlignment="Center" />
									</Grid>
									<TextBlock Classes="muted" TextWrapping="Wrap"
									           Text="{x:Static res:Strings.U_yevon_s_unsent_nexus_for_automated_legendary_ene_1478eb36}" />
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_presets_prontos_status_proprio_0f4fea99}" Foreground="{DynamicResource AccentMoveForegroundBrush}" />
									<WrapPanel>
									<Button Margin="0,0,8,8" Classes="secondaryAction accentHaste" Click="Button_PresetHaste" Content="{x:Static res:Strings.U_haste_c0fb3161}" />
									<Button Margin="0,0,8,8" Classes="secondaryAction accentShell" Click="Button_PresetProtect" Content="{x:Static res:Strings.U_protect_838ab88e}" />
									<Button Margin="0,0,8,8" Classes="secondaryAction accentShell" Click="Button_PresetShell" Content="{x:Static res:Strings.U_shell_381ec11c}" />
									<Button Margin="0,0,8,8" Classes="secondaryAction accentReflect" Click="Button_PresetReflect" Content="{x:Static res:Strings.U_reflect_f487fb66}" />
									<Button Margin="0,0,8,8" Classes="secondaryAction accentRegen" Click="Button_PresetRegen" Content="{x:Static res:Strings.U_regen_0395c42d}" />
									<Button Margin="0,0,8,8" Classes="secondaryAction accentNulAll" Click="Button_PresetNulAll" Content="{x:Static res:Strings.U_nulall_4100afb3}" />
									<Button Margin="0,0,0,8" Classes="secondaryAction accentGold" Click="Button_PresetDefensive" Content="{x:Static res:Strings.U_defensivo_p_h_e89bce56}" />
									</WrapPanel>
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_escala_de_modelo_scaleownsize_atel_0x7028_45fde94c}" Foreground="{DynamicResource AccentGoldForegroundBrush}" Margin="0,6,0,0" />
									<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding UniformScaleSummary}" />
									<Grid ColumnDefinitions="Auto,100,Auto,Auto,Auto">
										<TextBlock VerticalAlignment="Center" Text="{x:Static res:Strings.U_fator_68e80056}" />
										<TextBox AutomationProperties.Name="{x:Static res:Strings.AiEditorScaleLabel}" Grid.Column="1"
										         Margin="8,0,0,0"
										         Watermark="1.8"
										         Text="{Binding ScaleFactorText, Mode=TwoWay}"
										         FontFamily="Cascadia Mono,Consolas,Monospace" />
										<Button Grid.Column="2"
										        Margin="8,0,0,0"
										        Classes="secondaryAction accentGold"
										        Click="Button_ApplyUniformScale"
										        Content="{x:Static res:Strings.U_aplicar_escala_580ff642}" />
										<Button Grid.Column="3"
										        Margin="4,0,0,0"
										        Classes="secondaryAction"
										        Click="Button_ScalePlus10"
										        Content="+10%" />
										<Button Grid.Column="4"
										        Margin="4,0,0,0"
										        Classes="secondaryAction"
										        Click="Button_ScalePlus80"
										        Content="+80%" />
									</Grid>
									<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding PresetSummary}" />
								</StackPanel>
							</Border>
							</Expander>

							<Expander Grid.Row="1" Margin="0,14,0,0" Header="{x:Static res:Strings.CommonBibleOfSpira}" IsExpanded="False" HorizontalAlignment="Stretch">
							<Border Margin="0,8,0,0" Padding="14" Background="{DynamicResource AccentShellFillBrush}" BorderBrush="{DynamicResource AccentShellBorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}">
								<StackPanel Spacing="10">
									<Grid ColumnDefinitions="*,Auto">
										<StackPanel Spacing="2">
											<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonBibleOfSpira}" Foreground="{DynamicResource AccentRegenForegroundBrush}" />
											<TextBlock FontWeight="SemiBold" FontSize="18" Text="{x:Static res:Strings.U_manual_atel_read_only_7cc003e9}" />
										</StackPanel>
									<Button Grid.Column="1"
									        Margin="10,0,0,0"
									        MinWidth="158"
									        Padding="16,10"
									        Classes="secondaryAction accentShell"
									        Click="Button_OpenBibleGuide"
									        ToolTip.Tip="{x:Static res:Strings.U_abrir_guia_atel_completo_a5ba8315}" Content="{x:Static res:Strings.AiEditorOpenGuide}" />
									</Grid>
									<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding BibleContextSummary}" />
									<TextBox AutomationProperties.Name="{x:Static res:Strings.U_buscar_opcode_funcao_field_alvo_ou_padrao_e3cb8188}" Watermark="{x:Static res:Strings.U_buscar_opcode_funcao_field_alvo_ou_padrao_e3cb8188}"
									         Text="{Binding BibleSearchText, Mode=TwoWay}" />
									<Grid ColumnDefinitions="2*,5*">
										<ScrollViewer Grid.Column="0" MaxHeight="230">
											<ListBox AutomationProperties.Name="{x:Static res:Strings.CommonEvidence}" ItemsSource="{Binding BibleEntries}"
											         SelectedItem="{Binding SelectedBibleEntry, Mode=TwoWay}"
											         Background="{DynamicResource AccentShellFillBrush}"
											         BorderBrush="{DynamicResource AccentShellBorderBrush}"
											         BorderThickness="1"
											         Padding="6">
												<ListBox.ItemTemplate>
													<DataTemplate>
														<Border Margin="0,0,0,6" Padding="9" Background="{DynamicResource AccentShellFillBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1" CornerRadius="7">
															<StackPanel Spacing="2">
																<TextBlock Classes="sectionLabel" Foreground="{DynamicResource AccentRegenForegroundBrush}" Text="{Binding KindLabel}" />
																<TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
															</StackPanel>
														</Border>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>
										</ScrollViewer>
										<Border Grid.Column="1" Margin="12,0,0,0" Padding="{DynamicResource SpacingMd}" Background="{DynamicResource AccentShellFillBrush}" BorderBrush="{DynamicResource AccentShellBorderBrush}" BorderThickness="1" CornerRadius="7">
											<StackPanel Spacing="6">
												<TextBlock Classes="sectionLabel" Text="{Binding SelectedBibleEntry.KindLabel}" />
												<TextBlock FontWeight="SemiBold" FontSize="15" Text="{Binding SelectedBibleEntry.Title}" TextWrapping="Wrap" />
												<TextBlock Text="{Binding SelectedBibleEntry.Summary}" TextWrapping="Wrap" />
												<common:AtlasEvidenceBadgeStrip Evidence="{Binding SelectedBibleEvidence}" />
												<TextBlock Classes="muted" Text="{Binding SelectedBibleEntry.StackShape}" TextWrapping="Wrap"
												           FontFamily="Cascadia Mono,Consolas,Monospace" />
												<TextBlock Classes="muted" Text="{Binding SelectedBibleEntry.Guardrail}" TextWrapping="Wrap" />
											</StackPanel>
										</Border>
									</Grid>
								</StackPanel>
							</Border>
							</Expander>
						</Grid>
					</StackPanel>
				</Border>
				</Expander>

				<Border Padding="{DynamicResource SpacingLg}" Classes="card" Background="{DynamicResource AccentShellFillBrush}" BorderBrush="{DynamicResource AccentShellBorderBrush}" BorderThickness="1">
					<StackPanel Spacing="12">
						<Grid ColumnDefinitions="*,Auto,Auto">
							<StackPanel Spacing="2">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_workbench_de_ia_a4b980d4}" Foreground="{DynamicResource AccentRegenForegroundBrush}" />
								<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_ajuste_fino_da_ia_do_monstro_78720b61}" />
							</StackPanel>
							<StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_nivel_87dc673f}" HorizontalAlignment="Right" />
								<ComboBox AutomationProperties.Name="{x:Static res:Strings.AiEditorModeLabel}" MinWidth="160"
								          MaxWidth="240"
								          HorizontalAlignment="Right"
								          ItemsSource="{Binding HumanModeChoices}"
								          SelectedItem="{Binding SelectedHumanMode, Mode=TwoWay}" />
							</StackPanel>
							<CheckBox Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Content="{x:Static res:Strings.U_modo_tecnico_nomes_reais_2c49e6f9}"
							          IsVisible="{Binding IsDevKitMode, FallbackValue=False}"
							          IsChecked="{Binding ShowTechnicalNames, Mode=TwoWay}" />
						</Grid>
						<TextBlock Classes="muted" TextWrapping="Wrap"
						           Text="{x:Static res:Strings.U_aqui_voce_escolhe_payload_troca_acoes_duplica_ac_2a3c4fea}" />
						<Border Padding="10"
						        Background="{DynamicResource AccentShellFillBrush}"
						        BorderBrush="{DynamicResource AccentRegenForegroundBrush}"
						        BorderThickness="1"
						        CornerRadius="{DynamicResource RadiusSm}"
						        IsVisible="{Binding HasBatchSelection, FallbackValue=False}">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock Text="{Binding BatchActionSummary}" TextWrapping="Wrap" VerticalAlignment="Center" />
								<WrapPanel Grid.Column="1" Margin="12,0,0,0">
								<Button Margin="0,0,8,0" Classes="secondaryAction accentMove"
								        Click="Button_MoveBatchUp" Content="{x:Static res:Strings.U_grupo_e00e3a77}" />
								<Button Margin="0,0,8,0" Classes="secondaryAction accentMove"
								        Click="Button_MoveBatchDown" Content="{x:Static res:Strings.U_grupo_40a5ca42}" />
								<Button Classes="secondaryAction accentUndo"
								        Click="Button_ClearBatchSelection" Content="{x:Static res:Strings.CommonClear}" />
