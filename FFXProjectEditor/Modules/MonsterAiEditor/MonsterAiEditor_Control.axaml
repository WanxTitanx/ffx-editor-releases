				</Border>

				<Border Padding="4,2,4,4" Classes="card" Background="{DynamicResource PanelDeepBrush}" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1"
				        IsVisible="{Binding IsDevKitMode, FallbackValue=False}">
					<Expander Header="{x:Static res:Strings.U_devkit_devview_ferramentas_tecnicas_d2bafdab}" IsExpanded="False" HorizontalAlignment="Stretch">
						<StackPanel Spacing="10" Margin="0,8,0,0">
							<StackPanel Spacing="4" Margin="8,0,8,4">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_devkit_devview_6aa9f851}" Foreground="{DynamicResource AccentMoveForegroundBrush}" />
								<TextBlock Classes="muted" TextWrapping="Wrap"
								           Text="{x:Static res:Strings.U_workers_operandos_brutos_ai_assembler_modelos_es_d03259eb}" />
							</StackPanel>

				<Border Padding="4,2,4,4" Classes="card">
					<Expander Header="{x:Static res:Strings.U_workers_e_entrypoints_tecnico_846314e5}" IsExpanded="False" HorizontalAlignment="Stretch">
						<ItemsControl Margin="0,8,0,0" ItemsSource="{Binding SelectedWorkers}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Margin="0,0,0,8" Padding="10" Classes="cardSoft">
										<StackPanel Spacing="3">
											<TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
											<TextBlock Classes="muted" Text="{Binding Summary}" TextWrapping="Wrap" />
											<TextBlock Classes="muted" Text="{Binding Entrypoints}" TextWrapping="Wrap"
											           FontFamily="Cascadia Mono,Consolas,Monospace" />
											<TextBlock Classes="muted" Text="{Binding Jumps}" TextWrapping="Wrap"
											           FontFamily="Cascadia Mono,Consolas,Monospace" />
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</Expander>
				</Border>

				<Border Padding="4,2,4,4" Classes="card">
					<Expander Header="{x:Static res:Strings.U_editar_operandos_brutos_avancado_d06e8a99}" IsExpanded="False" HorizontalAlignment="Stretch">
					<StackPanel Spacing="10" Margin="0,8,0,0">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_edit_operands_byte_local_writes_the_loose_monste_ef751358}" VerticalAlignment="Center" />
							<Button Grid.Column="1" Classes="secondaryAction" Click="Button_Save" Content="{x:Static res:Strings.ActionSave}" />
						</Grid>
						<TextBlock Classes="muted" TextWrapping="Wrap"
						           Text="{x:Static res:Strings.U_each_operand_is_a_u16_hex_editing_changes_only_t_bdb1ba20}" />
							<TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
							           Text="{x:Static res:Strings.U_legenda_cada_linha_1_instrucao_offset_opcode_ope_a287c4a1}" />
						<TextBlock Classes="muted" Text="{Binding PendingEditSummary}" TextWrapping="Wrap" />
						<TextBox AutomationProperties.Name="{x:Static res:Strings.CommonPreview}" Text="{Binding PendingEditPreview}"
						         IsReadOnly="True"
						         AcceptsReturn="True"
						         TextWrapping="NoWrap"
						         MinHeight="72"
						         MaxHeight="140"
						         FontFamily="Cascadia Mono,Consolas,Monospace" />
						<Grid ColumnDefinitions="*,Auto" Margin="0,2,0,4">
								<TextBox AutomationProperties.Name="{x:Static res:Strings.U_filtrar_instrucoes_ex_firaga_3049_callpopa_jump_18f8ae31}" Watermark="{x:Static res:Strings.U_filtrar_instrucoes_ex_firaga_3049_callpopa_jump_18f8ae31}"
								         Text="{Binding InstructionFilter}" />
								<TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0"
								           Text="{Binding InstructionFilterSummary}" />
							</Grid>
							<ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Auto">
							<ItemsControl ItemsSource="{Binding EditableInstructions}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="200,110,160,*" Margin="0,0,0,4">
											<TextBlock Text="{Binding Label}" VerticalAlignment="Center"
											           FontFamily="Cascadia Mono,Consolas,Monospace" />
											<TextBox AutomationProperties.Name="{x:Static res:Strings.AiEditorOperandLabel}" Grid.Column="1" Text="{Binding OperandHex, Mode=TwoWay}"
											         FontFamily="Cascadia Mono,Consolas,Monospace" />
											<TextBlock Grid.Column="3" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0"
												           Text="{Binding Meaning}" ToolTip.Tip="{Binding OpcodeHelp}"
												           FontFamily="Cascadia Mono,Consolas,Monospace" />
												<ComboBox AutomationProperties.Name="{x:Static res:Strings.AiEditorAbilityLabel}" Grid.Column="2" Margin="8,0,0,0" MaxDropDownHeight="360"
											          HorizontalAlignment="Stretch"
											          IsVisible="{Binding IsCommandOperand}"
											          ItemsSource="{Binding CommandOptions}"
											          SelectedItem="{Binding SelectedCommand, Mode=TwoWay}">
												<ComboBox.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding Display}"
														           FontFamily="Cascadia Mono,Consolas,Monospace" />
													</DataTemplate>
												</ComboBox.ItemTemplate>
											</ComboBox>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</StackPanel>
					</Expander>
				</Border>

				<Border Padding="4,2,4,4" Classes="card">
					<Expander Header="{x:Static res:Strings.U_ai_assembler_edicao_livre_avancado_bf182019}" IsExpanded="False" HorizontalAlignment="Stretch">
					<StackPanel Spacing="10" Margin="0,8,0,0">
						<Grid ColumnDefinitions="*,Auto,Auto,Auto">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_ai_assembler_free_edit_insert_remove_modify_jump_c825518a}" VerticalAlignment="Center" />
							<Button Grid.Column="1" Classes="secondaryAction" Click="Button_ValidateAsm" Content="{x:Static res:Strings.AiEditorValidate}" />
							<Button Grid.Column="2" Margin="8,0,0,0" Classes="secondaryAction" Click="Button_AutoFixAsm" Content="{x:Static res:Strings.U_tentar_consertar_07d98ca7}" />
							<Button Grid.Column="3" Margin="8,0,0,0" Classes="secondaryAction" Click="Button_SaveAsm" Content="{x:Static res:Strings.AiEditorSaveStructure}" />
						</Grid>
						<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding AssemblerSummary}" />
						<Grid ColumnDefinitions="Auto,120,Auto,120,Auto,Auto" >
							<TextBlock Classes="muted" Text="{x:Static res:Strings.U_opcode_c6c4b89b}" VerticalAlignment="Center" Margin="0,0,8,0" />
							<TextBox AutomationProperties.Name="{x:Static res:Strings.AiEditorOpcodeLabel}" Grid.Column="1" Watermark="{x:Static res:Strings.U_hex_e_g_1c_a61dcb38}" Text="{Binding InsertOpcodeHex, Mode=TwoWay}"
							         FontFamily="Cascadia Mono,Consolas,Monospace" />
							<TextBlock Grid.Column="2" Classes="muted" Text="{x:Static res:Strings.U_operand_fe4bd618}" VerticalAlignment="Center" Margin="12,0,8,0" />
							<TextBox AutomationProperties.Name="{x:Static res:Strings.AiEditorOperandLabel}" Grid.Column="3" Watermark="{x:Static res:Strings.U_hex_if_any_1f4c56c2}" Text="{Binding InsertOperandHex, Mode=TwoWay}"
							         FontFamily="Cascadia Mono,Consolas,Monospace" />
							<Button Grid.Column="4" Margin="12,0,0,0" Classes="secondaryAction" Click="Button_InsertAsm" Content="{x:Static res:Strings.AiEditorInsertAfter}" />
							<Button Grid.Column="5" Margin="8,0,0,0" Classes="secondaryAction" Click="Button_RemoveAsm" Content="{x:Static res:Strings.AiEditorRemoveRestore}" />
						</Grid>
						<TextBox AutomationProperties.Name="{x:Static res:Strings.CommonPreview}" Text="{Binding AssemblerPreview}"
						         IsReadOnly="True"
						         AcceptsReturn="True"
						         TextWrapping="NoWrap"
						         MinHeight="48"
						         MaxHeight="90"
						         FontFamily="Cascadia Mono,Consolas,Monospace" />
						<TextBlock Classes="muted" Text="{x:Static res:Strings.U_validation_pre_flight_sem_escrever_no_disco_save_9ec1766a}" />
						<TextBox AutomationProperties.Name="{x:Static res:Strings.CommonValidation}" Text="{Binding ValidationReport}"
						         IsReadOnly="True"
						         AcceptsReturn="True"
						         TextWrapping="NoWrap"
						         MinHeight="48"
						         MaxHeight="160"
						         FontFamily="Cascadia Mono,Consolas,Monospace" />
							<ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto">
							<ListBox AutomationProperties.Name="{x:Static res:Strings.AiAtelInstructionsLabel}" ItemsSource="{Binding AssemblerInstructions}"
							         SelectedItem="{Binding SelectedAssemblerRow, Mode=TwoWay}">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="220,70,90,*,Auto" Margin="0,0,0,2">
											<TextBlock Text="{Binding Label}" VerticalAlignment="Center"
											           FontFamily="Cascadia Mono,Consolas,Monospace" />
											<TextBox AutomationProperties.Name="{x:Static res:Strings.AiEditorOpcodeLabel}" Grid.Column="1" Text="{Binding OpcodeHex, Mode=TwoWay}"
											         FontFamily="Cascadia Mono,Consolas,Monospace" />
											<TextBox AutomationProperties.Name="{x:Static res:Strings.AiEditorOperandLabel}" Grid.Column="2" Margin="6,0,0,0" Text="{Binding OperandHex, Mode=TwoWay}"
											         FontFamily="Cascadia Mono,Consolas,Monospace" />
											<TextBlock Grid.Column="3" Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0"
												           Text="{Binding ReadableText}" ToolTip.Tip="{Binding OpcodeHelp}"
												           FontFamily="Cascadia Mono,Consolas,Monospace" />
												<CheckBox Grid.Column="4" Margin="10,0,0,0" Content="{x:Static res:Strings.U_remove_db998458}"
											          IsChecked="{Binding Removed, Mode=TwoWay}" />
										</Grid>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</StackPanel>
					</Expander>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}" Classes="card">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_devkit_modelos_estruturais_de_comportamento_690567b4}" />
						<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding LibrarySummary}" />
						<Grid ColumnDefinitions="2*,5*">
							<ScrollViewer Grid.Column="0" MaxHeight="280">
								<ListBox AutomationProperties.Name="{x:Static res:Strings.CommonType}" ItemsSource="{Binding LibrarySnippets}"
								         SelectedItem="{Binding SelectedSnippet, Mode=TwoWay}">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<Border Margin="0,0,0,6" Padding="{DynamicResource SpacingSm}" Classes="cardSoft">
												<StackPanel Spacing="2">
													<TextBlock Classes="sectionLabel" Text="{Binding CategoryLabel}" />
													<TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
												</StackPanel>
											</Border>
										</DataTemplate>
									</ListBox.ItemTemplate>
								</ListBox>
							</ScrollViewer>
							<StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="10">
								<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding SelectedSnippet.Description}" />
								<Grid ColumnDefinitions="Auto,150,*" IsVisible="{Binding TemplateUsesCommand}">
									<TextBlock Classes="muted" Text="{x:Static res:Strings.U_command_1925f793}" VerticalAlignment="Center" Margin="0,0,8,0" />
									<ComboBox AutomationProperties.Name="{x:Static res:Strings.CommonCategory}" Grid.Column="1" HorizontalAlignment="Stretch"
									          ItemsSource="{Binding CommandCategories}"
									          SelectedItem="{Binding TemplateCommandCategory, Mode=TwoWay}" />
									<ComboBox AutomationProperties.Name="{x:Static res:Strings.AiEditorAbilityLabel}" Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Stretch" MaxDropDownHeight="360"
									          ItemsSource="{Binding TemplateCommandOptions}"
									          SelectedItem="{Binding TemplateCommandOption, Mode=TwoWay}">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Display}" FontFamily="Cascadia Mono,Consolas,Monospace" />
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</Grid>
								<Grid ColumnDefinitions="Auto,160" IsVisible="{Binding TemplateUsesValue}">
									<TextBlock Classes="muted" Text="{Binding TemplateValueLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
									<TextBox AutomationProperties.Name="{x:Static res:Strings.CommonValue}" Grid.Column="1" Text="{Binding TemplateValue, Mode=TwoWay}"
									         FontFamily="Cascadia Mono,Consolas,Monospace" />
								</Grid>
								<Grid ColumnDefinitions="Auto,160" IsVisible="{Binding TemplateUsesValue2}">
									<TextBlock Classes="muted" Text="{Binding TemplateValue2Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
									<TextBox AutomationProperties.Name="{x:Static res:Strings.CommonValue}" Grid.Column="1" Text="{Binding TemplateValue2, Mode=TwoWay}"
									         FontFamily="Cascadia Mono,Consolas,Monospace" />
								</Grid>
								<Grid ColumnDefinitions="Auto,*,Auto,120" IsVisible="{Binding TemplateIsGuarded}">
									<TextBlock Classes="muted" Text="{x:Static res:Strings.U_hook_6bab147e}" VerticalAlignment="Center" Margin="0,0,8,0" />
									<ComboBox AutomationProperties.Name="{x:Static res:Strings.AiEditorWorkerLabel}" Grid.Column="1" HorizontalAlignment="Stretch"
									          ItemsSource="{Binding TemplateWorkers}"
									          SelectedItem="{Binding SelectedTemplateWorker, Mode=TwoWay}">
										<ComboBox.ItemTemplate>
											<DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
									<TextBlock Grid.Column="2" Classes="muted" Text="{x:Static res:Strings.CommonEntrypoint}" VerticalAlignment="Center" Margin="12,0,8,0" />
									<ComboBox AutomationProperties.Name="{x:Static res:Strings.CommonEntrypoint}" Grid.Column="3" ItemsSource="{Binding TemplateEntrypoints}"
									          SelectedItem="{Binding SelectedTemplateEntrypoint, Mode=TwoWay}" />
								</Grid>
								<TextBox AutomationProperties.Name="{x:Static res:Strings.CommonPreview}" Text="{Binding TemplatePreview}" IsReadOnly="True" AcceptsReturn="True"
								         TextWrapping="NoWrap" MinHeight="72" MaxHeight="200"
								         FontFamily="Cascadia Mono,Consolas,Monospace" />
								<Button HorizontalAlignment="Left" Classes="secondaryAction"
								        Click="Button_InsertTemplate" Content="{Binding TemplateActionLabel}" />
							</StackPanel>
						</Grid>
					</StackPanel>
				</Border>

				<Border Padding="4,2,4,4" Classes="card">
					<Expander Header="{x:Static res:Strings.U_disassembly_atel_completo_tecnico_de3dcdf7}" IsExpanded="False" HorizontalAlignment="Stretch">
					<StackPanel Spacing="12" Margin="0,8,0,0">
						<TextBox AutomationProperties.Name="{x:Static res:Strings.AiAtelInstructionsLabel}" Text="{Binding SelectedDisassembly}"
						         IsReadOnly="True"
						         AcceptsReturn="True"
						         TextWrapping="NoWrap"
						         MinHeight="420"
						         FontFamily="Cascadia Mono,Consolas,Monospace" />
					</StackPanel>
					</Expander>
				</Border>
						</StackPanel>
					</Expander>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
    </ThemeVariantScope>
</UserControl>
