<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:FFXProjectEditor"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:rsp="clr-namespace:FFXProjectEditor.Styles"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1260"
             d:DesignHeight="760"
             rsp:Responsive.Breakpoints="True"
             x:Class="FFXProjectEditor.CtbBaseEditor_Control">

	<!-- Jarvis-UI Fase E §E1 (v2.161.1.0): migrate hand-rolled Auto,* grid → ModuleMasterDetail_Shell.
	     O Border card Padding=16 MinWidth=280 inchado vira o slot MasterHeader+MasterList do shell
	     (denso, Padding=8, Expander colapsável). O ScrollViewer detail vira o slot Detail.
	    DataContext, bindings, handlers e IRestorableModule (D2) inalterados. -->

	<UserControl.Styles>
        <StyleInclude Source="avares://FFXProjectEditor/Styles/EditorForms.axaml" />
		<Style Selector=":is(UserControl).narrow common|ModuleMasterDetail_Shell">
			<Setter Property="IsMasterExpanded" Value="False" />
		</Style>
	</UserControl.Styles>

	<common:ModuleMasterDetail_Shell MasterHeaderLabel="CTB Base">

		<!-- ===== MASTER: header card + filter + ListBox ===== -->
		<common:ModuleMasterDetail_Shell.MasterHeader>
			<StackPanel Spacing="8" Margin="2,0,2,2">
				<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_battle_timing_kernel_d9414cba}" />
				<TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
				           Text="{x:Static res:Strings.U_edit_the_agility_to_tickspeed_icv_table_from_ctb_5c9f4fcb}" />
			</StackPanel>
		</common:ModuleMasterDetail_Shell.MasterHeader>

		<common:ModuleMasterDetail_Shell.MasterList>
			<Grid RowDefinitions="Auto,*" Margin="0,0,0,0">
				<StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
					<StackPanel Spacing="8">
						<TextBox Watermark="{x:Static res:Strings.U_filter_by_agility_or_summary_bc9991c7}"
						         Text="{Binding FilterText, Mode=TwoWay}" />
						<Button HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_Refresh"
						        AutomationProperties.Name="Refresh CTB base rows">Refresh</Button>
					</StackPanel>
					<TextBlock Classes="muted" FontSize="11" Text="{Binding LoadSummary}" />
				</StackPanel>

				<ListBox Grid.Row="1"
				         ScrollViewer.VerticalScrollBarVisibility="Visible"
				         ScrollViewer.AllowAutoHide="False"
				         ItemsSource="{Binding DisplayedRows}"
				         SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,4" Padding="8,6" Background="Transparent" CornerRadius="6">
								<StackPanel Spacing="4">
									<TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding AgilityLabel}" />
									<TextBlock Classes="muted" FontSize="11" Text="{Binding Summary}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</common:ModuleMasterDetail_Shell.MasterList>

		<!-- ===== DETAIL: hero + session + editor ===== -->
		<common:ModuleMasterDetail_Shell.Detail>
			<DockPanel>
				<!-- SESSION CONTROLS (Pinned to Top) -->
				<Border DockPanel.Dock="Top" Margin="0,0,0,18" Padding="{DynamicResource SpacingLg}" Classes="card">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
						<StackPanel Spacing="10">
							<StackPanel Spacing="2" VerticalAlignment="Center">
								<TextBlock Text="{Binding EditSession.SessionSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
								<TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
							</StackPanel>
<WrapPanel>
							<core:AutoSaveIndicator_Control Margin="0,0,12,6" VerticalAlignment="Center" Session="{Binding EditSession}" />
							<CheckBox Margin="0,0,12,6" VerticalAlignment="Center" IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
							<Button Margin="0,0,12,6" VerticalAlignment="Center" Classes="secondaryAction" IsEnabled="{Binding EditSession.CanUndo}" Click="Button_Undo">Undo</Button>
							<Button Margin="0,0,12,6" VerticalAlignment="Center" IsEnabled="{Binding EditSession.HasPendingChanges}" Click="Button_Save" Content="{x:Static res:Strings.CommonSave}" />
						</WrapPanel>
</StackPanel>
					</StackPanel>
				</Border>

				<!-- SCROLLABLE CONTENT -->
				<ScrollViewer Margin="0,0,0,0" HorizontalScrollBarVisibility="Disabled"
				              Background="{DynamicResource AppSurfaceBrush}"
				              IsVisible="{Binding SelectedRow, Converter={x:Static ObjectConverters.IsNotNull}}">
					<StackPanel Classes="editorContent" Spacing="14" Margin="10,0,10,10">
						<Border Padding="{DynamicResource SpacingXl}" Classes="card heroTeal">
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_ctb_timing_surface_b8d3c997}" />
								<TextBlock FontSize="28" FontWeight="Bold" Text="{Binding SelectedRow.AgilityLabel}" />
								<TextBlock Classes="muted" Text="{Binding SelectedSummary}" TextWrapping="Wrap" />
							</StackPanel>
						</Border>



					<Border Padding="{DynamicResource SpacingLg}" Classes="card">
						<StackPanel Spacing="12">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_timing_editor_cf176887}" />
							<TextBlock Classes="cardTitle" Text="{Binding SelectedRow.Summary}" />
							<TextBlock Classes="muted" Text="{x:Static res:Strings.U_ffxdataparser_proves_each_row_as_two_bytes_ticks_2d4b9c7f}" TextWrapping="Wrap" />

							<UniformGrid Classes="editorFields summaryFields">
								<StackPanel Spacing="8">
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_tickspeed_1ee0dd79}" />
									<TextBox Classes="numField" Text="{Binding SelectedRow.TickSpeed, Mode=TwoWay}" />
								</StackPanel>
								<StackPanel Spacing="8">
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_icv_bonus_5f5c70d8}" />
									<TextBox Classes="numField" Text="{Binding SelectedRow.IcvBonus, Mode=TwoWay}" />
								</StackPanel>
								<Border Padding="{DynamicResource SpacingMd}">
									<StackPanel Spacing="6">
										<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_derived_range_5b6e41e3}" />
										<TextBlock FontWeight="SemiBold" Text="{Binding SelectedRow.AgilityLabel}" />
										<TextBlock Classes="muted" Text="{Binding SelectedRow.Summary}" TextWrapping="Wrap" />
										<TextBlock Classes="muted" Text="{Binding SelectedRow.IcvMin, StringFormat='Min ICV: {0}'}" />
										<TextBlock Classes="muted" Text="{Binding SelectedRow.IcvMax, StringFormat='Max ICV: {0}'}" />
									</StackPanel>
								</Border>
							</UniformGrid>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
			</DockPanel>
		</common:ModuleMasterDetail_Shell.Detail>

	</common:ModuleMasterDetail_Shell>
</UserControl>
