<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:FFXProjectEditor.Converters"
             xmlns:local="clr-namespace:FFXProjectEditor.Modules.BattleKernel.Commands"
             xmlns:core="clr-namespace:FFXProjectEditor"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:rsp="clr-namespace:FFXProjectEditor.Styles"
             xmlns:ctrl="clr-namespace:FFXProjectEditor.Controls"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d" d:DesignWidth="1500" d:DesignHeight="860"
             rsp:Responsive.Breakpoints="True"
             x:Class="FFXProjectEditor.KernelCommands_Control"
             Name="ThisControl">

    <!-- Jarvis-UI Fase E §E12 (v2.161.5.0): migrate the repo's largest detail (3-col + session bar) ->
         ModuleMasterDetail_Shell. MAIOR DETAIL DO REPO, maior risco de regressao visual.
         Decisao arquitetural (doc §3.E12):
           - manter outer RowDefinitions="Auto,*": a TOP SESSION BAR fica ACIMA do shell (row 0);
           - shell na row 1 com MasterList = command ListBox (era Col0), Detail = editor (era Col1);
           - a 3a coluna "Where Used" (era Col2) vira um Expander colapsavel DENTRO do Detail
             (default colapsado) — preserva os x:Name (CommandList/MonsterLinksList) que o code-behind
             referencia por nome (MonsterLinksList.SelectedItem em OpenReferenceMonster).
         Hex inline -> tokens no mesmo commit:
           - #FF6B6B (LoadError foreground, L79) -> DangerBrush;
           - #1A2A3A background do Spira Ward note -> PanelDeepBrush;
           - #3A6EA5 border do Spira Ward note -> PanelStrokeBrush;
           - #7EC8FF / #B8D4E8 foreground do Spira Ward note -> AccentCoolBrush (token EXATO existe).
         DataContext, bindings, handlers, AutoSaveIndicator, converters, IRestorableModule (D2) e os
         x:Name (ThisControl/CommandList/MonsterLinksList) inalterados. -->

    <UserControl.Resources>
        <converters:Character_Converter x:Key="CharacterConverter"/>
        <converters:DamageFormula_Converter x:Key="DamageFormulaConverter"/>
        <local:HitCalcType_Converter x:Key="HitCalcTypeConverter"/>
		<SolidColorBrush x:Key="SystemRegionBrush" Color="Transparent"/>
		<SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="Transparent"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Responsividade: em telas estreitas o painel master recolhe por default. -->
        <Style Selector="UserControl.narrow common|ModuleMasterDetail_Shell">
            <Setter Property="IsMasterExpanded" Value="False" />
        </Style>
        <!-- Compact label + editor stack used inside the WrapPanels -->
        <Style Selector="StackPanel.field">
            <Setter Property="Width" Value="170" />
            <Setter Property="Margin" Value="0,0,12,10" />
                    </Style>
        <Style Selector="StackPanel.field > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style Selector="CheckBox.flag">
            <Setter Property="Width" Value="140" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#11FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCoolBrush}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="24" />
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="Background" Value="#11FFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentCoolBrush}" />
        </Style>

    </UserControl.Styles>

    <Grid>

        <!-- MAIN AREA: shell — session bar moved into Detail column to align with Identity panel,
             freeing vertical space for the Commands list (left column). -->
        <common:ModuleMasterDetail_Shell MasterHeaderLabel="Commands"
                                        Margin="18,16,18,16">

            <!-- ===== MASTER: command ListBox (era Col0) ===== -->
            <common:ModuleMasterDetail_Shell.MasterHeader>
                <StackPanel Spacing="4" Margin="2,0,2,2">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_commands_amp_ability_editor_7657bb24}" VerticalAlignment="Center" />
                        <ctrl:CapabilityBadge HorizontalAlignment="Left" Name="CommandCapabilityBadge" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                               Text="{x:Static res:Strings.U_edit_battle_commands_and_abilities_ability_comma_7da52c47}" />
                </StackPanel>
            </common:ModuleMasterDetail_Shell.MasterHeader>

            <common:ModuleMasterDetail_Shell.MasterList>
                <Grid RowDefinitions="Auto,Auto,Auto,*">
                    <WrapPanel Grid.Row="0"
                               Margin="0,0,0,6"
                               IsVisible="{Binding IsCommandListMutable}"
                               Orientation="Horizontal">
                        <Button Margin="0,0,8,6"
                                Classes="secondaryAction"
                                IsEnabled="{Binding CanCloneSelectedCommand}"
                                Click="Button_CloneCommand" AutomationProperties.Name="Clonar">Clonar</Button>
                        <Button Margin="0,0,8,6"
                                Classes="secondaryAction"
                                IsEnabled="{Binding CanDeleteSelectedCommand}"
                                Click="Button_DeleteCommand" AutomationProperties.Name="Apagar">Apagar</Button>
                        <Button Margin="0,0,0,6"
                                Classes="secondaryAction"
                                IsEnabled="{Binding CanAddCommand}"
                                Click="Button_AddCommand" AutomationProperties.Name="Adicionar">Adicionar</Button>
                    </WrapPanel>
                    <TextBox Grid.Row="1"
                             Margin="0,0,0,10"
                             Watermark="{x:Static res:Strings.U_filter_by_index_name_or_description_94de1c73}"
                             Text="{Binding FilterText}"
                             TextChanged="Filter_Changed" />
                    <TextBlock Grid.Row="2" Classes="muted" FontSize="11" Text="{Binding SelectedCommand.Name}" TextTrimming="CharacterEllipsis" />
                    <!-- x:Name=CommandList preservado: code-behind referencia o field gerado em filtros/restore -->
                    <ListBox Grid.Row="3"
                             Name="CommandList"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding DisplayedCommands}"
                             SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                             SelectionChanged="CommandList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2,0,2" Padding="10,6" Classes="cardSoft" HorizontalAlignment="Stretch">
                                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Margin="0,0,10,0"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   FontFamily="Consolas,Courier New,monospace"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Text="{Binding Index, StringFormat='#{0}'}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </common:ModuleMasterDetail_Shell.MasterList>

            <!-- ===== DETAIL: editor (era Col1) + Where Used como Expander colapsavel (era Col2) ===== -->
            <common:ModuleMasterDetail_Shell.Detail>
                <Grid RowDefinitions="Auto,*">
                    <!-- Session Controls (aligned with Identity panel below) -->
                    <Border Grid.Row="0" Margin="10,0,10,8" Padding="16,12" Classes="cardSoft">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EditSession.SessionSummary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <core:AutoSaveIndicator_Control Grid.Column="1"
                                                                Margin="12,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Session="{Binding EditSession}" />
                                <CheckBox Grid.Column="2"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
                                <Button Grid.Column="3"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="secondaryAction"
                                        IsEnabled="{Binding EditSession.CanUndo}"
                                        Click="Button_Undo" AutomationProperties.Name="Undo">Undo</Button>
                                <Button Grid.Column="4"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="dangerAction"
                                        IsEnabled="{Binding EditSession.HasPendingChanges}"
                                        Click="Button_Discard" AutomationProperties.Name="Discard">Discard</Button>
                                <Button Grid.Column="5"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="secondaryAction accentRefresh"
                                        IsEnabled="{Binding ProcService.IsAlive}"
                                        Click="Button_LoadIngame" AutomationProperties.Name="Load Ingame">Load Ingame</Button>
                                <Button Grid.Column="6"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Classes="primaryAction accentGold"
                                        IsEnabled="{Binding EditSession.HasPendingChanges}"
                                        Click="Button_Save" AutomationProperties.Name="Save">Save</Button>
                            </Grid>
                            <!-- Jarvis-UI §E12: hex #FF6B6B -> DangerBrush -->
                            <TextBlock Foreground="{DynamicResource DangerBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Text="{Binding LoadError}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch">
                    <Grid HorizontalAlignment="Stretch">
                        <!-- Empty state when no command selected (Jarvis-UI v2.190.2.0) -->
                        <Border IsVisible="{Binding !HasSelectedCommand}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Margin="20,40"
                                Padding="40"
                                CornerRadius="8"
                                Background="{DynamicResource PanelDeepBrush}"
                                BorderBrush="{DynamicResource PanelStrokeBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Classes="sectionLabel"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           Text="{x:Static res:Strings.U_no_command_selected_a24a3f8c}" />
                                <TextBlock Classes="muted"
                                           TextWrapping="Wrap"
                                           MaxWidth="500"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Text="{x:Static res:Strings.U_pick_a_command_on_the_left_to_start_editing_its__5d1d15c8}" />
                            </StackPanel>
                        </Border>
                        <!-- Detail content (visible when a command is selected) -->
                        <StackPanel Spacing="14" Margin="10"
                                    IsVisible="{Binding HasSelectedCommand}"
                                    HorizontalAlignment="Stretch">

                        <!-- Identity -->
                        <Border HorizontalAlignment="Stretch" Padding="{DynamicResource SpacingMd}" Classes="card heroGradient">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_identity_7e5a975b}" />
                                <!-- Stats chips (Jarvis-UI v2.190.2.0: hero stats pattern) -->
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Margin="0,0,6,4" Padding="8,3" CornerRadius="3"
                                            Background="{DynamicResource PanelDeepBrush}"
                                            BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="muted" FontSize="10" Text="{x:Static res:Strings.U_scope_4651a34e}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding CommandScope}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,4" Padding="8,3" CornerRadius="3"
                                            Background="{DynamicResource PanelDeepBrush}"
                                            BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="muted" FontSize="10" Text="{x:Static res:Strings.U_total_b25928c6}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding TotalCount}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,4" Padding="8,3" CornerRadius="3"
                                            Background="{DynamicResource PanelDeepBrush}"
                                            BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Classes="muted" FontSize="10" Text="{x:Static res:Strings.U_filtered_7b26f50a}" />
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding FilteredCount}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,0,6,4" Padding="8,3" CornerRadius="3"
                                            Background="#FF8C42"
                                            BorderBrush="#FF6B1F" BorderThickness="1"
                                            IsVisible="{Binding IsCommandListMutable}">
                                        <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#1A1A1A" Text="{x:Static res:Strings.U_writable_6cb10f41}" />
                                    </Border>
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                          <StackPanel Classes="field" Width="120">
<TextBlock Text="{x:Static res:Strings.CommonIndex}" />
<TextBox IsReadOnly="True" Text="{Binding SelectedCommand.Index}" />
</StackPanel>
                                    <TextBlock VerticalAlignment="Bottom"
                                               FontSize="16" FontWeight="SemiBold"
                                               Text="{Binding SelectedCommand.Name}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{x:Static res:Strings.CommonName}" />
                                    <TextBox Text="{Binding SelectedCommand.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="{x:Static res:Strings.U_nome_no_menu_de_batalha_d2722e9f}" />
                                </StackPanel>
                                <StackPanel Spacing="3">
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{x:Static res:Strings.CommonDescription}" />
                                    <TextBox Text="{Binding SelectedCommand.DisplayDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="{x:Static res:Strings.U_descricao_no_menu_de_batalha_02de36b4}"
                                             MaxHeight="64"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Classes="muted"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.U_edite_aqui_e_de_save_grava_direto_no_text_pool_e_14bc8af9}" />
                                <!-- Jarvis-UI §E12: hex #1A2A3A/#3A6EA5/#7EC8FF/#B8D4E8 -> tokens
                                     PanelDeepBrush/PanelStrokeBrush/AccentCoolBrush/AccentCoolBrush -->
                                <Border Padding="{DynamicResource SpacingMd}"
                                        CornerRadius="6"
                                        Background="{DynamicResource PanelDeepBrush}"
                                        BorderBrush="{DynamicResource PanelStrokeBrush}"
                                        BorderThickness="1"
                                        IsVisible="{Binding SelectedCommand.IsSpiraElementWard}">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentCoolBrush}"
                                                   Text="{x:Static res:Strings.U_spira_reforge_element_ward_9c460d88}" />
                                        <TextBlock Foreground="{DynamicResource AccentCoolBrush}"
                                                   FontSize="11"
                                                   Text="{Binding SelectedCommand.SpiraWardHookNote}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Animations -->
                        <Border HorizontalAlignment="Stretch" Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_animations_c77dcded}" />
                                <WrapPanel Orientation="Horizontal">
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_anim_1_id_8802dc99}" />
<TextBox Text="{Binding SelectedCommand.Anim1Id}" />
</StackPanel>
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_anim_2_id_27ade6a7}" />
<TextBox Text="{Binding SelectedCommand.Anim2Id}" />
</StackPanel>
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_icon_id_bfd551b6}" />
<TextBox Text="{Binding SelectedCommand.IconId}" />
</StackPanel>
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_caster_anim_id_021a64b3}" />
<TextBox Text="{Binding SelectedCommand.CasterAnimId}" />
</StackPanel>
                                </WrapPanel>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto">
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding Anim1EffectSummary}"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Classes="secondaryAction"
                                            IsEnabled="{Binding CanViewAnim1Effect}"
                                            Click="Button_ViewAnim1Effect" AutomationProperties.Name="View Anim 1">View Anim 1</Button>
                                    <Button Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Classes="secondaryAction"
                                            IsEnabled="{Binding Anim1EffectAvailable}"
                                            Click="Button_OpenAnim1EffectFolder" AutomationProperties.Name="Open Folder">Open Folder</Button>

                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding Anim2EffectSummary}"
                                               TextWrapping="Wrap" />
                                    <Button Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="10,8,0,0"
                                            Classes="secondaryAction"
                                            IsEnabled="{Binding CanViewAnim2Effect}"
                                            Click="Button_ViewAnim2Effect" AutomationProperties.Name="View Anim 2">View Anim 2</Button>
                                    <Button Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="8,8,0,0"
                                            Classes="secondaryAction"
                                            IsEnabled="{Binding Anim2EffectAvailable}"
                                            Click="Button_OpenAnim2EffectFolder" AutomationProperties.Name="Open Folder">Open Folder</Button>
                                </Grid>
                                <TextBlock Classes="muted"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Text="{x:Static res:Strings.U_preview_opens_the_selected_magic_in_ps3_magic_hd_64c0e6bc}" />
                            </StackPanel>
                        </Border>

                        <!-- Battle SFX — collapsible tiers -->
                        <Expander Header="{x:Static res:Strings.U_battle_sfx_custom_audio_7b83f526}" IsExpanded="False">
                            <Border HorizontalAlignment="Stretch" Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{Binding BattleSfxSummary}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BattleSfxMapStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BattleSfxRt2Status}" Classes="muted" FontSize="11" />
                                    <WrapPanel Orientation="Horizontal">
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_magic_dll_4fd75e91}" />
<TextBox IsReadOnly="True" Text="{Binding BattleSfxMagicIdDisplay}" />
</StackPanel>
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_fmod_seid_current_6ee3f317}" />
<TextBox IsReadOnly="True" Text="{Binding BattleSfxSeIdDisplay}" />
</StackPanel>
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_spu_wavedataid_d2eac20a}" />
<TextBox IsReadOnly="True" Text="{Binding BattleSfxWaveIdDisplay}" />
</StackPanel>
                                          <StackPanel Classes="field" Width="120">
<TextBlock Text="{x:Static res:Strings.U_fsb_sample_5fbb67fa}" />
<TextBox IsEnabled="{Binding CanEditBattleSfx}" Text="{Binding BattleSfxFsbSampleIndex}" />
</StackPanel>
                                        <Button Margin="0,24,4,0" Classes="secondaryAction"
                                                IsEnabled="{Binding CanEditBattleSfx}"
                                                Command="{Binding NudgeBattleSfxFsbSamplePrevCommand}"
                                                AutomationProperties.Name="Previous FSB sample">◀</Button>
                                        <Button Margin="0,24,8,0" Classes="secondaryAction"
                                                IsEnabled="{Binding CanEditBattleSfx}"
                                                Command="{Binding NudgeBattleSfxFsbSampleNextCommand}"
                                                AutomationProperties.Name="Next FSB sample">▶</Button>
                                    </WrapPanel>

                                    <Expander Header="{x:Static res:Strings.U_tier_1_donor_seid_remap_dll_only_af02525c}" IsExpanded="False">
                                        <StackPanel Spacing="10" Margin="0,8,0,0">
                                          <Grid Classes="fieldGrid" ColumnDefinitions="*, 50" Width="520">
                                              <TextBlock Text="{x:Static res:Strings.U_donor_sound_magic_dll_seid_6c9aa9ae}" />
                                              <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                                          IsEnabled="{Binding CanEditBattleSfx}"
                                                          ItemsSource="{Binding BattleSfxDonorOptions}"
                                                          SelectedItem="{Binding SelectedBattleSfxDonor}">

                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Display}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                
                                              </ComboBox>
                                          </Grid>
                                          <StackPanel Classes="field" Width="120">
<TextBlock Text="{x:Static res:Strings.U_sesep_record_index_a13e8823}" />
<TextBox IsEnabled="{Binding CanEditBattleSfx}" Text="{Binding BattleSfxRecordIndex}" />
</StackPanel>
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0" Classes="secondaryAction"
                                                        IsEnabled="{Binding CanEditBattleSfx}"
                                                        Command="{Binding PreviewBattleSfxPatchCommand}" AutomationProperties.Name="Preview patch">Preview patch</Button>
                                                <Button Margin="0,0,8,0" Classes="secondaryAction"
                                                        IsEnabled="{Binding CanEditBattleSfx}"
                                                        Command="{Binding StageBattleSfxPackCommand}" AutomationProperties.Name="Stage pack">Stage pack</Button>
                                                <Button Margin="0,0,8,0" Classes="primaryAction"
                                                        IsEnabled="{Binding CanEditBattleSfx}"
                                                        Command="{Binding DeployBattleSfxPackCommand}" AutomationProperties.Name="Deploy DLL">Deploy DLL</Button>
                                                <Button Classes="secondaryAction"
                                                        IsEnabled="{Binding CanEditBattleSfx}"
                                                        Command="{Binding RestoreBattleSfxBackupCommand}" AutomationProperties.Name="Restore backup">Restore backup</Button>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding BattleSfxActionStatus}" TextWrapping="Wrap" FontSize="11" />
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="{x:Static res:Strings.U_tier_2a_custom_wav_replace_fsb_sample_fb30511f}" IsExpanded="False">
                                        <StackPanel Spacing="10" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding BattleSfxCustomStatus}" TextWrapping="Wrap" FontSize="11" />
                                            <TextBlock Text="{Binding BattleSfxAudioToolsHealth}" TextWrapping="Wrap" FontSize="11" Classes="muted" />
                                            <TextBlock IsVisible="{Binding BattleSfxCustomToolsMissing}"
                                                       Classes="muted"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Text="{x:Static res:Strings.U_vgmstream_fsbext_ship_with_the_editor_under_tool_b27f28d1}" />
                                            <WrapPanel Orientation="Horizontal">
                                                <Button Margin="0,0,8,0" Classes="secondaryAction"
                                                        Command="{Binding VerifyBattleAudioToolsCommand}" AutomationProperties.Name="Verify audio tools">Verify audio tools</Button>
                                                <Button Margin="0,0,8,0" Classes="secondaryAction"
                                                        IsEnabled="{Binding BattleSfxCustomToolsReady}"
                                                        Click="Button_ImportCustomWav"
                                                        AutomationProperties.Name="Import custom WAV">Import WAV…</Button>
                                            </WrapPanel>
                                          <StackPanel Classes="field" Width="520">
