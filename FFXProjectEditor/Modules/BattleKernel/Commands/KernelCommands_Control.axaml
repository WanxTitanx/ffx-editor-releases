                        <!-- Status Special / Buffs (flag-heavy, collapsed) -->
                        <Expander Header="{x:Static res:Strings.U_status_special_buffs_d97901c9}" IsExpanded="False">
                            <Border HorizontalAlignment="Stretch" Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_special_statuses_063942a1}" />
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermScan}" IsChecked="{Binding SelectedCommand.FlagStatusScan}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermDistillPower}" IsChecked="{Binding SelectedCommand.FlagStatusDistillPower}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermDistillMana}" IsChecked="{Binding SelectedCommand.FlagStatusDistillMana}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermDistillSpeed}" IsChecked="{Binding SelectedCommand.FlagStatusDistillSpeed}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_distill_unused_5893022d}" IsChecked="{Binding SelectedCommand.FlagStatusDistillUnused}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermDistillAbility}" IsChecked="{Binding SelectedCommand.FlagStatusDistillAbility}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermShield}" IsChecked="{Binding SelectedCommand.FlagStatusShield}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermBoost}" IsChecked="{Binding SelectedCommand.FlagStatusBoost}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermEject}" IsChecked="{Binding SelectedCommand.FlagStatusEject}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_autolife_c49c1464}" IsChecked="{Binding SelectedCommand.FlagStatusAutoLife}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermCurse}" IsChecked="{Binding SelectedCommand.FlagStatusCurse}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermDefend}" IsChecked="{Binding SelectedCommand.FlagStatusDefend}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermGuard}" IsChecked="{Binding SelectedCommand.FlagStatusGuard}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermSentinel}" IsChecked="{Binding SelectedCommand.FlagStatusSentinel}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermDoom}" IsChecked="{Binding SelectedCommand.FlagStatusDoom}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_stat_buffs_8b001df8}" />
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_cheer_8c95fa0d}" IsChecked="{Binding SelectedCommand.FlagStatBuffCheer}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_aim_cf4f1fe5}" IsChecked="{Binding SelectedCommand.FlagStatBuffAim}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.CommonFocus}" IsChecked="{Binding SelectedCommand.FlagStatBuffFocus}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_reflex_4f2a9d70}" IsChecked="{Binding SelectedCommand.FlagStatBuffReflex}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.TermLuck}" IsChecked="{Binding SelectedCommand.FlagStatBuffLuck}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_jinx_b3c74c59}" IsChecked="{Binding SelectedCommand.FlagStatBuffJinx}" />
                                        </WrapPanel>
                                        <WrapPanel Orientation="Horizontal">
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_stat_buff_value_5420d7dd}" />
<TextBox Text="{Binding SelectedCommand.StatBuffValue}" />
</StackPanel>
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_special_buffs_57a6e58e}" />
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_double_hp_5575f972}" IsChecked="{Binding SelectedCommand.FlagSpecialBuffDoubleHp}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_double_mp_23efe4f1}" IsChecked="{Binding SelectedCommand.FlagSpecialBuffDoubleMp}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_mp_cost_0_60b1829f}" IsChecked="{Binding SelectedCommand.FlagSpecialBuffMpCost0}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_quartet_7310decb}" IsChecked="{Binding SelectedCommand.FlagSpecialBuffQuartet}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_always_crit_4382fdd9}" IsChecked="{Binding SelectedCommand.FlagSpecialBuffAlwaysCrit}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_overdrive_150_b5bc7e06}" IsChecked="{Binding SelectedCommand.FlagSpecialBuffOverdrive150}" />
                                            <CheckBox Classes="flag" Content="{x:Static res:Strings.U_overdrive_200_f31c942e}" IsChecked="{Binding SelectedCommand.FlagSpecialBuffOverdrive200}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- Extra (only meaningful when the file carries extra info) -->
                        <Expander Header="{x:Static res:Strings.CommonExtra}" IsExpanded="False" IsEnabled="{Binding IsExtraEnabled}">
                            <Border HorizontalAlignment="Stretch" Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonExtra}" />
                                    <WrapPanel Orientation="Horizontal">
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_ordering_index_in_menu_da4a325f}" />
<TextBox Text="{Binding SelectedCommand.ExtraInfo.OrderingIndexInMenu}" />
</StackPanel>
                                          <StackPanel Classes="field" Width="170">
<TextBlock Text="{x:Static res:Strings.U_sphere_type_for_sphere_grid_d3c53da8}" />
<TextBox Text="{Binding SelectedCommand.ExtraInfo.SphereTypeForSphereGrid}" />
</StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Expander>

                        <!-- WHERE USED / MONSTER LINKS (era Col2): Expander colapsavel DENTRO do Detail.
                             Default colapsado pra o editor de campos nao competir com a lista de referencias.
                             x:Name=MonsterLinksList preservado: code-behind faz MonsterLinksList.SelectedItem
                             em OpenReferenceMonster (field gerado pelo AvaloniaXamlLoader). -->
                        <Expander Header="{x:Static res:Strings.U_where_used_monster_links_349049cd}" IsExpanded="False">
                            <StackPanel Spacing="14" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                <Border HorizontalAlignment="Stretch" Padding="18" Classes="card heroGradient">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_where_used_28f0b7d1}" />
                                        <TextBlock FontSize="20" FontWeight="Bold" Text="{Binding SelectedCommand.Name}" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding SelectedCommandSummary}" TextWrapping="Wrap" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding SelectedCommandReferenceSummary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border HorizontalAlignment="Stretch" Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
                                    <StackPanel Spacing="10">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_reference_notes_5928d902}" />
                                        <TextBlock Classes="muted" FontSize="11" Text="{Binding SelectedCommandReferenceNotes}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border HorizontalAlignment="Stretch" Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
                                    <StackPanel Spacing="12">
                                        <TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_monster_links_f80ef20b}" />
                                        <TextBlock Classes="muted"
                                                   FontSize="11"
                                                   Text="{x:Static res:Strings.U_jarvis_is_listing_every_currently_indexed_monste_d1ff0c7c}"
                                                   TextWrapping="Wrap" />

                                        <ListBox Name="MonsterLinksList"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 ItemsSource="{Binding SelectedCommandReferences}"
                                                 SelectedItem="{Binding SelectedCommandReference, Mode=TwoWay}"
                                                 SelectionChanged="MonsterLinks_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6"
                                                            Padding="10"
                                                            Classes="cardSoft"
                                                            DoubleTapped="MonsterLink_DoubleTapped">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{x:Static res:Strings.U_go_to_monster_6d8ed146}"
                                                                          Click="MenuItem_OpenReferenceMonster"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding MonsterLabel}" />
                                                            <TextBlock Classes="muted" FontSize="11" Text="{Binding Summary}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Classes="muted"
                                                   FontSize="11"
                                                   IsVisible="{Binding HasSelectedCommandReferences}"
                                                   Text="{x:Static res:Strings.U_cross_check_these_references_before_rebalancing__ebb26618}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </common:ModuleMasterDetail_Shell.Detail>
        </common:ModuleMasterDetail_Shell>
    </Grid>

</UserControl>
