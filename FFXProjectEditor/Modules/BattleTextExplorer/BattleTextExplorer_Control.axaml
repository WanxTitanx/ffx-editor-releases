<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1380"
             d:DesignHeight="760"
             x:Class="FFXProjectEditor.BattleTextExplorer_Control">

	<ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
	<Grid MinWidth="920">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*" MinWidth="240" />
			<ColumnDefinition Width="3*" MinWidth="320" />
			<ColumnDefinition Width="4*" MinWidth="360" />
		</Grid.ColumnDefinitions>
		<Border Grid.Column="0" Margin="18,18,0,18" Padding="{DynamicResource SpacingLg}" Classes="card">
			<Grid RowDefinitions="Auto,Auto,*">
				<StackPanel Spacing="8">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_battle_text_efe8aa3a}" />
					<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_battle_text_explorer_39efaf07}" />
					<TextBlock Classes="muted" Text="{x:Static res:Strings.U_edit_battle_text_lines_in_btl_txt_bin_control_co_02259a6e}" TextWrapping="Wrap" />
				</StackPanel>

				<StackPanel Grid.Row="1" Margin="0,14,0,14" Spacing="10">
					<Button HorizontalAlignment="Left" Classes="secondaryAction" Click="Button_Refresh">Refresh</Button>
					<TextBlock Classes="muted" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
				</StackPanel>

				<ListBox Grid.Row="2"
						 ItemsSource="{Binding LoadedSources}"
						 SelectedItem="{Binding SelectedSource, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,10" Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
								<StackPanel Spacing="4">
									<TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding DisplayName}" />
									<TextBlock Classes="muted" Text="{Binding Summary}" />
									<TextBlock Classes="muted" Text="{Binding RelativePath}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>

		<Border Grid.Column="1" Margin="18" Padding="{DynamicResource SpacingLg}" Classes="card">
			<Grid RowDefinitions="Auto,Auto,*">
				<StackPanel Spacing="8">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_lines_c6fd3870}" />
					<TextBlock Classes="cardTitle" Text="{Binding SelectedSource.DisplayName}" />
					<TextBlock Classes="muted" Text="{Binding SelectedSourceSummary}" TextWrapping="Wrap" />
				</StackPanel>

				<TextBox Grid.Row="1"
						 Margin="0,14,0,14"
						 Watermark="{x:Static res:Strings.U_filter_by_index_slot_or_decoded_text_fb79d206}"
						 Text="{Binding FilterText, Mode=TwoWay}" />

				<ListBox Grid.Row="2"
						 ItemsSource="{Binding DisplayedRows}"
						 SelectedItem="{Binding SelectedRow, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,8" Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
								<StackPanel Spacing="4">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Classes="sectionLabel" Text="{Binding EntryLabel}" />
										<TextBlock Classes="sectionLabel" Text="{Binding SlotLabel}" />
									</StackPanel>
									<TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</Border>

		<ScrollViewer Grid.Column="2" Margin="0,18,18,18" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="14">
				<Border Padding="{DynamicResource SpacingXl}" Classes="card heroGradient">
					<StackPanel Spacing="8">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_selected_line_fe8df68c}" />
						<TextBlock FontSize="26" FontWeight="Bold" Text="{Binding SelectedRow.RowLabel}" />
						<TextBlock Classes="muted" Text="{Binding SelectedRowSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}" Classes="card">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
						<TextBlock Classes="muted" Text="{Binding EditorScopeSummary}" TextWrapping="Wrap" />
						<TextBlock Text="{Binding EditSession.SessionSummary}" TextWrapping="Wrap" />
						<TextBlock Classes="muted" Text="{Binding EditSession.BehaviorSummary}" TextWrapping="Wrap" />
						<WrapPanel>
							<Button Margin="0,0,8,8" Classes="secondaryAction" Click="Button_Undo" IsEnabled="{Binding CanUndoCurrentSource}">Undo</Button>
							<Button Margin="0,0,8,8" Classes="secondaryAction" Click="Button_Discard" IsEnabled="{Binding CanDiscardCurrentSource}">Discard</Button>
							<Button Margin="0,0,8,8" Classes="secondaryAction" Click="Button_Save" IsEnabled="{Binding CanSaveCurrentSource}">Save</Button>
						</WrapPanel>
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}" Classes="card">
					<StackPanel Spacing="6">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonValidation}" />
						<TextBlock Text="{Binding ValidationSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}" Classes="card">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_line_text_c0a2834a}" />
						<TextBlock Classes="muted" Text="{x:Static res:Strings.U_control_codes_are_shown_as_lt_cn_gt_lt_cn_p_gt_t_4f6ee156}" TextWrapping="Wrap" />
						<TextBox Text="{Binding SelectedRow.Text, Mode=TwoWay}" IsReadOnly="{Binding IsSelectedRowReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" FontFamily="Cascadia Mono,Consolas,monospace" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
	</Grid>
	</ScrollViewer>
</UserControl>
