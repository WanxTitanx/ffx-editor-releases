<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:FFXProjectEditor"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1260"
             d:DesignHeight="760"
             x:Class="FFXProjectEditor.BlitzballPrizesEditor_Control">

	<UserControl.Styles>
		<Style Selector="UserControl.narrow common|ModuleMasterDetail_Shell">
			<Setter Property="IsMasterExpanded" Value="False" />
		</Style>
	</UserControl.Styles>

	<common:ModuleMasterDetail_Shell MasterHeaderLabel="Blitzball Prize Pool">
		<common:ModuleMasterDetail_Shell.MasterList>
			<Grid RowDefinitions="Auto,Auto,*">
				<StackPanel Spacing="8">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_blitzball_prize_pool_0854cc54}" />
					<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_prize_rewards_takara_220_320_63722cbd}" />
					<TextBlock Classes="muted" TextWrapping="Wrap" Text="{x:Static res:Strings.U_the_101_blitzball_prize_rewards_prize_0_100_taka_9c23cd0a}" />
					<TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" Text="{x:Static res:Strings.U_chain_the_prize_table_tab_assigns_a_prize_index__74399014}" />
				</StackPanel>

				<StackPanel Grid.Row="1" Margin="0,14,0,14" Spacing="10">
					<Grid ColumnDefinitions="*,Auto">
						<TextBox Watermark="{x:Static res:Strings.U_filter_by_prize_takara_index_or_reward_23b1a997}"
								 Text="{Binding FilterText, Mode=TwoWay}" />
						<Button Grid.Column="1" Margin="10,0,0,0" Classes="secondaryAction" Click="Button_Refresh">Refresh</Button>
					</Grid>
					<TextBlock Classes="muted" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
				</StackPanel>

				<ListBox Grid.Row="2"
						 ItemsSource="{Binding Prizes}"
						 SelectedItem="{Binding SelectedPrize, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,4" Padding="8,6" Background="Transparent" CornerRadius="6">
								<StackPanel Spacing="3">
									<TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Header}" />
									<TextBlock Classes="muted" Text="{Binding Row.Summary}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</common:ModuleMasterDetail_Shell.MasterList>

		<common:ModuleMasterDetail_Shell.Detail>
			<ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled"
			              Background="{DynamicResource AppSurfaceBrush}"
			              IsVisible="{Binding SelectedPrize, Converter={x:Static ObjectConverters.IsNotNull}}">
				<StackPanel Spacing="14" Margin="10,10,10,10">
				<Border Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
					<StackPanel Spacing="6">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_prize_pool_authoring_115ef149}" />
						<TextBlock FontSize="22" FontWeight="Bold" Text="{Binding SelectedPrize.Header}" />
						<TextBlock Classes="muted" Text="{Binding ScopeSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Spacing="4">
								<TextBlock Text="{Binding Treasure.EditSession.SessionSummary}" FontWeight="SemiBold" />
								<TextBlock Text="{Binding Treasure.EditSession.BehaviorSummary}" Classes="muted" TextWrapping="Wrap" />
							</StackPanel>
							<core:AutoSaveIndicator_Control Grid.Column="1"
							                               Margin="12,0,0,0"
							                               VerticalAlignment="Center"
							                               Session="{Binding Treasure.EditSession}" />
						</Grid>
						<WrapPanel Orientation="Horizontal">
							<CheckBox VerticalAlignment="Center"
									  IsChecked="{Binding Treasure.EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
							<Button Margin="12,0,0,0"
									Classes="secondaryAction"
									IsEnabled="{Binding Treasure.EditSession.CanUndo}"
									Click="Button_Undo">Undo</Button>
							<Button Margin="12,0,0,0"
									Classes="secondaryAction"
									IsEnabled="{Binding Treasure.EditSession.DiffersFromOriginal}"
									Click="Button_Discard">Restore Original</Button>
							<Button Margin="12,0,0,0"
									Classes="primaryAction"
									IsEnabled="{Binding Treasure.EditSession.HasPendingChanges}"
									Click="Button_Save">Save</Button>
						</WrapPanel>
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}" Classes="cardSoft">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_prize_reward_editor_d28a96c0}" />
						<TextBlock Classes="cardTitle" Text="{Binding SelectedPrize.Row.Summary}" />
						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_pick_the_reward_item_for_this_prize_slot_the_bli_23b78929}" />

						<Border Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
							<StackPanel Spacing="8">
								<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_reward_item_539162a1}" />
								<TextBox Watermark="{x:Static res:Strings.CommonFilterItems}"
										 Text="{Binding SelectedPrize.Row.ItemFilterText, Mode=TwoWay}" />
								<ComboBox ItemsSource="{Binding SelectedPrize.Row.FilteredItemOptions}"
										  SelectedItem="{Binding SelectedPrize.Row.SelectedItemOption, Mode=TwoWay}"
										  MaxDropDownHeight="420">
									<ComboBox.ItemTemplate>
										<DataTemplate>
											<StackPanel Spacing="2">
												<TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
												<TextBlock Classes="muted" FontSize="11" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
											</StackPanel>
										</DataTemplate>
									</ComboBox.ItemTemplate>
								</ComboBox>
							</StackPanel>
						</Border>

						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="2*" MinWidth="120" />
								<ColumnDefinition Width="2*" MinWidth="140" />
								<ColumnDefinition Width="3*" />
							</Grid.ColumnDefinitions>
							<Border Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
								<StackPanel Spacing="8">
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonQuantity}" />
									<TextBox Classes="numField" Text="{Binding SelectedPrize.Row.Quantity, Mode=TwoWay}" />
								</StackPanel>
							</Border>
							<Border Grid.Column="1" Margin="12,0,0,0" Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
								<StackPanel Spacing="8">
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonRawType}" />
									<TextBox Classes="numField" Text="{Binding SelectedPrize.Row.Type, Mode=TwoWay}" />
									<TextBlock Classes="muted" FontSize="11" Text="{Binding SelectedPrize.Row.TypeHex}" />
								</StackPanel>
							</Border>
							<Border Grid.Column="2" Margin="12,0,0,0" Padding="{DynamicResource SpacingMd}" Classes="cardSoft">
								<StackPanel Spacing="6">
									<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.CommonInterpretation}" />
									<TextBlock FontWeight="SemiBold" Text="{Binding SelectedPrize.Row.KindLabel}" />
									<TextBlock Classes="muted" Text="{Binding SelectedPrize.Row.ResolvedName}" TextWrapping="Wrap" />
									<TextBlock Classes="muted" Text="{Binding SelectedPrize.Row.PayloadDetailSummary}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
						</Grid>

						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_honest_scope_edits_the_blitzball_prize_pool_whic_c724dbe7}" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
		</common:ModuleMasterDetail_Shell.Detail>
	</common:ModuleMasterDetail_Shell>
</UserControl>
