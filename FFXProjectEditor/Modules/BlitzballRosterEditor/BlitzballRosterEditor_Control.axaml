<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:FFXProjectEditor"
             xmlns:common="clr-namespace:FFXProjectEditor.Modules.Common"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1260"
             d:DesignHeight="760"
             x:Class="FFXProjectEditor.BlitzballRosterEditor_Control">

	<UserControl.Styles>
		<Style Selector="UserControl.narrow common|ModuleMasterDetail_Shell">
			<Setter Property="IsMasterExpanded" Value="False" />
		</Style>
	</UserControl.Styles>

	<common:ModuleMasterDetail_Shell MasterHeaderLabel="Blitzball Roster">
		<common:ModuleMasterDetail_Shell.MasterHeader>
			<StackPanel Spacing="10">
				<StackPanel Spacing="8">
					<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_blitzball_roster_7d784708}" />
					<TextBlock Classes="cardTitle" Text="{x:Static res:Strings.U_players_stats_growth_f303a3a0}" />
					<TextBlock Classes="muted" Text="{x:Static res:Strings.U_edit_the_60_players_base_stat_growth_curves_insi_28237851}" TextWrapping="Wrap" />
				</StackPanel>
				<StackPanel Margin="0,10,0,10" Spacing="10">
					<TextBox Watermark="{x:Static res:Strings.U_filter_by_player_index_or_name_7d175f9e}"
							 Text="{Binding FilterText, Mode=TwoWay}" />
					<TextBlock Classes="muted" Text="{Binding LoadSummary}" TextWrapping="Wrap" />
				</StackPanel>
			</StackPanel>
		</common:ModuleMasterDetail_Shell.MasterHeader>
		<common:ModuleMasterDetail_Shell.MasterList>
			<Grid>
				<ListBox
						 ItemsSource="{Binding DisplayedPlayers}"
						 SelectedItem="{Binding SelectedPlayer, Mode=TwoWay}">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,4" Padding="8,6" Background="Transparent" CornerRadius="6">
								<StackPanel Spacing="2">
									<TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Header}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</common:ModuleMasterDetail_Shell.MasterList>

		<common:ModuleMasterDetail_Shell.Detail>
			<ScrollViewer Margin="0" HorizontalScrollBarVisibility="Disabled"
			              Background="{DynamicResource AppSurfaceBrush}"
			              IsVisible="{Binding SelectedPlayer, Converter={x:Static ObjectConverters.IsNotNull}}">
				<StackPanel Spacing="14" Margin="10,10,10,10">
				<Border Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="6">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_roster_authoring_c1101747}" />
						<TextBlock FontSize="22" FontWeight="Bold" Text="{Binding SelectedPlayer.Header}" />
						<TextBlock Classes="muted" Text="{Binding ScopeSummary}" TextWrapping="Wrap" />
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="12">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.SessionControls}" />
						<Grid ColumnDefinitions="*,Auto">
							<StackPanel Spacing="4">
								<TextBlock Text="{Binding EditSession.SessionSummary}" FontWeight="SemiBold" />
								<TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" TextWrapping="Wrap" />
							</StackPanel>
							<core:AutoSaveIndicator_Control Grid.Column="1"
							                               Margin="12,0,0,0"
							                               VerticalAlignment="Center"
							                               Session="{Binding EditSession}" />
						</Grid>
						<WrapPanel Orientation="Horizontal">
							<CheckBox VerticalAlignment="Center"
									  IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
							<Button Margin="12,0,0,0"
									Classes="secondaryAction"
									IsEnabled="{Binding EditSession.CanUndo}"
									Click="Button_Undo">Undo</Button>
							<Button Margin="12,0,0,0"
									Classes="secondaryAction"
									IsEnabled="{Binding EditSession.DiffersFromOriginal}"
									Click="Button_Discard">Restore Original</Button>
							<Button Margin="12,0,0,0"
									Classes="primaryAction"
									IsEnabled="{Binding EditSession.HasPendingChanges}"
									Click="Button_Save">Save</Button>
							<Button Margin="12,0,0,0" Classes="secondaryAction" Click="Button_Refresh">Refresh</Button>
						</WrapPanel>
					</StackPanel>
				</Border>

				<Border Padding="{DynamicResource SpacingLg}">
					<StackPanel Spacing="10">
						<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_stat_growth_curves_48ddd4e4}" />
						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_each_stat_is_a_b_lv_growthtype_0_a_b_lv_c_1_a_b__823951c6}" />

						<Grid ColumnDefinitions="110,72,72,72,64,140,*" Margin="0,6,0,2">
							<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_stat_49df26a3}" />
							<TextBlock Grid.Column="1" Classes="sectionLabel" Margin="2,0" TextAlignment="Right" Text="a" />
							<TextBlock Grid.Column="2" Classes="sectionLabel" Margin="2,0" TextAlignment="Right" Text="b" />
							<TextBlock Grid.Column="3" Classes="sectionLabel" Margin="2,0" TextAlignment="Right" Text="c" />
							<TextBlock Grid.Column="4" Classes="sectionLabel" Margin="2,0" TextAlignment="Right" Text="{x:Static res:Strings.U_type_d0a3e7f8}" />
							<TextBlock Grid.Column="5" Classes="sectionLabel" Margin="6,0" TextAlignment="Right" Text="{x:Static res:Strings.U_lv_1_50_99_1abbfeea}" />
							<TextBlock Grid.Column="6" Classes="sectionLabel" Margin="6,0" Text="{x:Static res:Strings.U_formula_be121f2d}" />
						</Grid>

						<ItemsControl ItemsSource="{Binding SelectedPlayer.Stats}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Padding="0,6" BorderBrush="{DynamicResource PanelStrokeBrush}" BorderThickness="0,0,0,1">
										<Grid ColumnDefinitions="110,72,72,72,64,140,*" VerticalAlignment="Center">
											<TextBlock Text="{Binding StatName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
											<TextBox Grid.Column="1" Margin="2,0" Classes="numField" Text="{Binding A, Mode=TwoWay}" />
											<TextBox Grid.Column="2" Margin="2,0" Classes="numField" Text="{Binding B, Mode=TwoWay}" />
											<TextBox Grid.Column="3" Margin="2,0" Classes="numField" Text="{Binding C, Mode=TwoWay}" />
											<TextBox Grid.Column="4" Margin="2,0" Classes="numField" Text="{Binding GrowthType, Mode=TwoWay}" />
											<TextBlock Grid.Column="5" Margin="6,0" VerticalAlignment="Center" Classes="muted" TextAlignment="Right">
												<Run Text="{Binding AtLv1}" /><Run Text=" / " /><Run Text="{Binding AtLv50}" /><Run Text=" / " /><Run Text="{Binding AtLv99}" />
											</TextBlock>
											<TextBlock Grid.Column="6" Margin="6,0" VerticalAlignment="Center" Classes="muted" Text="{Binding Formula}" TextTrimming="CharacterEllipsis" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_honest_scope_this_writes_the_stat_growth_tables__8a6d460d}" />
					</StackPanel>
				</Border>
			</StackPanel>
		</ScrollViewer>
		</common:ModuleMasterDetail_Shell.Detail>
	</common:ModuleMasterDetail_Shell>
</UserControl>
