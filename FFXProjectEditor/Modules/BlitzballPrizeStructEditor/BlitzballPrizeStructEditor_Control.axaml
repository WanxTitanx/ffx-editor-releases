<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:core="clr-namespace:FFXProjectEditor"
             xmlns:psl="clr-namespace:FFXProjectEditor.Modules.BlitzballPrizeStructEditor"
             xmlns:res="clr-namespace:FFXProjectEditor.Resources"
             mc:Ignorable="d"
             d:DesignWidth="1260"
             d:DesignHeight="760"
             x:Class="FFXProjectEditor.BlitzballPrizeStructEditor_Control">

	<UserControl.Styles>
		<!-- Borderless prize/odds row: thin family stripe + content + subtle hover. No card-in-card chrome. -->
		<Style Selector="Border.prizeRow">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="CornerRadius" Value="6" />
		</Style>
		<Style Selector="Border.prizeRow:pointerover">
			<Setter Property="Background" Value="#141F29" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*" Margin="18">
		<!-- HERO: title + one short orienting line. The long chain/honesty text lives in the collapsed "About" panel. -->
		<Border Padding="{DynamicResource SpacingLg}" Classes="heroGradient">
			<StackPanel Spacing="4">
				<TextBlock Classes="sectionLabel" Text="{x:Static res:Strings.U_prize_table_who_wins_which_prize_bltz0200_ebp_67aa0092}" />
				<TextBlock FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Text="{x:Static res:Strings.U_league_tournament_placement_draw_prizes_5dccac5e}" />
				<TextBlock Classes="muted" TextWrapping="Wrap"
						   Text="{x:Static res:Strings.U_teal_prize_index_which_prize_a_placement_awards__e8c7daa5}" />
			</StackPanel>
		</Border>

		<Border Grid.Row="1" Margin="0,14,0,0" Padding="{DynamicResource SpacingLg}" Classes="card">
			<StackPanel Spacing="12">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="2*" />
						<ColumnDefinition Width="*" MinWidth="180" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBox Watermark="{x:Static res:Strings.U_filter_by_reward_prize_index_placement_or_draw_f6658207}"
							 Text="{Binding FilterText, Mode=TwoWay}" />
					<ComboBox Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Stretch"
							  ItemsSource="{Binding VarFilters}"
							  SelectedItem="{Binding SelectedVarFilter, Mode=TwoWay}" />
					<Button Grid.Column="2" Margin="10,0,0,0" Classes="secondaryAction" Click="Button_Refresh">Refresh</Button>
				</Grid>
				<TextBlock Classes="muted" Text="{Binding LoadSummary}" TextWrapping="Wrap" />

				<Grid ColumnDefinitions="*,Auto">
					<StackPanel Spacing="4">
						<TextBlock Text="{Binding EditSession.SessionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
						<TextBlock Text="{Binding EditSession.BehaviorSummary}" Classes="muted" TextWrapping="Wrap" />
					</StackPanel>
					<core:AutoSaveIndicator_Control Grid.Column="1"
					                               Margin="12,0,0,0"
					                               VerticalAlignment="Center"
					                               Session="{Binding EditSession}" />
				</Grid>
				<WrapPanel Orientation="Horizontal">
					<CheckBox VerticalAlignment="Center"
							  IsChecked="{Binding EditSession.AutoSaveEnabled, Mode=TwoWay}">Auto-save</CheckBox>
					<Button Margin="12,0,0,0" Classes="secondaryAction"
							IsEnabled="{Binding EditSession.CanUndo}" Click="Button_Undo">Undo</Button>
					<Button Margin="12,0,0,0" Classes="secondaryAction"
							IsEnabled="{Binding EditSession.DiffersFromOriginal}" Click="Button_Discard">Restore Original</Button>
					<Button Margin="12,0,0,0"
							IsEnabled="{Binding EditSession.HasPendingChanges}" Click="Button_Save">Save</Button>
				</WrapPanel>

				<!-- Honesty + chain explanation, collapsed by default (was 3 dense paragraphs stacked before any data). -->
				<Expander Header="{x:Static res:Strings.U_about_this_table_honesty_cb8fd2f6}">
					<StackPanel Spacing="8" Margin="0,8,0,0">
						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_chain_the_prize_table_picks_a_prize_index_for_ea_302ac8c9}" />
						<TextBlock Classes="muted" TextWrapping="Wrap" Text="{Binding ScopeSummary}" />
						<TextBlock Classes="muted" TextWrapping="Wrap"
								   Text="{x:Static res:Strings.U_two_editable_families_teal_prize_index_which_pri_18e30452}" />
					</StackPanel>
				</Expander>
			</StackPanel>
		</Border>

		<Border Grid.Row="2" Margin="0,14,0,0" Padding="{DynamicResource SpacingMd}" Classes="card">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="4">
					<!-- PRIZE TREE: Competition (expander) -> Award (expander) -> Draw (inline; "Sorteio N" only when >1) -> prize rows -->
					<ItemsControl ItemsSource="{Binding Competitions}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Expander Margin="0,0,0,8" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
									<Expander.Header>
										<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
											<Border Width="10" Height="10" CornerRadius="{DynamicResource RadiusPill}" VerticalAlignment="Center"
													Background="{Binding ., Converter={x:Static psl:PrizeFamilyBrushConverter.Prize}}" />
											<TextBlock Grid.Column="1" Margin="10,0,0,0" FontWeight="Bold" FontSize="14"
													   VerticalAlignment="Center" Text="{Binding Header}" />
											<Border Grid.Column="2" Classes="cardSoft" Padding="9,2" VerticalAlignment="Center">
												<TextBlock Classes="muted" FontSize="11" Text="{Binding CountLabel}" />
											</Border>
										</Grid>
									</Expander.Header>

									<!-- Awards -->
									<ItemsControl ItemsSource="{Binding Awards}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Expander Margin="0,0,0,4" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
													<Expander.Header>
														<Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
															<TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Header}" />
															<Border Grid.Column="1" Classes="cardSoft" Padding="9,2" VerticalAlignment="Center">
																<TextBlock Classes="muted" FontSize="11" Text="{Binding CountLabel}" />
															</Border>
														</Grid>
													</Expander.Header>

													<!-- Draws inline (no own Expander). "Sorteio N" label shows only when there's more than one draw. -->
													<ItemsControl ItemsSource="{Binding Draws}">
														<ItemsControl.ItemTemplate>
															<DataTemplate>
																<StackPanel Margin="0,4,0,0">
																	<TextBlock Classes="sectionLabel" Margin="2,2,0,2"
																			   IsVisible="{Binding ShowLabel}" Text="{Binding Header}" />
																	<ItemsControl ItemsSource="{Binding Rows}">
																		<ItemsControl.ItemTemplate>
																			<DataTemplate>
																				<Border Classes="prizeRow" Margin="0,0,0,2">
																					<Grid ColumnDefinitions="3,*">
																						<Border Grid.Column="0" Margin="0,3" CornerRadius="{DynamicResource RadiusPill}"
																								Background="{Binding IsPrize, Converter={x:Static psl:PrizeFamilyBrushConverter.Instance}}" />
																						<Grid Grid.Column="1" Margin="12,6" ColumnDefinitions="*,Auto,96" VerticalAlignment="Center">
																							<TextBlock VerticalAlignment="Center" FontWeight="SemiBold"
																									   Text="{Binding Header}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Header}" />
																							<TextBlock Grid.Column="1" Margin="10,0" Classes="muted" VerticalAlignment="Center" Text="{Binding ValueCaption}" />
																							<TextBox Grid.Column="2" Margin="0,0,4,0" Classes="numField" VerticalAlignment="Center"
																									 Text="{Binding Value, Mode=TwoWay}" />
																						</Grid>
																					</Grid>
																				</Border>
																			</DataTemplate>
																		</ItemsControl.ItemTemplate>
																	</ItemsControl>
																</StackPanel>
															</DataTemplate>
														</ItemsControl.ItemTemplate>
													</ItemsControl>
												</Expander>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Expander>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<!-- ODDS GROUP (separate family — not paired to a prize, by design) -->
					<Expander Margin="0,4,0,0" IsExpanded="{Binding OddsGroup.IsExpanded, Mode=TwoWay}"
							  IsVisible="{Binding HasOdds}">
						<Expander.Header>
							<Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
								<Border Width="10" Height="10" CornerRadius="{DynamicResource RadiusPill}" VerticalAlignment="Center"
										Background="{Binding ., Converter={x:Static psl:PrizeFamilyBrushConverter.Odds}}" />
								<TextBlock Grid.Column="1" Margin="10,0,0,0" FontWeight="Bold" FontSize="14"
										   VerticalAlignment="Center" Text="{Binding OddsGroup.Header}" />
								<Border Grid.Column="2" Classes="pillWriter" Margin="0,0,8,0">
									<TextBlock Text="{x:Static res:Strings.U_odds_sem_por_premio_f31f7da2}" />
								</Border>
								<Border Grid.Column="3" Classes="cardSoft" Padding="9,2" VerticalAlignment="Center">
									<TextBlock Classes="muted" FontSize="11" Text="{Binding OddsGroup.CountLabel}" />
								</Border>
							</Grid>
						</Expander.Header>
						<!-- Own scroller so opening odds doesn't dump a wall of ~390 rows into the tree's scroll. -->
						<ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
							<ItemsControl ItemsSource="{Binding OddsGroup.Rows}" Margin="0,8,8,0">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Classes="prizeRow" Margin="0,0,0,2">
											<Grid ColumnDefinitions="3,*">
												<Border Grid.Column="0" Margin="0,3" CornerRadius="{DynamicResource RadiusPill}"
														Background="{Binding IsPrize, Converter={x:Static psl:PrizeFamilyBrushConverter.Instance}}" />
												<Grid Grid.Column="1" Margin="12,6" ColumnDefinitions="*,Auto,96,1.4*" VerticalAlignment="Center">
													<StackPanel>
														<TextBlock FontWeight="SemiBold" Text="{Binding Header}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Header}" />
														<TextBlock Classes="muted" FontSize="11" Text="{Binding OffsetLabel}" />
													</StackPanel>
													<TextBlock Grid.Column="1" Margin="10,0" Classes="muted" VerticalAlignment="Center" Text="{Binding ValueCaption}" />
													<TextBox Grid.Column="2" Margin="0,0,10,0" Classes="numField" VerticalAlignment="Center"
															 Text="{Binding Value, Mode=TwoWay}" />
													<TextBlock Grid.Column="3" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" Text="{Binding Detail}" />
												</Grid>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Expander>
				</StackPanel>
			</ScrollViewer>
		</Border>
	</Grid>
</UserControl>
