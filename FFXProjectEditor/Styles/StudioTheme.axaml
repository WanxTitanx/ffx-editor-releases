<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Style Selector="ToggleSwitch">
		<Setter Property="OnContent" Value=""/>
		<Setter Property="OffContent" Value=""/>
	</Style>

	<Style Selector="Window">
		<Setter Property="Background" Value="{DynamicResource AppBgBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>

	<!-- ===== Camada 5 (overhaul de UI): raios menores = visual "pro", menos mobile-like.
	     card 18→12 · cardSoft 14→10 · nav 12→8. Mantém a estética studio. ===== -->
	<Style Selector="Border.card">
		<Setter Property="Background" Value="{DynamicResource PanelBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusLg}" />
	</Style>

	<Style Selector="Border.cardSoft">
		<Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
	</Style>

	<!-- ===== Camada 6 (overhaul de UI): escala tipográfica clara.
	     h1/h2/h3 = hierarquia de título · label/body/muted = papéis de texto. ===== -->
	<Style Selector="TextBlock.h1">
		<Setter Property="FontSize" Value="22" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>
	<Style Selector="TextBlock.h2">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>
	<Style Selector="TextBlock.h3">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>
	<Style Selector="TextBlock.label">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>
	<Style Selector="TextBlock.body">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="Regular" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<!-- Legacy aliases (mantêm a antiga nomenclatura funcionando em todo o app existente). -->
	<Style Selector="TextBlock.sectionLabel">
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<Style Selector="TextBlock.cardTitle">
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<Style Selector="TextBlock.muted">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Regular" />
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
	</Style>

	<!-- ===== Camada 5 (overhaul de UI): Button.nav enxuto — padding 14,12 → 12,8 e margin 8 → 4. ===== -->
	<Style Selector="Button.nav">
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="Margin" Value="0,0,0,4" />
		<Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
	</Style>

	<!-- ===== Icon Rail (Camada 2): ícone quadrado compacto (~44px) pro rail vertical de 56px.
	     Hover realça com a borda azul-fria; o flyout de cada grupo abre à direita do botão. -->
	<Style Selector="Button.railIcon">
		<Setter Property="Width" Value="44" />
		<Setter Property="Height" Value="44" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0,2" />
		<Setter Property="FontSize" Value="20" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
	</Style>
	<Style Selector="Button.railIcon:pointerover">
		<Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCoolBrush}" />
	</Style>
	<Style Selector="Button.railIcon:pressed">
		<Setter Property="Background" Value="#15323B" />
	</Style>

	<Style Selector="Button.nav:pointerover">
		<Setter Property="Background" Value="#1B2B39" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCoolBrush}" />
	</Style>

	<Style Selector="Button.primaryAction">
		<Setter Property="Padding" Value="14,8" />
		<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
		<Setter Property="Foreground" Value="#041013" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style Selector="Button.primaryAction:pointerover">
		<Setter Property="Background" Value="#78DEC6" />
	</Style>

	<Style Selector="Button.secondaryAction">
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>

	<Style Selector="Button.secondaryAction:pointerover">
		<Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
	</Style>

	<Style Selector="Border.autosaveChip">
		<Setter Property="Padding" Value="10,6" />
		<Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="999" />
	</Style>

	<Style Selector="Border.autosaveOrb">
		<Setter Property="Width" Value="36" />
		<Setter Property="Height" Value="36" />
		<Setter Property="Padding" Value="4" />
		<Setter Property="Background" Value="{DynamicResource PanelBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="18" />
	</Style>

	<Style Selector="TextBlock.autosaveLabel">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
	</Style>

	<Style Selector="CheckBox.statusCheck">
		<Setter Property="IsHitTestVisible" Value="False" />
	</Style>

	<!-- ===== Sub-tab strip (hub-local, FFX/Spira) — mirrors Button.nav so it does not fight the Fluent template ===== -->
	<Style Selector="Button.tabPill">
		<Setter Property="Padding" Value="16,9" />
		<Setter Property="Margin" Value="0,0,6,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0,0,0,2" />
		<Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
	</Style>
	<Style Selector="Button.tabPill:pointerover">
		<Setter Property="Background" Value="#1B2B39" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>
	<Style Selector="Button.tabPillActive">
		<Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
	</Style>
	<Style Selector="Button.tabPillActive:pointerover">
		<Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
		<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
	</Style>

	<!-- ===== Shared FFX hero gradient (dedupes the 3 copy-pasted literal gradients in the Blitzball windows) ===== -->
	<Style Selector="Border.heroGradient">
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="{DynamicResource HeroMainAColor}" Offset="0" />
					<GradientStop Color="{DynamicResource HeroMainBColor}" Offset="0.58" />
					<GradientStop Color="{DynamicResource HeroMainCColor}" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===== Mode pills: honest, glanceable read-only vs writer-lab signal ===== -->
	<Style Selector="Border.pillWriter">
		<Setter Property="CornerRadius" Value="999" />
		<Setter Property="Padding" Value="12,5" />
		<Setter Property="Background" Value="#241A10" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border.pillWriter > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Border.pillReadonly">
		<Setter Property="CornerRadius" Value="999" />
		<Setter Property="Padding" Value="12,5" />
		<Setter Property="Background" Value="#0E2024" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border.pillReadonly > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!-- ===== Numeric input: right-aligned for scannable number columns ===== -->
	<Style Selector="TextBox.numField">
		<Setter Property="TextAlignment" Value="Right" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="Transparent" />
	</Style>

	<!-- ===== Collapsible sidebar section header (keeps the card look; click toggles the group) ===== -->
	<Style Selector="Button.sectionHeader">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Margin" Value="0,0,0,2" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>
	<Style Selector="Button.sectionHeader:pointerover">
		<Setter Property="Background" Value="Transparent" />
	</Style>
	<Style Selector="Button.sectionHeader:pointerover TextBlock.cardTitle">
		<Setter Property="Foreground" Value="{DynamicResource AccentCoolBrush}" />
	</Style>
	<Style Selector="TextBlock.sectionChevron">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="FontSize" Value="13" />
	</Style>

	<!-- ===== ListBox items: kill the warm/grey Fluent container chrome (the 'brown' behind cards) so our
	     cardSoft tiles read cool; selection becomes a teal accent. A Style beats the Fluent ThemeDictionary
	     resources (which ignored the token overrides). App-wide.
	     v2.186: tons mais profundos + borda neon grossa para seleção visível em qualquer background. ===== -->
	<Style Selector="ListBox">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
	</Style>
	<Style Selector="ListBoxItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="CornerRadius" Value="14" />
	</Style>
	<Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
	</Style>
	<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#141F29" />
	</Style>
	<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#1A3040" />
	</Style>
	<Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="#1E3A4A" />
	</Style>
	<!-- v2.186: seleção visível via borda sutil ao redor do card.
	     Selection changes color only: changing padding/margins invalidates virtualized row offsets and can leave a focused offscreen row floating over other items. -->
	<Style Selector="ListBoxItem:selected">
		<Setter Property="Background" Value="#1A3040" />

	</Style>

	<Style Selector="ListBoxItem:selected:pointerover">
		<Setter Property="Background" Value="#1E3A4A" />
	</Style>

	<!-- ===== Camada 8 (overhaul de UI): danger, focus-visible e empty-state. ===== -->

	<!-- Danger action/button (paralelo a primary/secondary, para ações destrutivas explícitas). -->
	<Style Selector="Button.dangerAction">
		<Setter Property="Padding" Value="12,8" />
		<Setter Property="Background" Value="#2A1418" />
		<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>
	<Style Selector="Button.dangerAction:pointerover">
		<Setter Property="Background" Value="#3A1B22" />
		<Setter Property="BorderBrush" Value="#FFB0A0" />
	</Style>
	<Style Selector="Button.dangerAction:pressed">
		<Setter Property="Background" Value="#4A1F28" />
	</Style>

	<!-- ===== Accent buttons (Jarvis-UI, audit 2026-06-19): encapsulam fill+border+foreground
	     que antes viviam como pares hex literais em cada Button do MonsterAiEditor (e derivados).
	     Uso: <Button Classes="secondaryAction accentProtect" .../> — a classe accent* só sobrescreve
	     Background/BorderBrush; o secondaryAction continua fornecendo Padding/CornerRadius/etc. ===== -->
	<Style Selector="Button.accentHaste">
		<Setter Property="Background" Value="{DynamicResource AccentHasteFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentHasteBorderBrush}" />
	</Style>
	<Style Selector="Button.accentProtect">
		<Setter Property="Background" Value="{DynamicResource AccentProtectFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentProtectBorderBrush}" />
	</Style>
	<Style Selector="Button.accentShell">
		<Setter Property="Background" Value="{DynamicResource AccentShellFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentShellBorderBrush}" />
	</Style>
	<Style Selector="Button.accentReflect">
		<Setter Property="Background" Value="{DynamicResource AccentReflectFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentReflectBorderBrush}" />
	</Style>
	<Style Selector="Button.accentRegen">
		<Setter Property="Background" Value="{DynamicResource AccentRegenFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentRegenBorderBrush}" />
	</Style>
	<Style Selector="Button.accentNulAll">
		<Setter Property="Background" Value="{DynamicResource AccentNulAllFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentNulAllBorderBrush}" />
	</Style>
	<Style Selector="Button.accentGold">
		<Setter Property="Background" Value="{DynamicResource AccentGoldFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBorderBrush}" />
	</Style>
	<Style Selector="Button.accentBuilder">
		<Setter Property="Background" Value="{DynamicResource AccentBuilderFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBuilderBorderBrush}" />
	</Style>
	<Style Selector="Button.accentReaction">
		<Setter Property="Background" Value="{DynamicResource AccentReactionFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentReactionBorderBrush}" />
	</Style>
	<Style Selector="Button.accentCycle">
		<Setter Property="Background" Value="{DynamicResource AccentCycleFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCycleBorderBrush}" />
	</Style>
	<Style Selector="Button.accentCrimson">
		<Setter Property="Background" Value="{DynamicResource AccentCrimsonFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCrimsonBorderBrush}" />
	</Style>
	<Style Selector="Button.accentForbidden">
		<Setter Property="Background" Value="{DynamicResource AccentForbiddenFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentForbiddenBorderBrush}" />
	</Style>
	<Style Selector="Button.accentExperimental">
		<Setter Property="Background" Value="{DynamicResource AccentExperimentalFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentExperimentalBorderBrush}" />
	</Style>
	<Style Selector="Button.accentUndo">
		<Setter Property="Background" Value="{DynamicResource AccentUndoFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentUndoBorderBrush}" />
	</Style>
	<Style Selector="Button.accentRefresh">
		<Setter Property="Background" Value="{DynamicResource AccentRefreshFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentRefreshBorderBrush}" />
	</Style>
	<Style Selector="Button.accentMove">
		<Setter Property="Background" Value="{DynamicResource AccentMoveFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentMoveBorderBrush}" />
	</Style>

	<!-- ===== Accent borders (Jarvis-UI, audit 2026-06-19, P0-2):
	     Paralelo à família Button.accentXxx. Cards/panels temáticos (Protect/Shell/Reflect/
	     Regen/Crimson/etc) que antes viviam como pares Background+BorderBrush hex literais nos
	     Borders do MonsterAiEditor agora ganham uma classe única que carrega fill+border+radius.
	     Uso: <Border Classes="cardSoft accentProtect" .../> — a class accent* sobrescreve
	     Background/BorderBrush; cardSoft continua fornecendo CornerRadius/etc. O selector
	     derivado "> TextBlock" seta o Foreground da família para o texto dentro do card. ===== -->
	<Style Selector="Border.accentHaste">
		<Setter Property="Background" Value="{DynamicResource AccentHasteFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentHasteBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentHaste > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentHasteForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentProtect">
		<Setter Property="Background" Value="{DynamicResource AccentProtectFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentProtectBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentProtect > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentProtectForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentShell">
		<Setter Property="Background" Value="{DynamicResource AccentShellFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentShellBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentShell > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentShellForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentReflect">
		<Setter Property="Background" Value="{DynamicResource AccentReflectFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentReflectBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentReflect > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentReflectForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentRegen">
		<Setter Property="Background" Value="{DynamicResource AccentRegenFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentRegenBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentRegen > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentRegenForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentNulAll">
		<Setter Property="Background" Value="{DynamicResource AccentNulAllFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentNulAllBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentNulAll > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentNulAllForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentGold">
		<Setter Property="Background" Value="{DynamicResource AccentGoldFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentGoldBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentGold > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentGoldForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentBuilder">
		<Setter Property="Background" Value="{DynamicResource AccentBuilderFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentBuilderBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentBuilder > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentBuilderForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentReaction">
		<Setter Property="Background" Value="{DynamicResource AccentReactionFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentReactionBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentReaction > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentReactionForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentCycle">
		<Setter Property="Background" Value="{DynamicResource AccentCycleFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCycleBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentCycle > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentCycleForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentCrimson">
		<Setter Property="Background" Value="{DynamicResource AccentCrimsonFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCrimsonBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentCrimson > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentCrimsonForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentForbidden">
		<Setter Property="Background" Value="{DynamicResource AccentForbiddenFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentForbiddenBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentForbidden > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentForbiddenForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentExperimental">
		<Setter Property="Background" Value="{DynamicResource AccentExperimentalFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentExperimentalBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentExperimental > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentExperimentalForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentUndo">
		<Setter Property="Background" Value="{DynamicResource AccentUndoFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentUndoBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentUndo > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentUndoForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentRefresh">
		<Setter Property="Background" Value="{DynamicResource AccentRefreshFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentRefreshBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentRefresh > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentRefreshForegroundBrush}" />
	</Style>
	<Style Selector="Border.accentMove">
		<Setter Property="Background" Value="{DynamicResource AccentMoveFillBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource AccentMoveBorderBrush}" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>
	<Style Selector="Border.accentMove > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource AccentMoveForegroundBrush}" />
	</Style>

	<!-- ===== Hero gradient variants (Jarvis-UI, audit 2026-06-19, P0-1):
	     Mesma estrutura do Border.heroGradient canônico, mas consumindo as cores de identidade
	     de cada família de módulo (preservar identidade ao invés de forçar o azul-petróleo
	     canônico). Uso: <Border Classes="heroPurple" .../>. ===== -->
	<Style Selector="Border.heroPurple">
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="{DynamicResource HeroPurpleAColor}" Offset="0" />
					<GradientStop Color="{DynamicResource HeroPurpleBColor}" Offset="0.58" />
					<GradientStop Color="{DynamicResource HeroPurpleCColor}" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style Selector="Border.heroGreen">
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="{DynamicResource HeroGreenAColor}" Offset="0" />
					<GradientStop Color="{DynamicResource HeroGreenBColor}" Offset="0.58" />
					<GradientStop Color="{DynamicResource HeroGreenCColor}" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style Selector="Border.heroBrown">
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="{DynamicResource HeroBrownAColor}" Offset="0" />
					<GradientStop Color="{DynamicResource HeroBrownBColor}" Offset="0.58" />
					<GradientStop Color="{DynamicResource HeroBrownCColor}" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style Selector="Border.heroTeal">
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="{DynamicResource HeroTealAColor}" Offset="0" />
					<GradientStop Color="{DynamicResource HeroTealBColor}" Offset="0.58" />
					<GradientStop Color="{DynamicResource HeroTealCColor}" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>
	<Style Selector="Border.heroBlue">
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="18" />
		<Setter Property="Background">
			<Setter.Value>
				<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
					<GradientStop Color="{DynamicResource HeroBlueAColor}" Offset="0" />
					<GradientStop Color="{DynamicResource HeroBlueBColor}" Offset="0.58" />
					<GradientStop Color="{DynamicResource HeroBlueCColor}" Offset="1" />
				</LinearGradientBrush>
			</Setter.Value>
		</Setter>
	</Style>

	<!-- ===== Elevation (Jarvis-UI, audit 2026-06-19, P1-7):
	     Hierarquia de BoxShadow ausente antes destes. Aplicar em headers/cards heroicos
	     que precisam sobressair do plano de fundo. ===== -->
	<Style Selector="Border.elevation1">
		<Setter Property="BoxShadow" Value="0 1 3 0 #00000040" />
	</Style>
	<Style Selector="Border.elevation2">
		<Setter Property="BoxShadow" Value="0 2 8 0 #00000060" />
	</Style>
	<Style Selector="Border.elevation3">
		<Setter Property="BoxShadow" Value="0 6 18 0 #00000080" />
	</Style>

	<!-- Danger pill (paralelo a pillWriter / pillReadonly). -->
	<Style Selector="Border.pillDanger">
		<Setter Property="CornerRadius" Value="999" />
		<Setter Property="Padding" Value="12,5" />
		<Setter Property="Background" Value="#2A1418" />
		<Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border.pillDanger > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
		<Setter Property="FontSize" Value="11" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<!-- Focus-visible para acessibilidade de teclado (Avalonia 11.2). Sinal visual claro ao navegar por Tab.
	     Aplicado aos controles interativos comuns sem brigar com o foco do Fluent. -->
	<Style Selector="Button:focus /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCoolBrush}" />
		<Setter Property="BorderThickness" Value="2" />
	</Style>
	<Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
		<Setter Property="BorderBrush" Value="{DynamicResource AccentCoolBrush}" />
		<Setter Property="BorderThickness" Value="2" />
	</Style>

	<!-- Empty-state: estado "módulo sem projeto" ou similar. Reutilizável. -->
	<Style Selector="Border#EmptyState">
		<Setter Property="Padding" Value="20" />
		<Setter Property="Background" Value="{DynamicResource PanelBrush}" />
		<Setter Property="BorderBrush" Value="{DynamicResource PanelStrokeBrush}" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<Style Selector="Border#EmptyState > TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
		<Setter Property="TextWrapping" Value="Wrap" />
		<Setter Property="HorizontalAlignment" Value="Center" />
	</Style>

	<!-- ===== Camada 12 (overhaul de UI): microinterações — transições suaves 120ms no pointer-over.
	     P1-7 (audit 2026-06-19): durações literais elevadas a tokens DurationNormal/Fast (StudioTokens.axaml). ===== -->
	<Style Selector="Button.primaryAction /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Transitions">
			<Setter.Value>
				<Transitions>
					<BrushTransition Property="Background" Duration="{DynamicResource DurationNormal}" />
				</Transitions>
			</Setter.Value>
		</Setter>
	</Style>
	<Style Selector="Button.secondaryAction /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Transitions">
			<Setter.Value>
				<Transitions>
					<BrushTransition Property="Background" Duration="{DynamicResource DurationNormal}" />
				</Transitions>
			</Setter.Value>
		</Setter>
	</Style>
	<Style Selector="Button.railIcon /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Transitions">
			<Setter.Value>
				<Transitions>
					<BrushTransition Property="Background" Duration="{DynamicResource DurationFast}" />
					<BrushTransition Property="BorderBrush" Duration="{DynamicResource DurationFast}" />
				</Transitions>
			</Setter.Value>
		</Setter>
	</Style>
</Styles>
